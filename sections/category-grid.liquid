<section id="categories" class="cat-grid page-width">
  <div class="cat-grid__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-title cat-grid__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--ghost">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  <div class="cat-grid__grid" style="grid-template-columns: repeat({{ section.settings.columns }}, 1fr);">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        {%- if coll != blank -%}
          {%- assign card_url = coll.url -%}
          {%- assign card_name = block.settings.title | default: coll.title -%}
          {%- assign card_image = block.settings.image | default: coll.featured_image -%}
        {%- else -%}
          {%- assign card_url = block.settings.link -%}
          {%- assign card_name = block.settings.title -%}
          {%- assign card_image = block.settings.image -%}
        {%- endif -%}
        <a href="{{ card_url | default: '#' }}" class="cat-card" {{ block.shopify_attributes }}>
          {%- if card_image != blank -%}
            <img src="{{ card_image | image_url: width: 900 }}" alt="{{ card_name | escape }}" width="900" height="1200" class="cat-img cover-img" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'cat-img cover-img' }}
          {%- endif -%}
          <span class="cat-grid__scrim"></span>
          <span class="cat-veil"></span>
          <span class="cat-frame"></span>
          <span class="cat-label">{{ card_name }}</span>
          <span class="cat-cta">View Collection</span>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- assign d_handles = section.settings.default_handles | split: ',' -%}
      {%- assign d_titles = section.settings.default_titles | split: ',' -%}
      {%- assign d_images = section.settings.default_images | split: ',' -%}
      {%- for h in d_handles -%}
        {%- assign hh = h | strip -%}
        {%- assign coll = collections[hh] -%}
        {%- assign card_name = d_titles[forloop.index0] | strip | default: coll.title -%}
        {%- if coll != empty and coll.url != blank -%}{%- assign card_url = coll.url -%}{%- else -%}{%- capture card_url -%}{{ routes.search_url }}?q={{ card_name | url_encode }}&type=product{%- endcapture -%}{%- endif -%}
        {%- assign ov = d_images[forloop.index0] | strip -%}
        <a href="{{ card_url }}" class="cat-card">
          {%- if ov contains '://' -%}
            <img src="{{ ov }}" alt="{{ card_name | escape }}" width="900" height="1200" class="cat-img cover-img" loading="lazy" referrerpolicy="no-referrer">
          {%- elsif ov != blank -%}
            <img src="{{ ov | asset_url }}" alt="{{ card_name | escape }}" width="900" height="1200" class="cat-img cover-img" loading="lazy">
          {%- elsif coll.featured_image != blank -%}
            <img src="{{ coll.featured_image | image_url: width: 900 }}" alt="{{ card_name | escape }}" width="900" height="1200" class="cat-img cover-img" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'cat-img cover-img' }}
          {%- endif -%}
          <span class="cat-grid__scrim"></span>
          <span class="cat-veil"></span>
          <span class="cat-frame"></span>
          <span class="cat-label">{{ card_name }}</span>
          <span class="cat-cta">View Collection</span>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  .cat-grid { padding-top: 128px; padding-bottom: 90px; }
  .cat-grid__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 48px; flex-wrap: wrap; }
  .cat-grid__title { max-width: 640px; }
  .cat-grid__grid { display: grid; gap: 18px; }
  .cat-card { position: relative; display: block; overflow: hidden; aspect-ratio: 3/4; background: var(--color-light-text); }
  .cat-grid__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(11,28,53,.72), rgba(11,28,53,0) 55%); }
  .cat-label { position: absolute; left: 16px; bottom: 14px; right: 16px; color: var(--color-bg); font-family: var(--font-accent); font-size: 15px; letter-spacing: .04em; }
  @media (max-width: 990px) { .cat-grid { padding-top: 80px; } .cat-grid__grid { grid-template-columns: repeat(3, 1fr) !important; } }
  @media (max-width: 600px) { .cat-grid__grid { grid-template-columns: repeat(2, 1fr) !important; } }
</style>

{% schema %}
{
  "name": "Category grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by Subject" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Artisanal Mosaic Designs In Natural Marble & Glass" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All Subjects" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "columns", "min": 3, "max": 6, "step": 1, "label": "Columns", "default": 5 },
    { "type": "paragraph", "content": "If no Category blocks are added, these defaults are shown (comma-separated, in matching order)." },
    { "type": "textarea", "id": "default_handles", "label": "Default collection handles", "default": "portrait-mosaics, nautical-mosaics, flower-mosaics, landscape-mosaics, food-mosaics, geometric-mosaics, animal-mosaics, bird-mosaics, patterns-mosaics, tree-mosaics" },
    { "type": "textarea", "id": "default_titles", "label": "Default titles", "default": "Portrait, Nautical, Flower, Landscape, Food, Geometric, Animal, Bird, Pattern, Tree" },
    { "type": "textarea", "id": "default_images", "label": "Tile image overrides (comma-separated)", "info": "URLs or asset filenames, matching the order above" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link (if no collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category", "settings": { "collection": "portrait-mosaics", "title": "Portrait" } },
        { "type": "category", "settings": { "collection": "nautical-mosaics", "title": "Nautical" } },
        { "type": "category", "settings": { "collection": "flower-mosaics", "title": "Flower" } },
        { "type": "category", "settings": { "collection": "landscape-mosaics", "title": "Landscape" } },
        { "type": "category", "settings": { "collection": "food-mosaics", "title": "Food" } },
        { "type": "category", "settings": { "collection": "geometric-mosaics", "title": "Geometric" } },
        { "type": "category", "settings": { "collection": "animal-mosaics", "title": "Animal" } },
        { "type": "category", "settings": { "collection": "bird-mosaics", "title": "Bird" } },
        { "type": "category", "settings": { "collection": "patterns-mosaics", "title": "Pattern" } },
        { "type": "category", "settings": { "collection": "tree-mosaics", "title": "Tree" } }
      ]
    }
  ]
}
{% endschema %}
