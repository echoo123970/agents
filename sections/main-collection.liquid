<!-- COLLECTION HERO -->
{%- assign coll_t = collection.title -%}
{%- if collection.handle == 'all' or coll_t == 'Products' or coll_t == 'All' or coll_t == 'All products' or coll_t == 'Home page' or coll_t == 'Frontpage' -%}
  {%- assign hero_word = 'All' -%}
  {%- assign crumb_label = 'All Mosaics' -%}
{%- else -%}
  {%- assign hero_word = coll_t | remove: ' Mosaics' | remove: ' mosaics' | remove: ' MOSAICS' -%}
  {%- assign crumb_label = coll_t -%}
{%- endif -%}
<section class="coll-hero">
  <div class="page-width coll-hero__crumb-wrap">
    <div class="coll-hero__crumb">
      <a href="{{ routes.root_url }}" class="nav-link">Home</a>
      <span class="coll-hero__crumb-sep">/</span>
      <span class="coll-hero__crumb-current">{{ crumb_label }}</span>
    </div>
  </div>
  <div class="coll-hero__inner">
    <div class="coll-hero__eyebrow">
      <span class="coll-hero__rule"></span>
      <span class="coll-hero__eyebrow-text">{{ section.settings.eyebrow }}</span>
      <span class="coll-hero__rule"></span>
    </div>
    <h1 class="coll-hero__title">{{ hero_word }} <span class="coll-hero__title-i">Mosaics</span></h1>
    {%- if collection.description != blank -%}
      <div class="coll-hero__desc rte">{{ collection.description }}</div>
    {%- else -%}
      {%- assign hw_lower = hero_word | downcase -%}
      {%- case hero_word -%}
        {%- when 'All' -%}{%- assign hero_desc = 'Explore the complete iMosaicArt collection — handcrafted natural marble and glass mosaics spanning abstract art, portraits, florals, landscapes and more. Each piece is hand-cut by master artisans, made to order and shipped worldwide.' -%}
        {%- when 'Abstract' -%}{%- assign hero_desc = 'Bold forms, intricate patterns and custom creations hand-cut in marble and glass. Our abstract mosaics bring color, texture and movement to any wall, floor or feature — original artworks made to order and built to last a lifetime.' -%}
        {%- when 'Animal' -%}{%- assign hero_desc = 'Lifelike animal mosaics handcrafted from natural stone and glass — from majestic lions and horses to beloved pets. Each tessera is cut and placed by hand to capture every expression, ready to bring warmth and character to your space.' -%}
        {%- when 'Bird' -%}{%- assign hero_desc = 'Handcrafted bird mosaics rendered in luminous marble and glass — peacocks, eagles, parrots and songbirds alive with color and detail. Made-to-order wall art that brings the beauty of flight indoors and out, shipped worldwide.' -%}
        {%- when 'Flower' -%}{%- assign hero_desc = 'Floral mosaics hand-cut from natural marble and glass — roses, irises, lilies and blossoms in radiant, lasting color. Bespoke botanical artworks crafted tessera by tessera to bring the garden into your home, kitchen or bath.' -%}
        {%- when 'Food' -%}{%- assign hero_desc = 'Hand-crafted food and wine mosaics in natural stone and glass — perfect for kitchens, dining rooms and tasting spaces. Made-to-order culinary artworks that celebrate flavor with timeless artisan detail.' -%}
        {%- when 'Geometric' -%}{%- assign hero_desc = 'Precision geometric mosaics hand-cut in marble and glass — rosettes, medallions, stars and tessellated patterns. Timeless designs for floors, backsplashes and feature walls, custom-sized and built to endure.' -%}
        {%- when 'Landmark' -%}{%- assign hero_desc = 'Iconic landmark and architectural mosaics handcrafted from natural stone and glass — cities, monuments and world wonders rendered in enduring tesserae. Bespoke commemorative artworks made to order and shipped worldwide.' -%}
        {%- when 'Landscape' -%}{%- assign hero_desc = 'Sweeping landscape mosaics hand-cut from marble and glass — coastlines, mountains, sunsets and pastoral scenes. Made-to-order artworks that bring the serenity of nature to any wall, indoors or outdoors.' -%}
        {%- when 'Nautical' -%}{%- assign hero_desc = 'Nautical mosaics crafted in weatherproof marble and glass — ships, waves, compass roses and sea life. Bespoke coastal artworks built for pools, patios and baths, hand-cut to bring the ocean home.' -%}
        {%- when 'Portrait' -%}{%- assign hero_desc = 'Custom portrait mosaics handcrafted from natural stone and glass — loved ones, icons and masterpieces recreated tessera by tessera. A timeless, one-of-a-kind keepsake made to order from your photograph.' -%}
        {%- when 'Pattern' -%}{%- assign hero_desc = 'Ornamental pattern mosaics hand-cut in marble and glass — arabesques, scrollwork and repeating motifs. Versatile, made-to-order designs for borders, floors and feature walls with lasting artisan beauty.' -%}
        {%- when 'Roman' -%}{%- assign hero_desc = 'Classical Roman mosaics handcrafted from natural marble — acanthus borders, medallions and antiquity-inspired scenes. Bespoke heritage artworks hand-cut in the ancient tradition and made to order for any interior.' -%}
        {%- when 'Religious' -%}{%- assign hero_desc = 'Devotional religious mosaics handcrafted from natural marble and glass — sacred figures, icons and chapel commissions rendered in radiant tesserae. Made-to-order spiritual artworks crafted with reverence and shipped worldwide.' -%}
        {%- when 'Tree' -%}{%- assign hero_desc = 'Tree-of-life and botanical tree mosaics hand-cut from marble and glass — olive groves, blossoms and sweeping canopies. Bespoke nature-inspired artworks made to order to bring organic warmth to your space.' -%}
        {%- else -%}{%- capture hero_desc -%}Discover our handcrafted {{ hw_lower }} mosaics — natural marble and glass artworks, hand-cut by master artisans and made to order for any space.{%- endcapture -%}
      {%- endcase -%}
      <p class="coll-hero__desc">{{ hero_desc }}</p>
    {%- endif -%}
    {%- if section.settings.show_trust -%}
      <div class="coll-hero__trust">
        <span class="coll-hero__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M2 9h20"/><path d="M8 3 6 9l6 13 6-13-2-6"/><path d="M12 3 9 9h6z"/></svg>
          Hand-cut Stone &amp; Glass
        </span>
        <span class="coll-hero__trust-dot">·</span>
        <span class="coll-hero__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          Lifetime Warranty
        </span>
        <span class="coll-hero__trust-dot">·</span>
        <span class="coll-hero__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          Made to Order
        </span>
        <span class="coll-hero__trust-dot">·</span>
        <span class="coll-hero__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/></svg>
          Free Worldwide Shipping
        </span>
      </div>
    {%- endif -%}
  </div>
</section>

<!-- CATEGORY CHIPS -->
<section class="coll-chips">
  <div class="page-width coll-chips__row">
    {%- if section.settings.chips_menu != blank -%}
      {%- for link in section.settings.chips_menu.links -%}
        <a href="{{ link.url }}" class="coll-chip{% if link.active %} is-active{% endif %}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}" class="coll-chip{% if collection.handle == 'all' or collection.handle == blank %} is-active{% endif %}">All Mosaics</a>
      {%- for c in collections -%}
        {%- assign c_tl = c.title | downcase -%}
        {%- unless c.handle == 'all' or c.handle == 'frontpage' or c.handle == 'home-page' or c.products_count == 0 or c_tl contains 'limited edition' or c_tl contains 'studio special' -%}
          <a href="{{ c.url }}" class="coll-chip{% if collection.handle == c.handle %} is-active{% endif %}">{{ c.title }}</a>
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<!-- MAIN -->
<section class="coll page-width">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <form data-collection-filter>
      <div class="coll__toolbar">
        <div class="coll__count">Showing <strong>{{ collection.products_count }}</strong> artworks</div>
        <div class="coll__sort">
          <span class="coll__sort-label">Sort</span>
          <select name="sort_by" class="coll__sort-select" data-auto-submit>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>

      <div class="coll__layout">
        <!-- SIDEBAR -->
        <aside class="coll__sidebar">
          <div class="coll__filter-head">
            <span class="coll__filter-title">Filter</span>
            <a href="{{ collection.url }}" class="coll__filter-reset">Reset</a>
          </div>
          {%- for filter in collection.filters -%}
            <div class="coll-facet" data-accordion data-open>
              <button type="button" class="coll-facet__head" data-accordion-toggle>
                <span>{{ filter.label }}</span>
                <span class="coll-facet__icon">+</span>
              </button>
              <div class="coll-facet__body">
                <div class="coll-facet__body-inner">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      {%- comment -%} Shopify returns min/max .value in cents; normalise EVERYTHING to whole dollars so the slider, boxes and resubmitted params agree. {%- endcomment -%}
                      {%- assign rmax = filter.range_max | money_without_currency | replace: ',', '' | replace: '.00', '' | plus: 0 -%}
                      {%- if rmax == 0 -%}{%- assign rmax = 1 -%}{%- endif -%}
                      {%- assign vmin = 0 -%}
                      {%- if filter.min_value.value != blank -%}{%- assign vmin = filter.min_value.value | money_without_currency | replace: ',', '' | replace: '.00', '' | plus: 0 -%}{%- endif -%}
                      {%- assign vmax = rmax -%}
                      {%- if filter.max_value.value != blank -%}{%- assign vmax = filter.max_value.value | money_without_currency | replace: ',', '' | replace: '.00', '' | plus: 0 -%}{%- endif -%}
                      {%- assign lpct = vmin | times: 100 | divided_by: rmax -%}
                      {%- assign mpct = vmax | times: 100 | divided_by: rmax -%}
                      <div class="coll-facet__pricetop">Highest price <strong>${{ rmax }}</strong></div>
                      <div class="coll-facet__slider" data-price-slider data-max="{{ rmax }}">
                        <div class="coll-facet__track"><span class="coll-facet__track-fill" data-price-fill style="left:{{ lpct }}%; right:{{ 100 | minus: mpct }}%;"></span></div>
                        <input type="range" class="coll-facet__range coll-facet__range--min" min="0" max="{{ rmax }}" step="1" value="{{ vmin }}" data-price-range="min" aria-label="Minimum price">
                        <input type="range" class="coll-facet__range coll-facet__range--max" min="0" max="{{ rmax }}" step="1" value="{{ vmax }}" data-price-range="max" aria-label="Maximum price">
                      </div>
                      <div class="coll-facet__price">
                        <div class="coll-facet__price-box"><span class="coll-facet__price-cur">$</span><input type="number" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value != blank %}{{ vmin }}{% endif %}" placeholder="0" min="0" max="{{ rmax }}" data-price-input="min"></div>
                        <div class="coll-facet__price-box"><span class="coll-facet__price-cur">$</span><input type="number" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value != blank %}{{ vmax }}{% endif %}" placeholder="{{ rmax }}" min="0" max="{{ rmax }}" data-price-input="max"></div>
                      </div>
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="coll-facet__row">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} data-auto-submit>
                          <span class="coll-facet__row-label">{{ value.label }}</span>
                          <span class="coll-facet__row-count">{{ value.count }}</span>
                        </label>
                      {%- endfor -%}
                  {%- endcase -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
          <noscript><button type="submit" class="btn btn--dark" style="margin-top:16px;width:100%;">Apply</button></noscript>
        </aside>

        <!-- GRID -->
        <div class="coll__main">
          {%- if collection.products.size > 0 -%}
            <div class="coll__grid" style="grid-template-columns: repeat({{ section.settings.columns }}, 1fr);">
              {%- for product in collection.products -%}
                {% render 'card-collection', product: product %}
              {%- endfor -%}
            </div>
            {%- if paginate.pages > 1 -%}
              {%- comment -%} Numbered pager with first/last jumps. {%- endcomment -%}
              {%- assign first_part = paginate.parts | first -%}
              {%- assign last_part = paginate.parts | last -%}
              <nav class="coll__pagination" data-numbered-pager aria-label="Pagination">
                {%- if first_part.is_link -%}
                  <a href="{{ first_part.url }}" class="coll__page coll__page--nav" aria-label="First page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg></a>
                {%- endif -%}
                {%- if paginate.previous.is_link -%}
                  <a href="{{ paginate.previous.url }}" class="coll__page coll__page--nav" rel="prev" aria-label="Previous page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="coll__page" aria-label="Page {{ part.title }}">{{ part.title }}</a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span class="coll__page is-active" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="coll__page-gap">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next.is_link -%}
                  <a href="{{ paginate.next.url }}" class="coll__page coll__page--nav" rel="next" aria-label="Next page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></a>
                {%- endif -%}
                {%- if last_part.is_link -%}
                  <a href="{{ last_part.url }}" class="coll__page coll__page--nav" aria-label="Last page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg></a>
                {%- endif -%}
              </nav>
              <div class="coll__pagination-info" data-numbered-info>Page {{ paginate.current_page }} of {{ paginate.pages }}</div>
            {%- endif -%}
          {%- else -%}
            <div class="coll__empty">
              <div class="coll__empty-title">This collection is coming online soon.</div>
              <p class="coll__empty-text">We're still photographing these pieces. Check back shortly or browse our other collections.</p>
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost">View All Products</a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </form>
  {%- endpaginate -%}
</section>

<!-- CUSTOM CTA BAND -->
{%- if section.settings.cta_heading != blank -%}
<section class="coll-cta">
  <div class="page-width coll-cta__inner">
    <div class="coll-cta__text">
      <div class="coll-cta__eyebrow">{{ section.settings.cta_eyebrow }}</div>
      <h2 class="coll-cta__heading">{{ section.settings.cta_heading }}</h2>
      {%- if section.settings.cta_text != blank -%}<p class="coll-cta__sub">{{ section.settings.cta_text }}</p>{%- endif -%}
    </div>
    {%- if section.settings.cta_button_label != blank -%}
      <a href="{{ section.settings.cta_button_link }}" class="btn btn--blue">{{ section.settings.cta_button_label }}</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<style>
  .coll-hero { background: var(--color-panel); border-bottom: 1px solid rgba(22,51,94,.08); }
  .coll-hero__crumb-wrap { padding-top: 30px; }
  .coll-hero__crumb { display: flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-soft); }
  .coll-hero__crumb-sep { color: #B7C0D2; }
  .coll-hero__crumb-current { color: var(--color-navy); }
  .coll-hero__inner { max-width: 880px; margin: 0 auto; padding: 48px 40px 60px; text-align: center; }
  .coll-hero__eyebrow { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 22px; }
  .coll-hero__rule { width: 38px; height: 1px; background: var(--color-blue); }
  .coll-hero__eyebrow-text { font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-navy); }
  .coll-hero__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(44px,5.4vw,72px); line-height: 1.02; letter-spacing: -.01em; margin-bottom: 22px; color: var(--color-navy); }
  .coll-hero__title-i { font-style: italic; color: var(--color-blue); }
  .coll-hero__desc { font-size: 17px; line-height: 1.7; color: var(--color-text-muted); max-width: 620px; margin: 0 auto 30px; }
  .coll-hero__trust { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: nowrap; font-size: 12.5px; letter-spacing: .1em; text-transform: uppercase; color: #7E8AA0; }
  .coll-hero__trust-item { display: inline-flex; align-items: center; gap: 9px; white-space: nowrap; color: #7E8AA0; }
  .coll-hero__trust-item svg { width: 17px; height: 17px; flex-shrink: 0; }
  .coll-hero__trust-dot { color: #C4CDDC; }
  @media (max-width: 820px) { .coll-hero__trust { flex-wrap: wrap; gap: 10px 16px; } .coll-hero__trust-dot { display: none; } }

  .coll-chips { border-bottom: 1px solid rgba(22,51,94,.08); background: rgba(255,255,255,.5); }
  .coll-chips__row { padding-top: 18px; padding-bottom: 18px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .coll-chip { white-space: nowrap; font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase; padding: 10px 20px; border: 1px solid rgba(22,51,94,.18); transition: all .2s ease; color: #46546E; }
  .coll-chip:hover { border-color: var(--color-blue); color: var(--color-navy); }
  .coll-chip.is-active { background: var(--color-navy); color: #fff; border-color: var(--color-navy); }

  .coll { padding-top: 36px; padding-bottom: 90px; }
  .coll__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding-bottom: 24px; margin-bottom: 34px; border-bottom: 1px solid rgba(22,51,94,.1); }
  .coll__count { font-size: 13px; color: var(--color-text-muted); }
  .coll__count strong { color: var(--color-navy); }
  .coll__sort { display: flex; align-items: center; gap: 14px; }
  .coll__sort-label { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-text-soft); }
  .coll__sort-select { font-family: var(--font-body); font-size: 13px; color: var(--color-navy); background: #fff; border: 1px solid rgba(22,51,94,.22); padding: 11px 16px; cursor: pointer; outline: none; }
  .coll__layout { display: grid; grid-template-columns: 248px 1fr; gap: 48px; align-items: start; }
  .coll__sidebar { position: sticky; top: 100px; }
  .coll__filter-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; padding-bottom: 18px; border-bottom: 1px solid var(--color-line); }
  .coll__filter-title { font-family: var(--font-accent); font-size: 16px; color: var(--color-navy); }
  .coll__filter-reset { font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-blue); }
  .coll-facet { border-bottom: 1px solid rgba(22,51,94,.1); }
  .coll-facet__head { width: 100%; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; padding: 18px 0; font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--color-navy); }
  .coll-facet__icon { font-size: 18px; font-weight: 300; color: var(--color-text-soft); transition: transform .25s ease; }
  .coll-facet[data-open] .coll-facet__icon { transform: rotate(45deg); }
  .coll-facet__body { overflow: hidden; max-height: 0; opacity: 0; transition: max-height .4s ease, opacity .3s ease; }
  .coll-facet[data-open] .coll-facet__body { max-height: 500px; opacity: 1; overflow-y: auto; }
  .coll-facet__body-inner { padding: 0 0 20px; }
  .coll-facet__row { display: flex; align-items: center; gap: 11px; padding: 8px 0; cursor: pointer; font-size: 14px; color: #46546E; }
  .coll-facet__row-label { flex: 1; }
  .coll-facet__row-count { font-size: 12px; color: var(--color-text-faint); }
  .coll-facet__pricetop { font-size: 13px; color: #5E6B85; margin-bottom: 14px; }
  .coll-facet__pricetop strong { color: var(--color-navy); font-weight: 600; }
  .coll-facet__slider { position: relative; height: 24px; margin: 6px 0 20px; }
  .coll-facet__track { position: absolute; top: 10px; left: 8px; right: 8px; height: 3px; background: #DCE6F5; border-radius: 2px; }
  .coll-facet__track-fill { position: absolute; top: 0; bottom: 0; background: var(--color-blue); border-radius: 2px; }
  .coll-facet__range { -webkit-appearance: none; appearance: none; position: absolute; top: 0; left: 0; width: 100%; height: 24px; margin: 0; background: transparent; pointer-events: none; }
  .coll-facet__range:focus { outline: none; }
  .coll-facet__range--min { z-index: 4; }
  .coll-facet__range--max { z-index: 3; }
  .coll-facet__range::-webkit-slider-runnable-track { -webkit-appearance: none; height: 24px; background: transparent; border: none; }
  .coll-facet__range::-moz-range-track { height: 24px; background: transparent; border: none; }
  .coll-facet__range::-webkit-slider-thumb { -webkit-appearance: none; pointer-events: auto; margin-top: 4px; width: 16px; height: 16px; border-radius: 50%; background: var(--color-navy); border: 2px solid #fff; box-shadow: 0 1px 5px rgba(22,51,94,.4); cursor: grab; }
  .coll-facet__range::-webkit-slider-thumb:active { cursor: grabbing; }
  .coll-facet__range::-moz-range-thumb { pointer-events: auto; width: 16px; height: 16px; border-radius: 50%; background: var(--color-navy); border: 2px solid #fff; box-shadow: 0 1px 5px rgba(22,51,94,.4); cursor: grab; }
  .coll-facet__price { display: flex; gap: 10px; align-items: center; }
  .coll-facet__price-box { flex: 1; display: flex; align-items: center; gap: 4px; border: 1px solid rgba(22,51,94,.2); padding: 9px 12px; }
  .coll-facet__price-cur { font-size: 13px; color: #5E6B85; }
  .coll-facet__price-box input { flex: 1; width: 100%; border: none; outline: none; background: none; font-size: 13px; color: #5E6B85; padding: 0; -moz-appearance: textfield; }
  .coll-facet__price-box input::-webkit-outer-spin-button, .coll-facet__price-box input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .coll__grid { display: grid; gap: 38px 26px; }
  .coll__pagination { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 64px; flex-wrap: wrap; }
  .coll__page { min-width: 44px; height: 44px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; background: #fff; border: 1px solid rgba(22,51,94,.18); color: var(--color-navy); font-size: 14px; transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease; }
  .coll__page:hover { border-color: var(--color-blue); color: var(--color-blue); transform: translateY(-2px); }
  .coll__page.is-active { background: var(--color-navy); color: #fff; border-color: var(--color-navy); font-weight: 600; transform: none; cursor: default; }
  .coll__page--nav { color: var(--color-navy); }
  .coll__page--nav svg { width: 16px; height: 16px; display: block; }
  .coll__page--nav:hover { background: var(--color-navy); color: #fff; border-color: var(--color-navy); }
  .coll__page.is-disabled { opacity: .3; pointer-events: none; }
  .coll__page-gap { min-width: 26px; height: 44px; display: inline-flex; align-items: flex-end; justify-content: center; padding-bottom: 6px; color: var(--color-text-faint); font-size: 15px; letter-spacing: 2px; }
  .coll__pagination-info { text-align: center; margin-top: 16px; font-size: 12.5px; letter-spacing: .04em; color: var(--color-text-muted); }
  @media (max-width: 600px) { .coll__page { min-width: 40px; height: 40px; } .coll__pagination { gap: 6px; } }
  .coll__empty { text-align: center; padding: 70px 20px; }
  .coll__empty-title { font-family: var(--font-display); font-style: italic; font-size: 28px; color: var(--color-navy); margin-bottom: 14px; }
  .coll__empty-text { font-size: 15px; color: var(--color-text-muted); margin-bottom: 26px; }

  .coll-cta { background: var(--color-navy); color: var(--color-light-text); }
  .coll-cta__inner { padding-top: 84px; padding-bottom: 84px; display: flex; align-items: center; justify-content: space-between; gap: 48px; flex-wrap: wrap; }
  .coll-cta__text { max-width: 620px; }
  .coll-cta__eyebrow { font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-blue-light); margin-bottom: 18px; }
  .coll-cta__heading { font-family: var(--font-display); font-weight: 500; font-size: clamp(32px,3.8vw,50px); line-height: 1.08; margin-bottom: 16px; color: #fff; }
  .coll-cta__sub { font-size: 16px; line-height: 1.7; color: var(--color-text-faint); }

  @media (max-width: 990px) {
    .coll__layout { grid-template-columns: 1fr; gap: 28px; }
    .coll__sidebar { position: static; }
    .coll__grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>

<script>
  (function () {
    function initSlider(slider) {
      var max = parseFloat(slider.getAttribute('data-max')) || 1;
      var rMin = slider.querySelector('[data-price-range="min"]');
      var rMax = slider.querySelector('[data-price-range="max"]');
      var fill = slider.querySelector('[data-price-fill]');
      var form = slider.closest('form');
      var iMin = form ? form.querySelector('[data-price-input="min"]') : null;
      var iMax = form ? form.querySelector('[data-price-input="max"]') : null;
      if (!rMin || !rMax) return;

      function pct(v) { return (v / max) * 100; }
      function lohi() { return [Math.min(+rMin.value, +rMax.value), Math.max(+rMin.value, +rMax.value)]; }
      function draw() {
        var lh = lohi();
        if (fill) { fill.style.left = pct(lh[0]) + '%'; fill.style.right = (100 - pct(lh[1])) + '%'; }
      }
      function syncInputs() {
        var lh = lohi();
        if (iMin) iMin.value = lh[0] > 0 ? lh[0] : '';
        if (iMax) iMax.value = lh[1] < max ? lh[1] : '';
      }
      var appliedLo = Math.min(+rMin.value, +rMax.value);
      var appliedHi = Math.max(+rMin.value, +rMax.value);
      function apply() {
        if (!form) return;
        var lh = lohi();
        if (lh[0] === appliedLo && lh[1] === appliedHi) return; /* unchanged -> don't reload */
        if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
      }

      rMin.addEventListener('input', function () { if (+rMin.value > +rMax.value) { rMin.value = rMax.value; } draw(); syncInputs(); });
      rMax.addEventListener('input', function () { if (+rMax.value < +rMin.value) { rMax.value = rMin.value; } draw(); syncInputs(); });
      rMin.addEventListener('change', apply);
      rMax.addEventListener('change', apply);

      /* keep whichever handle is grabbed on top (overlap), and stop the mouse-wheel
         from nudging the value — that was firing change and reloading the page */
      [rMin, rMax].forEach(function (r) {
        r.addEventListener('pointerdown', function () {
          rMin.style.zIndex = (r === rMin) ? 6 : 4;
          rMax.style.zIndex = (r === rMax) ? 6 : 4;
        });
        r.addEventListener('wheel', function (e) { e.preventDefault(); }, { passive: false });
        r.addEventListener('keydown', function (e) { /* let arrow keys work but only apply on release/blur */ });
      });

      if (iMin) {
        iMin.addEventListener('input', function () { var v = parseFloat(iMin.value); rMin.value = isNaN(v) ? 0 : Math.max(0, Math.min(v, max)); draw(); });
        iMin.addEventListener('change', apply);
      }
      if (iMax) {
        iMax.addEventListener('input', function () { var v = parseFloat(iMax.value); rMax.value = isNaN(v) ? max : Math.max(0, Math.min(v, max)); draw(); });
        iMax.addEventListener('change', apply);
      }
      draw();
    }
    document.querySelectorAll('[data-price-slider]').forEach(initSlider);
  })();
</script>

