    {
      "type": "earn",
      "name": "Earn method",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "★" },
        { "type": "text", "id": "title", "label": "Title", "default": "Place an Order" },
        { "type": "text", "id": "points", "label": "Points", "default": "5 pts / $1" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "Earn points on every purchase — the bigger the piece, the bigger the reward." }
      ]
    },
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "♦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Exclusive Discounts" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "Redeem points for real savings on any mosaic, including custom commissions." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rewards page",
      "blocks": [
        { "type": "step", "settings": { "icon": "✦", "title": "Create an Account", "desc": "Sign up free in seconds and instantly receive 1,500 welcome points." } },
        { "type": "step", "settings": { "icon": "★", "title": "Earn Points", "desc": "Collect points on purchases, reviews, referrals and more." } },
