<style>
  .rw-hero { background: var(--color-navy); color: #EAE1D2; }
  .rw-hero__crumb-wrap { padding-top: 30px; }
  .rw-hero__crumb { display: flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-soft); }
  .rw-hero__crumb-link { color: var(--color-text-faint); }
  .rw-hero__crumb-sep { color: #46546E; }
  .rw-hero__crumb-current { color: var(--color-light-text); }
  .rw-hero__inner { max-width: 820px; margin: 0 auto; padding: 60px 40px 70px; text-align: center; }
  .rw-hero__eyebrow { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 24px; }
  .rw-hero__rule { width: 38px; height: 1px; background: var(--color-blue); }
  .rw-hero__eyebrow-text { font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-blue-light); }
  .rw-hero__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(46px,5.6vw,78px); line-height: 1.02; letter-spacing: -.01em; margin-bottom: 24px; color: #fff; }
  .rw-hero__title em, .rw-hero__title i { font-style: italic; color: var(--color-blue-light); }
  .rw-hero__text { font-size: 17px; line-height: 1.7; color: var(--color-text-faint); max-width: 560px; margin: 0 auto 38px; }
  .rw-hero__ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .rw-hero__ghost { background: transparent; color: var(--color-bg); border: 1px solid rgba(220,230,245,.35); }
  .rw-hero__ghost:hover { background: rgba(255,255,255,.1); }

  .rw-how { padding-top: 90px; padding-bottom: 40px; }
  .rw-how__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
  .rw-how__step { text-align: center; padding: 14px; }
  .rw-how__icon { width: 64px; height: 64px; border-radius: 50%; border: 1px solid var(--color-blue); color: var(--color-blue); display: flex; align-items: center; justify-content: center; margin: 0 auto 22px; font-size: 26px; }
  .rw-how__n { font-family: var(--font-accent); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 10px; }
  .rw-how__title { font-family: var(--font-display); font-weight: 600; font-size: 25px; margin-bottom: 10px; color: var(--color-navy); }
  .rw-how__desc { font-size: 14.5px; line-height: 1.65; color: var(--color-text-muted); max-width: 300px; margin: 0 auto; }

  .rw-earn { padding-top: 80px; padding-bottom: 40px; }
  .rw-earn__head { text-align: center; margin-bottom: 54px; }
  .rw-earn__grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 22px; }
  .rw-earn__card { background: #fff; border: 1px solid rgba(22,51,94,.1); padding: 34px; display: flex; gap: 24px; align-items: flex-start; }
  .rw-earn__icon { flex-shrink: 0; width: 56px; height: 56px; border-radius: 50%; background: var(--color-panel); color: var(--color-blue); display: flex; align-items: center; justify-content: center; font-size: 22px; }
  .rw-earn__body { flex: 1; }
  .rw-earn__top { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-bottom: 10px; flex-wrap: wrap; }
  .rw-earn__title { font-family: var(--font-display); font-weight: 600; font-size: 24px; color: var(--color-navy); }
  .rw-earn__points { font-size: 13px; font-weight: 700; letter-spacing: .04em; color: var(--color-blue); white-space: nowrap; }
  .rw-earn__desc { font-size: 14.5px; line-height: 1.6; color: var(--color-text-muted); }

  .rw-redeem { background: var(--color-panel); margin-top: 80px; }
  .rw-redeem__grid { padding-top: 90px; padding-bottom: 90px; display: grid; grid-template-columns: 1fr 1.05fr; gap: 64px; align-items: center; }
  .rw-redeem__eyebrow { font-family: var(--font-accent); font-size: 13px; letter-spacing: .3em; text-transform: uppercase; color: var(--color-navy); margin-bottom: 14px; }
  .rw-redeem__heading { font-family: var(--font-display); font-weight: 500; font-size: clamp(32px,3.6vw,46px); line-height: 1.08; margin-bottom: 20px; color: var(--color-navy); }
  .rw-redeem__text { font-size: 16px; line-height: 1.7; color: var(--color-text-muted); margin-bottom: 26px; max-width: 440px; }
  .rw-redeem__ratio { display: flex; align-items: center; gap: 16px; background: var(--color-navy); color: #fff; padding: 20px 26px; }
  .rw-redeem__ratio-num { font-family: var(--font-display); font-size: 34px; line-height: 1; color: var(--color-blue-light); }
  .rw-redeem__ratio-num--light { color: #fff; }
  .rw-redeem__ratio-label { font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-faint); }
  .rw-redeem__ratio-rule { flex: 1; height: 1px; background: rgba(220,230,245,.25); }
  .rw-redeem__table { background: #fff; border: 1px solid rgba(22,51,94,.1); padding: 14px 38px; }
  .rw-redeem__row { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 0; border-bottom: 1px solid rgba(22,51,94,.08); }
  .rw-redeem__row-pts { display: flex; align-items: center; gap: 14px; font-family: var(--font-display); font-size: 26px; color: var(--color-navy); }
  .rw-redeem__row-unit { font-family: var(--font-body); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-text-faint); }
  .rw-redeem__row-val { font-family: var(--font-display); font-size: 26px; color: var(--color-blue); font-weight: 600; }
  .rw-redeem__note { text-align: center; font-size: 12.5px; color: var(--color-text-soft); padding: 18px 0 4px; font-style: italic; }

  .rw-perks { padding-top: 90px; padding-bottom: 100px; }
  .rw-perks__head { text-align: center; margin-bottom: 54px; }
  .rw-perks__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; }
  .rw-perks__item { padding: 0 36px; text-align: center; border-left: 1px solid var(--color-line); }
  .rw-perks__item:first-child { border-left: none; }
  .rw-perks__icon { width: 54px; height: 54px; border-radius: 50%; border: 1px solid var(--color-blue); color: var(--color-blue); display: flex; align-items: center; justify-content: center; margin: 0 auto 22px; font-size: 22px; }
  .rw-perks__title { font-family: var(--font-display); font-weight: 600; font-size: 23px; margin-bottom: 12px; color: var(--color-navy); }
  .rw-perks__desc { font-size: 14.5px; line-height: 1.65; color: var(--color-text-muted); }

  .rw-cta { background: var(--color-navy); color: #EAE1D2; }
  .rw-cta__inner { max-width: 760px; margin: 0 auto; padding: 90px 40px; text-align: center; }
  .rw-cta__heading { font-family: var(--font-display); font-weight: 500; font-size: clamp(34px,4vw,52px); line-height: 1.1; margin-bottom: 14px; color: #fff; }
  .rw-cta__text { font-size: 16px; line-height: 1.6; color: var(--color-text-faint); margin-bottom: 34px; }

  @media (max-width: 990px) {
    .rw-how__grid { grid-template-columns: 1fr; gap: 40px; }
    .rw-earn__grid { grid-template-columns: 1fr; }
    .rw-redeem__grid { grid-template-columns: 1fr; gap: 40px; }
    .rw-perks__grid { grid-template-columns: 1fr; gap: 48px; }
    .rw-perks__item { border-left: none; }
  }
</style>

{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- assign earns = section.blocks | where: 'type', 'earn' -%}
{%- assign perks = section.blocks | where: 'type', 'perk' -%}

<section class="rw-hero">
  <div class="page-width rw-hero__crumb-wrap">
    <div class="rw-hero__crumb">
      <a href="{{ routes.root_url }}" class="rw-hero__crumb-link">Home</a>
      <span class="rw-hero__crumb-sep">/</span>
      <span class="rw-hero__crumb-current">Rewards Program</span>
    </div>
  </div>
  <div class="rw-hero__inner">
    <div class="rw-hero__eyebrow"><span class="rw-hero__rule"></span><span class="rw-hero__eyebrow-text">{{ section.settings.eyebrow }}</span><span class="rw-hero__rule"></span></div>
    {%- if section.settings.heading != blank -%}<h1 class="rw-hero__title">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="rw-hero__text">{{ section.settings.text }}</p>{%- endif -%}
    <div class="rw-hero__ctas">
      {%- if section.settings.button_label_1 != blank -%}<a href="{{ section.settings.button_link_1 | default: routes.account_register_url }}" class="btn btn--blue">{{ section.settings.button_label_1 }}</a>{%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}<a href="#earn" class="btn rw-hero__ghost">{{ section.settings.button_label_2 }}</a>{%- endif -%}
    </div>
  </div>
</section>

{%- if steps.size > 0 -%}
<section class="rw-how page-width">
  <div class="rw-how__grid">
    {%- for block in steps -%}
      <div class="rw-how__step" {{ block.shopify_attributes }}>
        <div class="rw-how__icon">{{ block.settings.icon }}</div>
        <div class="rw-how__n">Step {{ forloop.index }}</div>
        <h3 class="rw-how__title">{{ block.settings.title }}</h3>
        <p class="rw-how__desc">{{ block.settings.desc }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- if earns.size > 0 -%}
<section id="earn" class="rw-earn page-width">
  <div class="rw-earn__head">
    <div class="eyebrow">Earn Points</div>
    <h2 class="section-title">Multiple Ways to Earn</h2>
  </div>
  <div class="rw-earn__grid">
    {%- for block in earns -%}
      <div class="rw-earn__card" {{ block.shopify_attributes }}>
        <div class="rw-earn__icon">{{ block.settings.icon }}</div>
        <div class="rw-earn__body">
          <div class="rw-earn__top">
            <h3 class="rw-earn__title">{{ block.settings.title }}</h3>
            <span class="rw-earn__points">{{ block.settings.points }}</span>
          </div>
          <p class="rw-earn__desc">{{ block.settings.desc }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

<section class="rw-redeem">
  <div class="page-width rw-redeem__grid">
    <div>
      <div class="rw-redeem__eyebrow">Redeem Points</div>
      <h2 class="rw-redeem__heading">{{ section.settings.redeem_heading }}</h2>
      <p class="rw-redeem__text">{{ section.settings.redeem_text }}</p>
      <div class="rw-redeem__ratio">
        <span class="rw-redeem__ratio-num">{{ section.settings.ratio_points }}</span>
        <span class="rw-redeem__ratio-label">Points</span>
        <span class="rw-redeem__ratio-rule"></span>
        <span class="rw-redeem__ratio-num rw-redeem__ratio-num--light">{{ section.settings.ratio_value }}</span>
        <span class="rw-redeem__ratio-label">Off</span>
      </div>
    </div>
    <div class="rw-redeem__table">
      {%- assign rows = section.settings.conversion_rows | newline_to_br | split: '<br />' -%}
      {%- for row in rows -%}
        {%- assign parts = row | strip | split: '|' -%}
        {%- if parts.size == 2 -%}
          <div class="rw-redeem__row">
            <span class="rw-redeem__row-pts">{{ parts[0] | strip }}<span class="rw-redeem__row-unit">Points</span></span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B7C0D2" stroke-width="1.6"><line x1="4" y1="12" x2="18" y2="12"/><polyline points="13 7 18 12 13 17"/></svg>
            <span class="rw-redeem__row-val">{{ parts[1] | strip }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
      <div class="rw-redeem__note">…and so on — points never go to waste.</div>
    </div>
  </div>
</section>

{%- if perks.size > 0 -%}
<section class="rw-perks page-width">
  <div class="rw-perks__head">
    <div class="eyebrow">Membership Perks</div>
    <h2 class="section-title">Everything to Gain</h2>
  </div>
  <div class="rw-perks__grid">
    {%- for block in perks -%}
      <div class="rw-perks__item" {{ block.shopify_attributes }}>
        <div class="rw-perks__icon">{{ block.settings.icon }}</div>
        <h3 class="rw-perks__title">{{ block.settings.title }}</h3>
        <p class="rw-perks__desc">{{ block.settings.desc }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- if section.settings.cta_heading != blank -%}
<section class="rw-cta">
  <div class="rw-cta__inner">
    <h2 class="rw-cta__heading">{{ section.settings.cta_heading }}</h2>
    {%- if section.settings.cta_text != blank -%}<p class="rw-cta__text">{{ section.settings.cta_text }}</p>{%- endif -%}
    {%- if section.settings.cta_button_label != blank -%}<a href="{{ section.settings.cta_button_link | default: routes.account_register_url }}" class="btn btn--blue">{{ section.settings.cta_button_label }}</a>{%- endif -%}
  </div>
</section>
{%- endif -%}


{% schema %}
{
  "name": "Rewards page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "iMosaicArt Rewards" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Earn Rewards for Your <em>Love of Mosaics</em></p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our rewards program thanks you for your loyalty. Earn points on purchases and simple actions, then redeem them for discounts on any mosaic — including custom designs." },
    { "type": "text", "id": "button_label_1", "label": "Button 1", "default": "Join Free — Get 1,500 Points" },
    { "type": "url", "id": "button_link_1", "label": "Button 1 link" },
