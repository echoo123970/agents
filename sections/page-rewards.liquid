    { "type": "text", "id": "ratio_points", "label": "Ratio points", "default": "100" },
    { "type": "text", "id": "ratio_value", "label": "Ratio value", "default": "$1" },
    { "type": "textarea", "id": "conversion_rows", "label": "Conversion rows (points | value, one per line)", "default": "500 | $5\n1,500 | $15\n3,000 | $30\n5,000 | $50" },
