<style>
  .cart-hero { background: var(--color-panel); border-bottom: 1px solid rgba(22,51,94,.08); }
  .cart-hero__crumb-wrap { padding-top: 30px; }
  .cart-hero__crumb { display: flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-soft); }
  .cart-hero__crumb-sep { color: #B7C0D2; }
  .cart-hero__crumb-current { color: var(--color-navy); }
  .cart-hero__title-wrap { padding-top: 40px; padding-bottom: 44px; }
  .cart-hero__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(38px,4.6vw,60px); line-height: 1.02; color: var(--color-navy); }
  .cart-hero__count { font-style: italic; color: var(--color-blue); font-size: .6em; margin-left: .7em; }

  .cart { padding-top: 56px; padding-bottom: 100px; }
  .cart__empty { text-align: center; padding: 70px 20px 90px; }
  .cart__empty-icon { width: 80px; height: 80px; border-radius: 50%; background: var(--color-panel); display: flex; align-items: center; justify-content: center; margin: 0 auto 28px; }
  .cart__empty-title { font-family: var(--font-display); font-weight: 500; font-size: 34px; margin-bottom: 12px; color: var(--color-navy); }
  .cart__empty-text { font-size: 16px; line-height: 1.6; color: var(--color-text-muted); margin-bottom: 30px; }

  .cart__layout { display: grid; grid-template-columns: 1fr 380px; gap: 48px; align-items: start; }
  .cart__items-head { display: grid; grid-template-columns: 1fr auto; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid rgba(22,51,94,.14); font-family: var(--font-accent); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-text-faint); }
  .cart__line { display: grid; grid-template-columns: 108px 1fr auto; gap: 22px; padding: 26px 0; border-bottom: 1px solid rgba(22,51,94,.1); align-items: center; }
  .cart__line-media { aspect-ratio: 1/1; overflow: hidden; background: var(--color-light-text); display: block; }
  .cart__line-media img { width: 100%; height: 100%; object-fit: cover; }
  .cart__line-sub { font-family: var(--font-accent); font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 6px; }
  .cart__line-title { display: block; font-family: var(--font-display); font-size: 23px; line-height: 1.15; color: var(--color-navy); margin-bottom: 6px; }
  .cart__line-variant { font-size: 13px; color: var(--color-text-soft); margin-bottom: 6px; }
  .cart__line-price { font-size: 14px; color: var(--color-text-muted); margin-bottom: 14px; }
  .cart__line-controls { display: flex; align-items: center; gap: 18px; }
  .cart__qty { display: flex; align-items: center; border: 1px solid rgba(22,51,94,.2); }
  .cart__qty-btn { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: var(--color-navy); font-size: 18px; line-height: 1; transition: background .2s ease; }
  .cart__qty-btn:hover { background: var(--color-panel); }
  .cart__qty-val { width: 36px; text-align: center; font-size: 14px; color: var(--color-navy); }
  .cart__remove { font-size: 12.5px; color: var(--color-text-faint); text-decoration: underline; text-underline-offset: 3px; }
  .cart__remove:hover { color: var(--color-blue); }
  .cart__line-total { font-family: var(--font-display); font-size: 22px; color: var(--color-navy); white-space: nowrap; }
  .cart__continue { display: inline-flex; align-items: center; gap: 10px; margin-top: 30px; font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-navy); }
  .cart__continue:hover { color: var(--color-blue); }

  .cart__summary { background: var(--color-navy); color: #EAE1D2; padding: 36px 34px; position: sticky; top: 100px; }
  .cart__summary-title { font-family: var(--font-display); font-weight: 500; font-size: 26px; margin-bottom: 24px; color: #fff; }
  .cart__summary-row { display: flex; align-items: center; justify-content: space-between; padding: 11px 0; font-size: 15px; color: #C7CFDD; }
  .cart__summary-row--border { border-bottom: 1px solid rgba(220,230,245,.16); }
  .cart__summary-val { color: #fff; }
  .cart__summary-free { color: var(--color-blue-light); }
  .cart__summary-total { display: flex; align-items: center; justify-content: space-between; padding: 20px 0 24px; color: #fff; }
  .cart__summary-total-label { font-family: var(--font-accent); letter-spacing: .06em; font-size: 16px; }
  .cart__summary-total-val { font-family: var(--font-display); font-size: 30px; }
  .cart__checkout { width: 100%; background: var(--color-blue); color: #fff; border: none; font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; padding: 17px; cursor: pointer; transition: background .25s ease; }
  .cart__checkout:hover { background: #1E63C4; }
  .cart__secure { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 18px; font-size: 12px; color: var(--color-text-faint); }
  .cart__note { margin-top: 22px; padding-top: 20px; border-top: 1px solid rgba(220,230,245,.16); font-size: 12.5px; line-height: 1.6; color: var(--color-text-faint); text-align: center; }

  .cart__continue--mob { display: none; }
  @media (max-width: 990px) {
    .cart__layout { grid-template-columns: 1fr; gap: 32px; }
    .cart__summary { position: static; }
    .cart__continue--desk { display: none; }
    .cart__continue--mob { display: inline-flex; margin-top: 26px; }
  }
  @media (max-width: 600px) {
    .cart__line { grid-template-columns: 80px 1fr; }
    .cart__line-total { grid-column: 2; }
    .cart__qty-btn { width: 42px; height: 42px; }
  }

  /* Force lining (modern) numerals so Cormorant does not render 1/3/4/7 as old-style glyphs */
  .cart-hero__title, .cart__line-title, .cart__line-price, .cart__line-total,
  .cart__qty-val, .cart__summary-title, .cart__summary-row, .cart__summary-val,
  .cart__summary-total-label, .cart__summary-total-val, .cart__empty-title {
    font-variant-numeric: lining-nums;
    font-feature-settings: "lnum" 1;
  }
</style>

<section class="cart-hero">
  <div class="page-width cart-hero__crumb-wrap">
    <div class="cart-hero__crumb">
      <a href="{{ routes.root_url }}" class="nav-link">Home</a>
      <span class="cart-hero__crumb-sep">/</span>
      <span class="cart-hero__crumb-current">Cart</span>
    </div>
  </div>
  <div class="page-width cart-hero__title-wrap">
    <h1 class="cart-hero__title">Your Cart
      {%- if cart.item_count > 0 -%}
        <span class="cart-hero__count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
      {%- endif -%}
    </h1>
  </div>
</section>

<section class="cart page-width">
  {%- if cart.item_count == 0 -%}
    <div class="cart__empty">
      <div class="cart__empty-icon">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
      </div>
      <h2 class="cart__empty-title">Your cart is empty</h2>
      <p class="cart__empty-text">Discover handcrafted mosaics and add your favorites to begin.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--dark">Browse Mosaics</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart__layout">
      <!-- LINE ITEMS -->
      <div class="cart__items">
        <div class="cart__items-head">
          <span>Product</span>
          <span>Total</span>
        </div>
        {%- for item in cart.items -%}
          <div class="cart__line">
            <a href="{{ item.url }}" class="cart__line-media">
              {%- if item.image != blank -%}
                <img src="{{ item.image | image_url: width: 220 }}" alt="{{ item.title | escape }}" width="108" height="108" loading="lazy">
              {%- endif -%}
            </a>
            <div class="cart__line-info">
              {%- if item.product.type != blank -%}<div class="cart__line-sub">{{ item.product.type }}</div>
              {%- elsif item.product.vendor != blank -%}<div class="cart__line-sub">{{ item.product.vendor }}</div>{%- endif -%}
              <a href="{{ item.url }}" class="cart__line-title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<div class="cart__line-variant">{{ item.variant.title }}</div>{%- endunless -%}
              <div class="cart__line-price">{{ item.original_price | money }}</div>
              <div class="cart__line-controls">
                <div class="cart__qty">
                  <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | minus: 1 }}" class="cart__qty-btn" aria-label="Decrease">−</a>
                  <span class="cart__qty-val">{{ item.quantity }}</span>
                  <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | plus: 1 }}" class="cart__qty-btn" aria-label="Increase">+</a>
                </div>
                <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" class="cart__remove">Remove</a>
              </div>
            </div>
            <div class="cart__line-total">{{ item.original_line_price | money }}</div>
          </div>
        {%- endfor -%}

        <a href="{{ routes.all_products_collection_url }}" class="cart__continue cart__continue--desk">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="20" y1="12" x2="5" y2="12"/><polyline points="11 18 5 12 11 6"/></svg>
          Continue Shopping
        </a>
      </div>

      <!-- SUMMARY -->
      <div class="cart__summary">
        <h2 class="cart__summary-title">Order Summary</h2>
        <div class="cart__summary-row">
          <span>Subtotal</span><span class="cart__summary-val">{{ cart.total_price | money }}</span>
        </div>
        <div class="cart__summary-row cart__summary-row--border">
          <span>Shipping</span><span class="cart__summary-free">Free</span>
        </div>
        <div class="cart__summary-total">
          <span class="cart__summary-total-label">TOTAL</span>
          <span class="cart__summary-total-val">{{ cart.total_price | money }}</span>
        </div>
        <button type="submit" name="checkout" class="cart__checkout">Proceed to Checkout</button>
        <div class="cart__secure">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7BB0F4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Secure 128-bit SSL checkout
        </div>
        <div class="cart__note">Each mosaic is handcrafted to order.</div>
      </div>

      <a href="{{ routes.all_products_collection_url }}" class="cart__continue cart__continue--mob">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="20" y1="12" x2="5" y2="12"/><polyline points="11 18 5 12 11 6"/></svg>
        Continue Shopping
      </a>
    </form>
  {%- endif -%}
</section>


{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
