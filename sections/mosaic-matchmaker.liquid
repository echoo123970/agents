{%- comment -%}
  Mosaic Matchmaker — full-screen guided quiz that recommends mosaics from the live catalog.
  Logic lives in assets/mosaic-matchmaker.js. Answer tiles use snippets/mm-tile.liquid.
{%- endcomment -%}
<style>
  .mm { background: var(--color-bg); min-height: calc(100vh - 110px); display: flex; flex-direction: column; }
  .mm__bar { height: 3px; background: var(--color-line); position: relative; }
  .mm__bar-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--color-blue); transition: width .45s cubic-bezier(.2,.7,.2,1); }
  .mm__screen { display: none; flex: 1; padding-top: 56px; padding-bottom: 72px; }
  .mm__screen.is-active { display: block; animation: mmIn .45s cubic-bezier(.2,.7,.2,1); }
  @keyframes mmIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .mm__screen.is-active { animation: none; } .mm__bar-fill { transition: none; } }

  .mm-eyebrow { font-family: var(--font-accent); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: var(--color-blue); }
  .mm-h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(40px, 5.4vw, 72px); line-height: 1.02; color: var(--color-navy); margin-top: 18px; }
  .mm-h1 em { font-style: italic; color: var(--color-blue); }
  .mm-lead { font-size: 17px; line-height: 1.65; color: var(--color-text-muted); max-width: 470px; margin-top: 22px; }
  .mm-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; background: var(--color-navy); color: #fff; border: 1px solid var(--color-navy); font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; padding: 19px 34px; cursor: pointer; transition: background .25s ease, border-color .25s ease; }
  .mm-btn:hover { background: var(--color-blue); border-color: var(--color-blue); }
  .mm-btn--ghost { background: transparent; color: var(--color-navy); border-color: rgba(22,51,94,.3); }
  .mm-btn--ghost:hover { color: #fff; }
  .mm-meta { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 26px; font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-text-soft); }
  .mm-meta span { display: inline-flex; align-items: center; gap: 8px; }
  .mm-meta span::before { content: ""; width: 6px; height: 6px; background: var(--color-blue); transform: rotate(45deg); }

  .mm-intro { display: grid; grid-template-columns: 1fr 1.05fr; gap: 64px; align-items: center; min-height: calc(100vh - 260px); }
  .mm-intro__cta { margin-top: 38px; display: flex; gap: 14px; flex-wrap: wrap; }
  .mm-collage { display: grid; grid-template-columns: 1.15fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; height: min(68vh, 620px); }
  .mm-collage__item { overflow: hidden; background: #fff; display: flex; align-items: center; justify-content: center; }
  .mm-collage__item:first-child { grid-row: 1 / 3; }
  .mm-collage__item img { width: 100%; height: 100%; object-fit: contain; padding: 14px; }

  .mm-q__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 26px; }
  .mm-back { background: none; border: none; padding: 6px 0; cursor: pointer; font-family: var(--font-body); font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-text-soft); display: inline-flex; align-items: center; gap: 8px; }
  .mm-back:hover { color: var(--color-navy); }
  .mm-count { font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-text-soft); }
  .mm-q__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(32px, 4vw, 52px); line-height: 1.08; color: var(--color-navy); max-width: 820px; outline: none; }
  .mm-q__hint { font-size: 15px; color: var(--color-text-muted); margin-top: 12px; }
  .mm-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 38px; }
  .mm-grid--5 { grid-template-columns: repeat(5, 1fr); }
  .mm-grid--text { grid-template-columns: repeat(4, 1fr); }
  .mm-grid--3 { grid-template-columns: repeat(3, 1fr); }

  .mm-tile { position: relative; display: flex; flex-direction: column; text-align: left; background: #fff; border: 1px solid rgba(22,51,94,.14); padding: 0; cursor: pointer; font-family: var(--font-body); color: var(--color-navy); transition: border-color .2s ease, transform .25s ease, box-shadow .25s ease; }
  .mm-tile:hover { border-color: var(--color-navy); transform: translateY(-3px); box-shadow: 0 14px 30px rgba(14,30,56,.1); }
  .mm-tile:focus { outline: none; }
  .mm-tile:focus-visible { outline: 2px solid var(--color-navy); outline-offset: 3px; }
  .mm-tile[aria-pressed="true"] { border-color: var(--color-navy); box-shadow: inset 0 0 0 2px var(--color-navy); }
  .mm-tile__media { display: block; aspect-ratio: 1/1; overflow: hidden; background: #fff; border-bottom: 1px solid var(--color-line); }
  .mm-tile__img { width: 100%; height: 100%; object-fit: contain; padding: 12px; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .mm-tile:hover .mm-tile__img { transform: scale(1.06); }
  .mm-tile__text { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px 18px; }
  .mm-tile__label { font-size: 15.5px; font-weight: 600; line-height: 1.3; }
  .mm-tile__sub { font-size: 13px; color: var(--color-text-soft); line-height: 1.4; }
  .mm-tile__icon { display: flex; align-items: center; justify-content: center; height: 96px; color: var(--color-navy); background: var(--color-panel); }
  .mm-tile__swatch { display: block; height: 110px; }
  .mm-sw--warm { background: conic-gradient(from 20deg, #C8922F, #8C5A2B, #E2C178, #6E4A2A, #D9A441, #A8743A, #C8922F); }
  .mm-sw--cool { background: conic-gradient(from 20deg, #1F5E8C, #3E9A9A, #9CC0F5, #2B7B6F, #5B86C4, #8FD1C9, #1F5E8C); }
  .mm-sw--bright { background: conic-gradient(from 20deg, #E04B4B, #F2B134, #3FAE6A, #2B7BE8, #9B5BD6, #F07AB0, #E04B4B); }
  .mm-sw--neutral { background: conic-gradient(from 20deg, #111, #F5F2EC, #8E8A84, #2A2A2A, #DCD6CC, #5C5853, #111); }
  .mm-tile__swatch { background-size: 100% 100%; -webkit-mask: none; position: relative; }
  .mm-tile__swatch::after { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.55) 2px, transparent 2px), linear-gradient(90deg, rgba(255,255,255,.55) 2px, transparent 2px); background-size: 16px 16px; }

  .mm-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; min-height: 50vh; gap: 26px; }
  .mm-tess { display: grid; grid-template-columns: repeat(4, 14px); gap: 5px; }
  .mm-tess span { width: 14px; height: 14px; background: var(--color-blue); opacity: .2; animation: mmT 1.2s infinite ease-in-out; }
  .mm-tess span:nth-child(3n) { background: var(--color-navy); }
  .mm-tess span:nth-child(4n) { background: #C8922F; }
  {%- for i in (1..16) -%}.mm-tess span:nth-child({{ i }}) { animation-delay: {{ i | times: 0.07 }}s; }{%- endfor -%}
  @keyframes mmT { 50% { opacity: 1; transform: scale(.85); } }
  .mm-loading__title { font-family: var(--font-display); font-size: 34px; color: var(--color-navy); }

  .mm-res__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .mm-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .mm-chip { font-size: 12px; letter-spacing: .06em; padding: 7px 12px; background: var(--color-panel); color: var(--color-navy); }
  .mm-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-top: 40px; }
  .mm-card { background: #fff; display: flex; flex-direction: column; border: 1px solid var(--color-line); }
  .mm-card__media { position: relative; display: block; aspect-ratio: 4/5; background: #fff; overflow: hidden; }
  .mm-card__media img { width: 100%; height: 100%; object-fit: contain; padding: 16px; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .mm-card:hover .mm-card__media img { transform: scale(1.04); }
  .mm-card__rank { position: absolute; top: 14px; left: 14px; background: var(--color-navy); color: #fff; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; padding: 7px 11px; }
  .mm-card__body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .mm-card__type { font-family: var(--font-accent); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--color-blue); }
  .mm-card__title { font-family: var(--font-display); font-size: 24px; line-height: 1.15; color: var(--color-navy); }
  .mm-card__size { font-size: 13px; color: var(--color-text-soft); }
  .mm-card__price { font-family: var(--font-display); font-size: 26px; color: var(--color-navy); margin-top: 2px; }
  .mm-card__why { font-size: 13px; color: var(--color-text-muted); line-height: 1.5; }
  .mm-card__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: auto; padding-top: 14px; }
  .mm-card__actions a { display: flex; align-items: center; justify-content: center; gap: 8px; text-align: center; font-size: 11.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; padding: 13px 10px; border: 1px solid var(--color-navy); transition: background .2s ease, color .2s ease; }
  .mm-card__actions a:first-child { background: var(--color-navy); color: #fff; }
  .mm-card__actions a:first-child:hover { background: var(--color-blue); border-color: var(--color-blue); }
  .mm-card__actions a:last-child { color: var(--color-navy); }
  .mm-card__actions a:last-child:hover { background: var(--color-navy); color: #fff; }
  .mm-more-title { font-family: var(--font-display); font-size: 30px; color: var(--color-navy); margin-top: 64px; }
  .mm-cards--more { margin-top: 24px; }
  .mm-cards--more .mm-card__title { font-size: 20px; }
  .mm-empty { margin-top: 40px; font-size: 16px; color: var(--color-text-muted); }

  .mm-lead-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-top: 72px; }
  .mm-lead-panel__a { background: var(--color-navy); color: #fff; padding: 44px 46px; }
  .mm-lead-panel__b { background: var(--color-panel); padding: 44px 46px; display: flex; flex-direction: column; justify-content: center; }
  .mm-lead-panel h3 { font-family: var(--font-display); font-weight: 500; font-size: 32px; line-height: 1.1; }
  .mm-lead-panel p { font-size: 15px; line-height: 1.6; margin-top: 12px; }
  .mm-lead-panel__a p { color: var(--color-light-text); }
  .mm-lead-panel__b h3 { color: var(--color-navy); }
  .mm-lead-panel__b p { color: var(--color-text-muted); }
  .mm-form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
  .mm-form input[type="text"], .mm-form input[type="email"], .mm-form input[type="tel"] { width: 100%; background: rgba(255,255,255,.07); border: 1px solid rgba(220,230,245,.3); color: #fff; font-family: var(--font-body); font-size: 15px; padding: 14px 16px; outline: none; }
  .mm-form input:focus { border-color: var(--color-blue-light); }
  .mm-form input::placeholder { color: var(--color-text-faint); }
  .mm-form__full { grid-column: 1 / -1; }
  .mm-form button { grid-column: 1 / -1; background: var(--color-blue); color: #fff; border: none; font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; padding: 16px; cursor: pointer; }
  .mm-form button:hover { background: #1E63C4; }
  .mm-form__err { grid-column: 1 / -1; color: #F2B8B8; font-size: 13px; }
  .mm-lead-panel__b .mm-btn { margin-top: 24px; align-self: flex-start; }
  .mm-thanks { text-align: center; max-width: 620px; margin: 0 auto; padding-top: 40px; }
  .mm-thanks .mm-lead { margin-left: auto; margin-right: auto; }
  .mm-thanks .mm-intro__cta { justify-content: center; }

  @media (max-width: 990px) {
    .mm-intro { grid-template-columns: 1fr; gap: 40px; min-height: 0; }
    .mm-collage { height: 420px; }
    .mm-grid, .mm-grid--5, .mm-grid--text { grid-template-columns: repeat(3, 1fr); }
    .mm-cards { grid-template-columns: repeat(2, 1fr); }
    .mm-lead-panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .mm__screen { padding-top: 32px; padding-bottom: 56px; }
    .mm-collage { height: 300px; gap: 8px; }
    .mm-grid, .mm-grid--5, .mm-grid--text, .mm-grid--3 { grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 26px; }
    .mm-tile__text { padding: 12px 12px 14px; }
    .mm-tile__label { font-size: 14px; }
    .mm-tile__sub { font-size: 12px; }
    .mm-tile__swatch { height: 80px; }
    .mm-tile__icon { height: 72px; }
    .mm-cards { grid-template-columns: 1fr; }
    .mm-lead-panel__a, .mm-lead-panel__b { padding: 32px 24px; }
    .mm-form { grid-template-columns: 1fr; }
    .mm-intro__cta .mm-btn { width: 100%; }
  }
</style>

{%- assign intro_col = section.settings.intro_collection | default: collections['best-sellers'] -%}
{%- capture icon_wall -%}<svg width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="6" y="6" width="36" height="36"/><rect x="15" y="13" width="18" height="14"/><line x1="6" y1="42" x2="42" y2="42" stroke-width="3"/></svg>{%- endcapture -%}

<section class="mm" data-mm aria-live="polite">
  <div class="mm__bar" aria-hidden="true"><div class="mm__bar-fill" data-mm-bar></div></div>

  {%- assign mm_posted = false -%}
  {%- form 'contact', id: 'MosaicMatchmakerLead', hidden: true -%}
    {%- if form.posted_successfully? -%}{%- assign mm_posted = true -%}{%- endif -%}
  {%- endform -%}
  {%- if mm_posted -%}
      <div class="mm__screen is-active page-width" data-mm-thanks>
        <div class="mm-thanks">
          <div class="mm-eyebrow">{{ section.settings.eyebrow }}</div>
          <h1 class="mm-h1">{{ section.settings.thanks_heading }}</h1>
          <p class="mm-lead">{{ section.settings.thanks_text }}</p>
          <div class="mm-intro__cta">
            <a class="mm-btn" href="{{ routes.all_products_collection_url }}">Browse all mosaics</a>
            <a class="mm-btn mm-btn--ghost" href="{{ page.url }}">Take the quiz again</a>
          </div>
        </div>
      </div>
  {%- endif -%}

  {%- unless mm_posted -%}
  <!-- INTRO -->
  <div class="mm__screen is-active page-width" data-step="intro">
    <div class="mm-intro">
      <div>
        <div class="mm-eyebrow">{{ section.settings.eyebrow }}</div>
        <h1 class="mm-h1">{{ section.settings.heading }}</h1>
        <p class="mm-lead">{{ section.settings.intro }}</p>
        <div class="mm-intro__cta">
          <button type="button" class="mm-btn" data-mm-start>{{ section.settings.start_label }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
        <div class="mm-meta"><span>6 quick questions</span><span>30 seconds</span><span>Hand-picked matches</span></div>
      </div>
      <div class="mm-collage" aria-hidden="true">
        {%- for p in intro_col.products limit: 3 -%}
          <div class="mm-collage__item">{{ p.featured_image | image_url: width: 900 | image_tag: loading: 'eager', alt: '' }}</div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <!-- Q1 PLACEMENT -->
  <div class="mm__screen page-width" data-step="placement">
    <div class="mm-q__top"><button type="button" class="mm-back" data-mm-back>&larr; Back</button><span class="mm-count">Question 1 of 6</span></div>
    <h2 class="mm-q__title" tabindex="-1">Where will your mosaic live?</h2>
    <div class="mm-grid mm-grid--5">
      {% render 'mm-tile', q: 'placement', v: 'wall', label: 'On a wall', sub: 'Living room, hall, bedroom', handle: 'portrait-mosaics' %}
      {% render 'mm-tile', q: 'placement', v: 'floor', label: 'On the floor', sub: 'Medallions, rugs, entryways', handle: 'geometric-mosaics' %}
      {% render 'mm-tile', q: 'placement', v: 'backsplash', label: 'Kitchen backsplash', sub: 'Behind the stove or sink', handle: 'mosaic-tile-backsplash' %}
      {% render 'mm-tile', q: 'placement', v: 'pool', label: 'Pool or bathroom', sub: 'Wet areas & outdoors', handle: 'nautical-mosaics' %}
      {% render 'mm-tile', q: 'placement', v: 'table', label: 'Table top', sub: 'Dining, coffee & garden tables', handle: 'table-countertop-mosaics' %}
    </div>
  </div>

  <!-- Q2 SUBJECT -->
  <div class="mm__screen page-width" data-step="subject">
    <div class="mm-q__top"><button type="button" class="mm-back" data-mm-back>&larr; Back</button><span class="mm-count">Question 2 of 6</span></div>
    <h2 class="mm-q__title" tabindex="-1">What speaks to you?</h2>
    <div class="mm-grid">
      {% render 'mm-tile', q: 'subject', v: 'nature', label: 'Nature & trees', handle: 'tree-mosaics' %}
      {% render 'mm-tile', q: 'subject', v: 'flowers', label: 'Flowers', handle: 'flower-mosaics' %}
      {% render 'mm-tile', q: 'subject', v: 'animals', label: 'Birds & animals', handle: 'bird-mosaics' %}
      {% render 'mm-tile', q: 'subject', v: 'sea', label: 'Sea & nautical', handle: 'nautical-mosaics' %}
      {% render 'mm-tile', q: 'subject', v: 'religious', label: 'Religious', handle: 'religious-mosaics' %}
      {% render 'mm-tile', q: 'subject', v: 'art', label: 'Famous art & portraits', sub: 'Klimt, Van Gogh, Roman', handle: 'van-gogh-mosaics' %}
      {% render 'mm-tile', q: 'subject', v: 'geometric', label: 'Geometric & patterns', handle: 'patterns-mosaics' %}
      {% render 'mm-tile', q: 'subject', v: 'abstract', label: 'Abstract & modern', handle: 'abstract' %}
    </div>
  </div>

  <!-- Q3 COLOUR -->
  <div class="mm__screen page-width" data-step="colour">
    <div class="mm-q__top"><button type="button" class="mm-back" data-mm-back>&larr; Back</button><span class="mm-count">Question 3 of 6</span></div>
    <h2 class="mm-q__title" tabindex="-1">Which colour mood suits your space?</h2>
    <div class="mm-grid">
      {% render 'mm-tile', q: 'colour', v: 'warm', label: 'Warm golds & earth', sub: 'Gold, amber, terracotta', swatch: 'mm-sw--warm', prod_handle: 'glass-mosaic-tile-glass-mosaic-art-the-kiss-by-gustav-klimt' %}
      {% render 'mm-tile', q: 'colour', v: 'cool', label: 'Cool blues & greens', sub: 'Sea, sky, sage', swatch: 'mm-sw--cool', prod_handle: 'glass-mosaic-tile-wall-art-glass-mosaic-ocean-mosaic-scene' %}
      {% render 'mm-tile', q: 'colour', v: 'bright', label: 'Bright & colourful', sub: 'Bold, joyful, vivid', swatch: 'mm-sw--bright', prod_handle: 'watercolor-peacock-feather-wall-art-modern-mosaic-creation' %}
      {% render 'mm-tile', q: 'colour', v: 'neutral', label: 'Black, white & neutral', sub: 'Calm, classic, minimal', swatch: 'mm-sw--neutral', prod_handle: 'abstract-glass-white-and-black-mosaic-mural' %}
    </div>
  </div>

  <!-- Q4 SIZE -->
  <div class="mm__screen page-width" data-step="size">
    <div class="mm-q__top"><button type="button" class="mm-back" data-mm-back>&larr; Back</button><span class="mm-count">Question 4 of 6</span></div>
    <h2 class="mm-q__title" tabindex="-1">How big is the space?</h2>
    <p class="mm-q__hint">Think of the longest side of the mosaic.</p>
    <div class="mm-grid">
      {%- capture i_s -%}<svg width="70" height="60" viewBox="0 0 70 60" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="27" y="22" width="16" height="16"/><line x1="4" y1="56" x2="66" y2="56"/></svg>{%- endcapture -%}
      {%- capture i_m -%}<svg width="70" height="60" viewBox="0 0 70 60" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="21" y="14" width="28" height="28"/><line x1="4" y1="56" x2="66" y2="56"/></svg>{%- endcapture -%}
      {%- capture i_l -%}<svg width="70" height="60" viewBox="0 0 70 60" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="12" y="6" width="46" height="42"/><line x1="4" y1="56" x2="66" y2="56"/></svg>{%- endcapture -%}
      {%- capture i_c -%}<svg width="70" height="60" viewBox="0 0 70 60" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="14" y="10" width="42" height="36" stroke-dasharray="4 3"/><path d="M35 20v16M27 28h16"/><line x1="4" y1="56" x2="66" y2="56"/></svg>{%- endcapture -%}
      {% render 'mm-tile', q: 'size', v: 'small', label: 'Small', sub: 'Under 70 cm / 28″', prod_handle: 'landscape-mosaics-mosaic-tree-medallion-art' %}
      {% render 'mm-tile', q: 'size', v: 'medium', label: 'Medium', sub: '70–120 cm / 28–47″', prod_handle: 'religious-mosaics-virgin-mary-jesus-mosaic-art' %}
      {% render 'mm-tile', q: 'size', v: 'large', label: 'Large statement', sub: 'Over 120 cm / 47″', prod_handle: 'religious-mosaics-last-supper-mosaic-leonardo-da-vinci-reproduction' %}
      {% render 'mm-tile', q: 'size', v: 'custom', label: 'I need a custom size', sub: 'Made to your exact measurements', asset_file: 'custom-flower-vase-room.jpg' %}
    </div>
  </div>

  <!-- Q5 BUDGET -->
  <div class="mm__screen page-width" data-step="budget">
    <div class="mm-q__top"><button type="button" class="mm-back" data-mm-back>&larr; Back</button><span class="mm-count">Question 5 of 6</span></div>
    <h2 class="mm-q__title" tabindex="-1">What budget do you have in mind?</h2>
    <div class="mm-grid">
      {% render 'mm-tile', q: 'budget', v: 'b1', label: 'Under $1,000', sub: 'Accent pieces & medallions', prod_handle: 'flower-mosaics-flower-mosaic-art-simple-flower-mosaic-design' %}
      {% render 'mm-tile', q: 'budget', v: 'b2', label: '$1,000 – $2,000', sub: 'Feature walls & portraits', prod_handle: 'bird-mosaics-peacock-wall-art-handmade-mosaic-art' %}
      {% render 'mm-tile', q: 'budget', v: 'b3', label: '$2,000 – $3,500', sub: 'Large statement murals', prod_handle: 'two-parrots-in-love-mosaic-glass-mural' %}
      {% render 'mm-tile', q: 'budget', v: 'b4', label: '$3,500 and above', sub: 'Grand masterpieces', prod_handle: 'portrait-mosaics-mosaic-portrait-mona-lisa-by-leonardo-da-vinci-mosaic-reproduction' %}
    </div>
  </div>

  <!-- Q6 MATERIAL -->
  <div class="mm__screen page-width" data-step="material">
    <div class="mm-q__top"><button type="button" class="mm-back" data-mm-back>&larr; Back</button><span class="mm-count">Question 6 of 6</span></div>
    <h2 class="mm-q__title" tabindex="-1">Which material do you prefer?</h2>
    <div class="mm-grid mm-grid--3">
      {% render 'mm-tile', q: 'material', v: 'glass', label: 'Glass', sub: 'Luminous, vivid colour', handle: 'glass-mosaic-art' %}
      {% render 'mm-tile', q: 'material', v: 'stone', label: 'Natural stone & marble', sub: 'Timeless, earthy texture', handle: 'roman-mosaics' %}
      {% render 'mm-tile', q: 'material', v: 'any', label: 'No preference', sub: 'Show me the best of both', handle: 'best-sellers' %}
    </div>
  </div>

  <!-- LOADING -->
  <div class="mm__screen page-width" data-step="loading">
    <div class="mm-loading">
      <div class="mm-tess" aria-hidden="true">{%- for i in (1..16) -%}<span></span>{%- endfor -%}</div>
      <p class="mm-loading__title">Matching you with mosaics…</p>
    </div>
  </div>

  <!-- RESULTS -->
  <div class="mm__screen page-width" data-step="results">
    <div class="mm-res__head">
      <div>
        <div class="mm-eyebrow">{{ section.settings.eyebrow }}</div>
        <h2 class="mm-q__title" tabindex="-1" style="margin-top:14px">{{ section.settings.results_heading }}</h2>
        <div class="mm-chips" data-mm-chips></div>
      </div>
      <button type="button" class="mm-btn mm-btn--ghost" data-mm-restart>Start over</button>
    </div>
    <div class="mm-cards" data-mm-top></div>
    <h3 class="mm-more-title" data-mm-more-title hidden>More you may love</h3>
    <div class="mm-cards mm-cards--more" data-mm-more></div>

    <div class="mm-lead-panel">
      <div class="mm-lead-panel__a">
        <h3>{{ section.settings.lead_heading }}</h3>
        <p>{{ section.settings.lead_text }}</p>
        {%- form 'contact', id: 'MosaicMatchmakerLeadForm', class: 'mm-form' -%}
          {%- if form.errors -%}<div class="mm-form__err">{{ form.errors | default_errors }}</div>{%- endif -%}
          <input type="hidden" name="contact[Source]" value="Mosaic Matchmaker quiz">
          <textarea name="contact[body]" data-mm-body hidden aria-hidden="true" tabindex="-1"></textarea>
          <label class="visually-hidden" for="MmName">Name</label>
          <input type="text" id="MmName" name="contact[name]" placeholder="Your name" autocomplete="name">
          <label class="visually-hidden" for="MmEmail">Email</label>
          <input type="email" id="MmEmail" name="contact[email]" placeholder="Your email" autocomplete="email" required>
          <label class="visually-hidden" for="MmPhone">Phone (optional)</label>
          <input type="tel" id="MmPhone" class="mm-form__full" name="contact[phone]" placeholder="Phone (optional)" autocomplete="tel">
          <button type="submit">{{ section.settings.lead_button }}</button>
        {%- endform -%}
      </div>
      <div class="mm-lead-panel__b">
        <h3>{{ section.settings.custom_heading }}</h3>
        <p>{{ section.settings.custom_text }}</p>
        <a class="mm-btn" href="{{ section.settings.custom_link | default: '/pages/custom-mosaics' }}">{{ section.settings.custom_label }}</a>
      </div>
    </div>
  </div>
  {%- endunless -%}
</section>

<script type="application/json" data-mm-config>
  {
    "currency": {{ cart.currency.iso_code | json }},
    "locale": {{ request.locale.iso_code | json }},
    "labels": {
      "placement": { "wall": "On a wall", "floor": "On the floor", "backsplash": "Kitchen backsplash", "pool": "Pool or bathroom", "table": "Table top" },
      "subject": { "nature": "Nature & trees", "flowers": "Flowers", "animals": "Birds & animals", "sea": "Sea & nautical", "religious": "Religious", "art": "Famous art & portraits", "geometric": "Geometric & patterns", "abstract": "Abstract & modern" },
      "colour": { "warm": "Warm golds & earth", "cool": "Cool blues & greens", "bright": "Bright & colourful", "neutral": "Black, white & neutral" },
      "size": { "small": "Small", "medium": "Medium", "large": "Large", "custom": "Custom size" },
      "budget": { "b1": "Under $1,000", "b2": "$1,000–$2,000", "b3": "$2,000–$3,500", "b4": "$3,500+" },
      "material": { "glass": "Glass", "stone": "Natural stone & marble", "any": "Any material" }
    }
  }
</script>
<script src="{{ 'mosaic-matchmaker.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Mosaic Matchmaker quiz",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mosaic Matchmaker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the mosaic made for your space" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Answer six quick questions about your room, style and budget, and we'll hand-pick the mosaics from our collection that fit you best." },
    { "type": "text", "id": "start_label", "label": "Start button label", "default": "Start the quiz" },
    { "type": "collection", "id": "intro_collection", "label": "Intro photos collection", "info": "Uses Best Sellers if empty" },
    { "type": "header", "content": "Results" },
    { "type": "text", "id": "results_heading", "label": "Results heading", "default": "Your perfect matches" },
    { "type": "text", "id": "lead_heading", "label": "Designer help heading", "default": "Want a designer's opinion?" },
    { "type": "textarea", "id": "lead_text", "label": "Designer help text", "default": "Send us your matches and our design team will get back to you with personal advice, sizing help and a quote." },
    { "type": "text", "id": "lead_button", "label": "Designer help button", "default": "Send my matches" },
    { "type": "text", "id": "custom_heading", "label": "Custom design heading", "default": "Have something else in mind?" },
    { "type": "textarea", "id": "custom_text", "label": "Custom design text", "default": "Any subject, any size, any stone. Our artisans hand-cut a one-of-a-kind mosaic made to your exact measurements." },
    { "type": "text", "id": "custom_label", "label": "Custom design button", "default": "Request a custom design" },
    { "type": "url", "id": "custom_link", "label": "Custom design link" },
    { "type": "header", "content": "After sending" },
    { "type": "text", "id": "thanks_heading", "label": "Thank-you heading", "default": "Thank you, your matches are on their way to our designers" },
    { "type": "textarea", "id": "thanks_text", "label": "Thank-you text", "default": "Our design team will review your choices and get back to you by email." }
  ]
}
{% endschema %}
