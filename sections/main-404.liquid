<style>
  .error-404 { padding-top: 120px; padding-bottom: 140px; text-align: center; }
  .error-404__code { font-family: var(--font-display); font-size: clamp(80px, 14vw, 180px); line-height: 1; color: var(--color-blue); margin-bottom: 8px; }
  .error-404__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(28px, 4vw, 44px); color: var(--color-navy); margin-bottom: 14px; }
  .error-404__text { font-size: 16px; color: var(--color-text-muted); margin-bottom: 32px; }
</style>

<section class="error-404 page-width">
  <h1 class="error-404__code">404</h1>
  <h2 class="error-404__title">{{ 'general.404.title' | t }}</h2>
  <p class="error-404__text">{{ 'general.404.subtext' | t }}</p>
  <a href="{{ routes.root_url }}" class="btn btn--dark">{{ 'general.404.link' | t }}</a>
</section>


{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
