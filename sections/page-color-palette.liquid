<style>
  .cp-hero { background: var(--color-panel); border-bottom: 1px solid rgba(22,51,94,.08); }
  .cp-hero__crumb-wrap { padding-top: 30px; }
  .cp-hero__crumb { display: flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-soft); }
  .cp-hero__crumb-sep { color: #B7C0D2; }
  .cp-hero__crumb-current { color: var(--color-navy); }
  .cp-hero__inner { max-width: 820px; margin: 0 auto; padding: 46px 40px 56px; text-align: center; }
  .cp-hero__eyebrow { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 22px; }
  .cp-hero__rule { width: 38px; height: 1px; background: var(--color-blue); }
  .cp-hero__eyebrow-text { font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-navy); }
  .cp-hero__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(44px,5.4vw,72px); line-height: 1.02; letter-spacing: -.01em; margin-bottom: 22px; color: var(--color-navy); }
  .cp-hero__title em, .cp-hero__title i { font-style: italic; color: var(--color-blue); }
  .cp-hero__text { font-size: 17px; line-height: 1.7; color: var(--color-text-muted); max-width: 580px; margin: 0 auto; }

  .cp-group { padding-top: 60px; padding-bottom: 30px; }
  .cp-group--first { padding-top: 80px; }
  .cp-group__head { display: flex; align-items: center; gap: 22px; margin-bottom: 44px; }
  .cp-group__title { font-family: var(--font-accent); font-size: 14px; letter-spacing: .28em; text-transform: uppercase; color: var(--color-navy); white-space: nowrap; }
  .cp-group__rule { flex: 1; height: 1px; background: rgba(22,51,94,.15); }
  .cp-group__count { font-size: 12.5px; color: var(--color-text-faint); }
  .cp-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 30px 24px; }
  .sw-card { display: flex; flex-direction: column; }
  .sw-mosaic { aspect-ratio: 1/1; overflow: hidden; background: #C9D2DF; box-shadow: 0 6px 18px rgba(22,51,94,.1); }
  .sw-mosaic img { width: 100%; height: 100%; object-fit: cover; }
  .sw-meta { margin-top: 14px; text-align: center; }
  .sw-num { font-family: var(--font-display); font-size: 18px; color: var(--color-text-faint); line-height: 1; margin-bottom: 5px; }
  .sw-name { font-family: var(--font-accent); font-size: 13px; letter-spacing: .03em; color: var(--color-navy); transition: color .3s ease; }
  .sw-card:hover .sw-name { color: var(--color-blue); }

  .cp-cta { background: var(--color-navy); color: #EAE1D2; margin-top: 70px; }
  .cp-cta__inner { max-width: 760px; margin: 0 auto; padding: 90px 40px; text-align: center; }
  .cp-cta__eyebrow { font-family: var(--font-accent); font-size: 13px; letter-spacing: .32em; text-transform: uppercase; color: var(--color-blue-light); margin-bottom: 18px; }
  .cp-cta__heading { font-family: var(--font-display); font-weight: 500; font-size: clamp(32px,3.8vw,48px); line-height: 1.1; margin-bottom: 16px; color: #fff; }
  .cp-cta__text { font-size: 16px; line-height: 1.7; color: var(--color-text-faint); margin: 0 auto 34px; max-width: 500px; }

  @media (max-width: 990px) { .cp-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 600px) { .cp-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{%- assign marble = section.blocks | where: 'type', 'marble' -%}
{%- assign engineered = section.blocks | where: 'type', 'engineered' -%}

<section class="cp-hero">
  <div class="page-width cp-hero__crumb-wrap">
    <div class="cp-hero__crumb">
      <a href="{{ routes.root_url }}" class="nav-link">Home</a>
      <span class="cp-hero__crumb-sep">/</span>
      <span class="cp-hero__crumb-current">{{ page.title | default: 'Color Palette' }}</span>
    </div>
  </div>
  <div class="cp-hero__inner">
    <div class="cp-hero__eyebrow"><span class="cp-hero__rule"></span><span class="cp-hero__eyebrow-text">{{ section.settings.eyebrow }}</span><span class="cp-hero__rule"></span></div>
    {%- if section.settings.heading != blank -%}<h1 class="cp-hero__title">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="cp-hero__text">{{ section.settings.text }}</p>{%- endif -%}
  </div>
</section>

{%- assign marble_count = section.settings.marble_count -%}
{%- assign engineered_count = section.settings.engineered_count -%}
<section class="cp-group page-width cp-group--first">
  <div class="cp-group__head">
    <span class="cp-group__title">{{ section.settings.marble_label }}</span>
    <span class="cp-group__rule"></span>
    <span class="cp-group__count">{{ marble_count }} tones</span>
  </div>
  <div class="cp-grid">
    {%- for i in (1..marble_count) -%}
      {%- assign n = i | prepend: '0' | slice: -2, 2 -%}
      <div class="sw-card">
        <div class="sw-mosaic"><img src="{{ 'sw-' | append: n | append: '.png' | asset_url }}" alt="Mosaic swatch {{ n }}" width="400" height="400" loading="lazy"></div>
        <div class="sw-meta"><div class="sw-num">{{ n }}</div><div class="sw-name">Marble Tone {{ n }}</div></div>
      </div>
    {%- endfor -%}
  </div>
</section>

{%- if engineered_count > 0 -%}
<section class="cp-group page-width">
  <div class="cp-group__head">
    <span class="cp-group__title">{{ section.settings.engineered_label }}</span>
    <span class="cp-group__rule"></span>
    <span class="cp-group__count">{{ engineered_count }} tones</span>
  </div>
  <div class="cp-grid">
    {%- for i in (1..engineered_count) -%}
      {%- assign idx = marble_count | plus: i -%}
      {%- assign n = idx | prepend: '0' | slice: -2, 2 -%}
      <div class="sw-card">
        <div class="sw-mosaic"><img src="{{ 'sw-' | append: n | append: '.png' | asset_url }}" alt="Engineered swatch {{ n }}" width="400" height="400" loading="lazy"></div>
        <div class="sw-meta"><div class="sw-num">{{ n }}</div><div class="sw-name">Engineered Tone {{ n }}</div></div>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- if section.settings.cta_heading != blank -%}
<section class="cp-cta">
  <div class="cp-cta__inner">
    <div class="cp-cta__eyebrow">{{ section.settings.cta_eyebrow }}</div>
    <h2 class="cp-cta__heading">{{ section.settings.cta_heading }}</h2>
    {%- if section.settings.cta_text != blank -%}<p class="cp-cta__text">{{ section.settings.cta_text }}</p>{%- endif -%}
    {%- if section.settings.cta_button_label != blank -%}<a href="{{ section.settings.cta_button_link }}" class="btn btn--blue">{{ section.settings.cta_button_label }}</a>{%- endif -%}
  </div>
</section>
{%- endif -%}


{% schema %}
{
  "name": "Color Palette page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Materials" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Natural Marble & <em>Engineered Stones</em></p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every mosaic is hand-cut from this curated palette of natural marble and engineered stone. Choose your tones — or combine them — to compose a piece entirely your own." },
    { "type": "text", "id": "marble_label", "label": "Group 1 label", "default": "Natural Marble Group" },
    { "type": "range", "id": "marble_count", "min": 6, "max": 42, "step": 1, "label": "Marble swatches", "default": 42 },
    { "type": "text", "id": "engineered_label", "label": "Group 2 label", "default": "Engineered Stones Group" },
    { "type": "range", "id": "engineered_count", "min": 0, "max": 6, "step": 1, "label": "Engineered swatches", "default": 6 },
    { "type": "header", "content": "CTA band" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Compose Your Own" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Bring Your Palette to Life" },
    { "type": "textarea", "id": "cta_text", "label": "Text", "default": "Share the tones you love and our artisans will hand-cut a one-of-a-kind mosaic in your chosen colors." },
    { "type": "text", "id": "cta_button_label", "label": "Button label", "default": "Start a Custom Mosaic Piece" },
    { "type": "url", "id": "cta_button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "marble",
      "name": "Marble swatch",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Swatch image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Carrara White" }
      ]
    },
    {
      "type": "engineered",
      "name": "Engineered swatch",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Swatch image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Onyx Blue" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Color Palette page",
      "blocks": [
        { "type": "marble" }, { "type": "marble" }, { "type": "marble" }, { "type": "marble" }, { "type": "marble" }, { "type": "marble" },
        { "type": "engineered" }, { "type": "engineered" }, { "type": "engineered" }
      ]
    }
  ]
}
{% endschema %}
