<section class="testimonials">
  <div class="page-width testimonials__inner">
    <div class="testimonials__head">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="testimonials__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="testimonials__card" {{ block.shopify_attributes }}>
            <div class="testimonials__stars">★★★★★</div>
            <p class="testimonials__quote">“{{ block.settings.quote }}”</p>
            <div class="testimonials__author">
              {%- if block.settings.avatar != blank -%}
                <img src="{{ block.settings.avatar | image_url: width: 92 }}" alt="{{ block.settings.name | escape }}" width="46" height="46" class="testimonials__avatar">
              {%- elsif block.settings.avatar_file != blank -%}
                <img src="{{ block.settings.avatar_file | asset_url }}" alt="{{ block.settings.name | escape }}" width="46" height="46" class="testimonials__avatar">
              {%- endif -%}
              <div>
                <div class="testimonials__name">{{ block.settings.name }}</div>
                <div class="testimonials__place">{{ block.settings.place }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign t_quotes = section.settings.default_quotes | split: '|' -%}
        {%- assign t_names = section.settings.default_names | split: '|' -%}
        {%- assign t_places = section.settings.default_places | split: '|' -%}
        {%- assign t_avatars = section.settings.default_avatars | split: '|' -%}
        {%- for q in t_quotes -%}
          <div class="testimonials__card">
            <div class="testimonials__stars">★★★★★</div>
            <p class="testimonials__quote">“{{ q | strip }}”</p>
            <div class="testimonials__author">
              {%- assign av = t_avatars[forloop.index0] | strip -%}
              {%- if av contains '://' -%}
                <img src="{{ av }}" alt="{{ t_names[forloop.index0] | strip | escape }}" width="46" height="46" class="testimonials__avatar" loading="lazy" referrerpolicy="no-referrer">
              {%- elsif av != blank -%}
                <img src="{{ av | asset_url }}" alt="{{ t_names[forloop.index0] | strip | escape }}" width="46" height="46" class="testimonials__avatar" loading="lazy">
              {%- endif -%}
              <div>
                <div class="testimonials__name">{{ t_names[forloop.index0] | strip }}</div>
                <div class="testimonials__place">{{ t_places[forloop.index0] | strip }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .testimonials { background: var(--color-panel); }
  .testimonials__inner { padding-top: 128px; padding-bottom: 128px; }
  .testimonials__head { text-align: center; margin-bottom: 54px; }
  .testimonials__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .testimonials__card { background: #fff; padding: 34px 32px; display: flex; flex-direction: column; height: 100%; }
  .testimonials__stars { color: var(--color-blue); letter-spacing: 3px; font-size: 15px; margin-bottom: 18px; }
  .testimonials__quote { font-family: var(--font-display); font-size: 21px; line-height: 1.4; color: var(--color-navy); margin-bottom: 28px; flex: 1; }
  .testimonials__author { display: flex; align-items: center; gap: 14px; border-top: 1px solid rgba(22,51,94,.1); padding-top: 18px; }
  .testimonials__avatar { width: 46px; height: 46px; border-radius: 50%; object-fit: cover; }
  .testimonials__name { font-size: 14.5px; font-weight: 600; color: var(--color-navy); }
  .testimonials__place { font-size: 12.5px; color: var(--color-text-soft); }
  @media (max-width: 990px) {
    .testimonials__inner { padding-top: 80px; padding-bottom: 80px; }
    .testimonials__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real Experiences" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved In Homes Worldwide" },
    { "type": "paragraph", "content": "Shown when no Testimonial blocks are added. Pipe-separated (|), in matching order." },
    { "type": "textarea", "id": "default_quotes", "label": "Default quotes", "default": "The marble portrait we commissioned exceeded every expectation — the shading and detail are breathtaking in person.|Arrived beautifully crated and packed. It's the centerpiece of our entryway and guests always ask about it.|Worked with the studio on a custom size for our kitchen backsplash. Flawless craftsmanship and it feels timeless.|Third piece from iMosaicArt and the quality is always consistent. The colors are so much richer in real life.|Shipped to Australia without a single tile out of place. Truly a heirloom-quality artwork.|The religious mosaic we ordered brings the whole scene to life. Handcrafted quality you can genuinely feel." },
    { "type": "textarea", "id": "default_names", "label": "Default names", "default": "Sarah Whitfield|Marcus Delaney|Elena Rossi|David Bennett|Priya Anand|James Mitchell" },
    { "type": "textarea", "id": "default_places", "label": "Default places", "default": "Austin, TX|Chicago, IL|Toronto, Canada|London, UK|Sydney, Australia|Boston, MA" },
    { "type": "textarea", "id": "default_avatars", "label": "Default avatars (URLs or asset filenames)", "default": "https://randomuser.me/api/portraits/women/65.jpg|https://randomuser.me/api/portraits/men/32.jpg|https://randomuser.me/api/portraits/women/44.jpg|https://randomuser.me/api/portraits/men/51.jpg|https://randomuser.me/api/portraits/women/26.jpg|https://randomuser.me/api/portraits/men/76.jpg" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Absolutely love my mosaic! The details and craftsmanship are truly outstanding." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar (upload)" },
        { "type": "text", "id": "avatar_file", "label": "Bundled avatar filename" },
        { "type": "text", "id": "name", "label": "Name", "default": "Anita Miller" },
        { "type": "text", "id": "place", "label": "Place", "default": "United States" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Absolutely love my mosaic! The details and craftsmanship are truly outstanding.", "avatar_file": "rev-anita.png", "name": "Anita Miller", "place": "United States" } },
