<section class="faq page-width">
  <div class="faq__head">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
  </div>
  <div class="faq__list">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="faq-item" data-accordion {{ block.shopify_attributes }}>
          <button type="button" class="faq-item__head" data-accordion-toggle>
            <h3 class="faq-item__q">{{ block.settings.question }}</h3>
            <span class="faq-item__icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-item__body"><p class="faq-item__a">{{ block.settings.answer }}</p></div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- assign fq = section.settings.default_questions | split: '|' -%}
      {%- assign fa = section.settings.default_answers | split: '|' -%}
      {%- for q in fq -%}
        <div class="faq-item" data-accordion>
          <button type="button" class="faq-item__head" data-accordion-toggle>
            <h3 class="faq-item__q">{{ q | strip }}</h3>
            <span class="faq-item__icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-item__body"><p class="faq-item__a">{{ fa[forloop.index0] | strip }}</p></div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="faq__cta">
      <a href="{{ section.settings.button_link | default: '/pages/faq' }}" class="btn btn--ghost">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}
</section>

<style>
  .faq { padding-top: 90px; padding-bottom: 30px; max-width: 820px; }
  .faq__head { text-align: center; margin-bottom: 40px; }
  .faq-item { border-top: 1px solid var(--color-line); }
  .faq-item__head { width: 100%; display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; padding: 24px 2px; cursor: pointer; background: none; border: none; text-align: left; }
  .faq-item__q { font-family: var(--font-display); font-weight: 500; font-size: 23px; line-height: 1.25; color: var(--color-navy); }
  .faq-item__icon { flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 2px; transition: all .3s ease; background: transparent; color: var(--color-navy); border: 1px solid rgba(22,51,94,.3); }
  .faq-item[data-open] .faq-item__icon { transform: rotate(45deg); background: var(--color-blue); color: #fff; border-color: var(--color-blue); }
  .faq-item__body { overflow: hidden; max-height: 0; opacity: 0; transition: max-height .4s ease, opacity .3s ease; }
  .faq-item[data-open] .faq-item__body { max-height: 320px; opacity: 1; }
  .faq-item__a { font-size: 15px; line-height: 1.75; color: var(--color-text-muted); padding: 0 44px 24px 2px; }
  .faq__cta { text-align: center; margin-top: 44px; }
</style>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to Know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All FAQs" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "paragraph", "content": "Shown when no Question blocks are added. Pipe-separated (|), in matching order." },
    { "type": "textarea", "id": "default_questions", "label": "Default questions", "default": "Are your mosaics weatherproof and waterproof?|What is the production and shipping time?|Can I order a custom size or design?" },
    { "type": "textarea", "id": "default_answers", "label": "Default answers", "default": "Yes — every mosaic is fully weatherproof and waterproof, made from durable natural stone and glass. They're suitable for both indoor and outdoor spaces, including bathrooms, pools and patios.|Each mosaic is handcrafted to order with a 4–5 week handling time, then transit typically takes around 10 days, shipped free worldwide with full tracking.|Absolutely. Use the Request a Custom Quote form to share your dimensions or your own image, and our artisans will hand-cut a one-of-a-kind piece tailored to your space." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Are your mosaics weatherproof and waterproof?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Yes — every mosaic is fully weatherproof and waterproof, made from durable natural stone and glass. They're suitable for indoor and outdoor spaces, including pools, bathrooms and kitchens." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Are your mosaics weatherproof and waterproof?", "answer": "Yes — every mosaic is fully weatherproof and waterproof, made from durable natural stone and glass. They're suitable for indoor and outdoor spaces, including pools, bathrooms and kitchens." } },
        { "type": "faq", "settings": { "question": "What is the production and shipping time?", "answer": "Each mosaic is handcrafted to order with a 4–5 week handling time, then transit typically takes around 10 days, shipped free worldwide with full tracking." } },
        { "type": "faq", "settings": { "question": "Can I order a custom size or design?", "answer": "Absolutely. Use the Request a Quote form to share your dimensions or your own image, and our artisans will hand-cut a one-of-a-kind piece tailored to your space." } }
      ]
    }
  ]
}
{% endschema %}
