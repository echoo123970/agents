<section class="instagram">
  <div class="page-width instagram__head">
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.handle != blank -%}
      <a href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/i.mosaicart/' }}" target="_blank" rel="noopener" class="instagram__handle nav-link">{{ section.settings.handle }}</a>
    {%- endif -%}
  </div>
  <div class="instagram__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: settings.social_instagram_link | default: '#' }}" target="_blank" rel="noopener" class="ig-tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="" width="400" height="400" class="cover-img" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'cover-img' }}
          {%- endif -%}
          <span class="ig-overlay"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="#fff" stroke="none"/></svg></span>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- assign ig_link = settings.social_instagram_link | default: 'https://www.instagram.com/i.mosaicart/' -%}
      {%- assign ig_files = 'https://www.imosaicart.com/cdn/shop/files/515501868_615409964937269_775212130695605232_n.jpg?width=400~https://www.imosaicart.com/cdn/shop/files/514882040_615540671590865_3345350083595333582_n.jpg?width=400~https://www.imosaicart.com/cdn/shop/files/516852109_615515628260036_3096541827106973933_n.jpg?width=400~https://www.imosaicart.com/cdn/shop/files/514400651_615567438254855_8814883425095282072_n.jpg?width=400~https://www.imosaicart.com/cdn/shop/files/514401429_615555868256012_7277352567540283300_n.jpg?width=400~https://www.imosaicart.com/cdn/shop/files/514411828_615527788258820_7592897271738552265_n.jpg?width=400~https://www.imosaicart.com/cdn/shop/files/MAS081_b2d557a7-36fa-418b-b736-ec6f27f75af3.jpg?width=400~https://www.imosaicart.com/cdn/shop/files/MAT053_-_60cm_x_85cm_8343d742-e897-4c91-b648-f7480e0e8ee5.jpg?width=400~https://www.imosaicart.com/cdn/shop/files/MAA034_55b3da2e-eb16-4125-9de5-fcd9a5899e57.jpg?width=400~nautical-sunset.jpg~flower-vase.jpg~bird-peacock.jpg~portrait-pearl.png~religious-lady-jesus.png~custom-flower-vase-room.jpg~install-hero-tree.png' | split: '~' -%}
      {%- for f in ig_files -%}
        <a href="{{ ig_link }}" target="_blank" rel="noopener" class="ig-tile">
          {%- if f contains '://' -%}
            <img src="{{ f }}" alt="" width="400" height="400" class="cover-img" loading="lazy" referrerpolicy="no-referrer">
          {%- else -%}
            <img src="{{ f | asset_url }}" alt="" width="400" height="400" class="cover-img" loading="lazy">
          {%- endif -%}
          <span class="ig-overlay"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="#fff" stroke="none"/></svg></span>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  .instagram { padding-bottom: 28px; }
  .instagram__head { padding-bottom: 30px; text-align: center; }
  .instagram__head .section-title { margin-bottom: 14px; }
  .instagram__handle { display: inline-block; font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-navy); }
  .instagram__grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; }
  .ig-tile { position: relative; display: block; aspect-ratio: 1/1; overflow: hidden; background: var(--color-light-text); }
  .ig-tile .cover-img { transition: transform .5s ease; }
  .ig-tile:hover .cover-img { transform: scale(1.06); }
  .ig-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(11,28,53,.42); opacity: 0; transition: opacity .3s ease; }
  .ig-tile:hover .ig-overlay { opacity: 1; }
  @media (max-width: 990px) { .instagram__grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 600px) { .instagram__grid { grid-template-columns: repeat(3, 1fr); } }
</style>

{% schema %}
{
  "name": "Instagram grid",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow The Mosaic Studio" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@i.mosaicart" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Post link" }
      ]
    }
  ],
  "presets": [{ "name": "Instagram grid" }]
}
{% endschema %}
