{%- if section.settings.enable -%}
  {%- assign wa_raw = section.settings.whatsapp_number | default: '13152175538' | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+' -%}
  {%- if wa_raw == blank -%}{%- assign wa_raw = '13152175538' -%}{%- endif -%}
  {%- assign wa_msg = section.settings.whatsapp_message | url_encode -%}
  <a href="https://wa.me/{{ wa_raw }}{% if wa_msg != blank %}?text={{ wa_msg }}{% endif %}" target="_blank" rel="noopener noreferrer" class="fab-wa" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/></svg>
  </a>

  <style>
    .fab-wa {
      position: fixed; left: 26px; bottom: 26px; z-index: 60;
      width: 60px; height: 60px; border-radius: 50%;
      background: #25D366; color: #fff; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 12px 30px rgba(37,211,102,.4);
      transition: transform .3s ease, background .3s ease, box-shadow .3s ease;
    }
    .fab-wa:hover { background: #1EBE5D; transform: translateY(-2px); box-shadow: 0 16px 38px rgba(37,211,102,.5); }
    .fab-wa svg { width: 34px; height: 34px; }
    @media (max-width: 600px) {
      .fab-wa { left: 16px; bottom: 16px; width: 54px; height: 54px; }
      .fab-wa svg { width: 30px; height: 30px; }
    }
    @media (prefers-reduced-motion: reduce) { .fab-wa { transition: none; } }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Floating WhatsApp",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Show WhatsApp button", "default": true },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (with country code)", "default": "13152175538", "info": "Digits only, including country code. e.g. 13152175538" },
    { "type": "textarea", "id": "whatsapp_message", "label": "Pre-filled message", "default": "Hi iMosaicArt! I have a question about your mosaics." }
  ],
  "presets": [{ "name": "Floating WhatsApp" }]
}
{% endschema %}
