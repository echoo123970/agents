{%- if section.settings.enable -%}
  {%- assign wa_raw = section.settings.whatsapp_number | default: '13152175538' | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '+' -%}
  {%- if wa_raw == blank -%}{%- assign wa_raw = '13152175538' -%}{%- endif -%}
  {%- assign wa_msg = section.settings.whatsapp_message | url_encode -%}
  <div class="fab" data-fab>

    {%- comment -%} Subscribe popover {%- endcomment -%}
    {%- if section.settings.show_subscribe -%}
      <div class="fab-sub" data-fab-sub hidden>
        <button type="button" class="fab-sub__x" data-fab-sub-close aria-label="Close">&times;</button>
        {%- form 'customer', class: 'fab-sub__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, floating-widget">
          {%- if form.posted_successfully or form.errors -%}<span data-fab-posted hidden></span>{%- endif -%}
          {%- if form.posted_successfully -%}
            <div class="fab-sub__done">
              <div class="fab-sub__done-ic">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="fab-sub__title">{{ section.settings.subscribe_success | default: 'You’re on the list.' }}</div>
              <p class="fab-sub__text">Thank you — watch your inbox for new mosaics &amp; offers.</p>
            </div>
          {%- else -%}
            <div class="fab-sub__title">{{ section.settings.subscribe_heading }}</div>
            <p class="fab-sub__text">{{ section.settings.subscribe_text }}</p>
            {%- if form.errors -%}
              <p class="fab-sub__err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            <div class="fab-sub__row">
              <input type="email" name="contact[email]" required placeholder="you@email.com" class="fab-sub__input" aria-label="Email address">
              <button type="submit" class="fab-sub__btn" aria-label="Subscribe">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- comment -%} Action stack {%- endcomment -%}
    <div class="fab-menu" data-fab-menu>
      {%- if section.settings.show_back_to_top -%}
        <button type="button" class="fab-item fab-item--top" data-fab-top>
          <span class="fab-item__label">Back to top</span>
          <span class="fab-item__ic">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
          </span>
        </button>
      {%- endif -%}

      {%- if section.settings.show_subscribe -%}
        <button type="button" class="fab-item fab-item--sub" data-fab-sub-toggle aria-expanded="false">
          <span class="fab-item__label">Subscribe</span>
          <span class="fab-item__ic">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
          </span>
        </button>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <button type="button" class="fab-item fab-item--search" data-search-toggle data-fab-close>
          <span class="fab-item__label">Search</span>
          <span class="fab-item__ic">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
          </span>
        </button>
      {%- endif -%}

      {%- if section.settings.show_chat and wa_raw != blank -%}
        <a href="https://wa.me/{{ wa_raw }}{% if wa_msg != blank %}?text={{ wa_msg }}{% endif %}" target="_blank" rel="noopener noreferrer" class="fab-item fab-item--chat" data-fab-close>
          <span class="fab-item__label">WhatsApp</span>
          <span class="fab-item__ic">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35zM12 2a10 10 0 0 0-8.6 15.05L2 22l5.05-1.32A10 10 0 1 0 12 2z"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Main trigger {%- endcomment -%}
    <button type="button" class="fab-main" data-fab-toggle aria-expanded="false" aria-label="Help &amp; quick actions">
      <span class="fab-main__ic fab-main__ic--open">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"><path d="M12 2a10 10 0 0 0-8.6 15.05L2 22l5.05-1.32A10 10 0 1 0 12 2zm5.5 12.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z"/></svg>
      </span>
      <span class="fab-main__ic fab-main__ic--close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </span>
    </button>
  </div>

  <style>
    .fab { position: fixed; right: 26px; bottom: 26px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; }
    .fab-main {
      width: 60px; height: 60px; border-radius: 50%; border: none; cursor: pointer;
      background: #25D366; color: #fff; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 12px 30px rgba(37,211,102,.4); position: relative;
      transition: transform .3s ease, background .3s ease, box-shadow .3s ease;
    }
    .fab-main:hover { background: #1EBE5D; transform: translateY(-2px); box-shadow: 0 16px 38px rgba(37,211,102,.5); }
    .fab-main__ic { position: absolute; display: flex; transition: opacity .25s ease, transform .3s ease; }
    .fab-main__ic--close { opacity: 0; transform: rotate(-45deg) scale(.6); }
    .fab[data-open] .fab-main__ic--open { opacity: 0; transform: rotate(45deg) scale(.6); }
    .fab[data-open] .fab-main__ic--close { opacity: 1; transform: rotate(0) scale(1); }
    .fab[data-open] .fab-main { background: #1EBE5D; }

    .fab-menu { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; margin-bottom: 16px; }
    .fab-item {
      display: inline-flex; align-items: center; gap: 12px; border: none; cursor: pointer;
      background: transparent; padding: 0; text-decoration: none;
      opacity: 0; transform: translateY(12px) scale(.9); pointer-events: none;
      transition: opacity .28s ease, transform .28s ease;
    }
    .fab[data-open] .fab-item { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
    .fab[data-open] .fab-item:nth-child(1) { transition-delay: .02s; }
    .fab[data-open] .fab-item:nth-child(2) { transition-delay: .06s; }
    .fab[data-open] .fab-item:nth-child(3) { transition-delay: .10s; }
    .fab[data-open] .fab-item:nth-child(4) { transition-delay: .14s; }
    .fab-item__label {
      background: #fff; color: var(--color-navy); font-family: var(--font-body); font-size: 13px; font-weight: 600;
      letter-spacing: .01em; padding: 8px 14px; border-radius: 8px; white-space: nowrap;
      box-shadow: 0 6px 18px rgba(16,42,79,.16); border: 1px solid rgba(22,51,94,.06);
    }
    .fab-item__ic {
      width: 46px; height: 46px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
      background: #fff; color: var(--color-navy); box-shadow: 0 8px 22px rgba(16,42,79,.22);
      transition: transform .2s ease, background .2s ease, color .2s ease;
    }
    .fab-item:hover .fab-item__ic { transform: scale(1.08); }
    .fab-item--chat .fab-item__ic { background: #25D366; color: #fff; }
    .fab-item--search:hover .fab-item__ic { background: var(--color-navy); color: #fff; }
    .fab-item--sub:hover .fab-item__ic { background: var(--color-blue); color: #fff; }
    .fab-item--top:hover .fab-item__ic { background: var(--color-navy); color: #fff; }

    /* Subscribe popover */
    .fab-sub {
      position: absolute; right: 0; bottom: 76px; width: 300px; max-width: calc(100vw - 40px);
      background: #fff; border-radius: 14px; padding: 22px; box-shadow: 0 24px 60px rgba(16,42,79,.28);
      border: 1px solid rgba(22,51,94,.08);
    }
    .fab-sub[hidden] { display: none; }
    .fab-sub__x { position: absolute; top: 8px; right: 12px; background: none; border: none; font-size: 24px; line-height: 1; color: var(--color-text-faint); cursor: pointer; }
    .fab-sub__x:hover { color: var(--color-navy); }
    .fab-sub__title { font-family: var(--font-display); font-weight: 500; font-size: 23px; line-height: 1.15; color: var(--color-navy); margin-bottom: 6px; padding-right: 16px; }
    .fab-sub__text { font-size: 13.5px; line-height: 1.55; color: var(--color-text-muted); margin-bottom: 16px; }
    .fab-sub__row { display: flex; border: 1px solid rgba(22,51,94,.18); border-radius: 9px; overflow: hidden; }
    .fab-sub__input { flex: 1; min-width: 0; border: none; outline: none; font-family: var(--font-body); font-size: 14px; padding: 12px 14px; color: var(--color-navy); }
    .fab-sub__btn { flex-shrink: 0; width: 46px; border: none; background: var(--color-blue); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .2s ease; }
    .fab-sub__btn:hover { background: var(--color-navy); }
    .fab-sub__err { font-size: 12.5px; color: #C0392B; margin-bottom: 10px; }
    .fab-sub__done { text-align: center; padding: 6px 0; }
    .fab-sub__done-ic { width: 54px; height: 54px; border-radius: 50%; background: var(--color-panel); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }

    @media (max-width: 750px) {
      .fab { right: 16px; bottom: 16px; }
      .fab-main { width: 54px; height: 54px; }
      .fab-item__ic { width: 42px; height: 42px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .fab-main, .fab-main__ic, .fab-item { transition: none; }
    }
  </style>

  <script>
    (function () {
      var root = document.querySelector('[data-fab]');
      if (!root) return;
      var toggle = root.querySelector('[data-fab-toggle]');
      var sub = root.querySelector('[data-fab-sub]');
      var subToggle = root.querySelector('[data-fab-sub-toggle]');

      function openMenu() { root.setAttribute('data-open', ''); if (toggle) toggle.setAttribute('aria-expanded', 'true'); }
      function closeMenu() { root.removeAttribute('data-open'); if (toggle) toggle.setAttribute('aria-expanded', 'false'); closeSub(); }
      function openSub() { if (sub) { sub.hidden = false; if (subToggle) subToggle.setAttribute('aria-expanded', 'true'); var i = sub.querySelector('input[type=email]'); if (i) setTimeout(function () { i.focus(); }, 40); } }
      function closeSub() { if (sub) { sub.hidden = true; if (subToggle) subToggle.setAttribute('aria-expanded', 'false'); } }

      if (toggle) toggle.addEventListener('click', function () {
        if (root.hasAttribute('data-open')) closeMenu(); else openMenu();
      });

      if (subToggle) subToggle.addEventListener('click', function () {
        if (sub && sub.hidden) openSub(); else closeSub();
      });
      var subClose = root.querySelector('[data-fab-sub-close]');
      if (subClose) subClose.addEventListener('click', closeSub);

      var topBtn = root.querySelector('[data-fab-top]');
      if (topBtn) topBtn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        closeMenu();
      });

      // actions that navigate away / open another overlay should collapse the menu
      root.querySelectorAll('[data-fab-close]').forEach(function (el) {
        el.addEventListener('click', function () { setTimeout(closeMenu, 10); });
      });

      // close when clicking outside
      document.addEventListener('click', function (e) {
        if (!root.contains(e.target) && root.hasAttribute('data-open')) closeMenu();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { if (sub && !sub.hidden) { closeSub(); } else if (root.hasAttribute('data-open')) { closeMenu(); } }
      });

      // re-open after a subscribe submit (form reloads the page)
      if (root.querySelector('[data-fab-posted]')) { openMenu(); openSub(); }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Floating actions",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable floating action button", "default": true },
    { "type": "header", "content": "Chat (WhatsApp)" },
    { "type": "checkbox", "id": "show_chat", "label": "Show chat button", "default": true },
    { "type": "text", "id": "chat_label", "label": "Chat label", "default": "WhatsApp" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (with country code)", "default": "13152175538", "info": "Digits only, including country code. e.g. 13152175538" },
    { "type": "textarea", "id": "whatsapp_message", "label": "Pre-filled message", "default": "Hi iMosaicArt! I have a question about your mosaics." },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show search button", "default": true },
    { "type": "header", "content": "Subscribe" },
    { "type": "checkbox", "id": "show_subscribe", "label": "Show subscribe button", "default": true },
    { "type": "text", "id": "subscribe_heading", "label": "Subscribe heading", "default": "Join the studio list" },
    { "type": "textarea", "id": "subscribe_text", "label": "Subscribe text", "default": "Be first to see new mosaics, stories and private offers." },
    { "type": "text", "id": "subscribe_success", "label": "Success message", "default": "You’re on the list." },
    { "type": "header", "content": "Back to top" },
    { "type": "checkbox", "id": "show_back_to_top", "label": "Show back-to-top button", "default": true }
  ]
}
{% endschema %}
