<style>
  .pdp { padding-top: 24px; padding-bottom: 90px; }
  .pdp__crumb { display: flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-soft); padding-bottom: 24px; flex-wrap: wrap; }
  .pdp__crumb-sep { color: #B7C0D2; }
  .pdp__crumb-current { color: var(--color-navy); }
  .pdp__grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 60px; align-items: start; }

  .pdp-stage { position: relative; overflow: hidden; background: var(--color-light-text); aspect-ratio: 4/5; cursor: zoom-in; }
  .pdp-main { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .pdp-stage:hover .pdp-main { transform: scale(1.6); }
  .pdp-stage__badge { position: absolute; top: 16px; left: 16px; background: rgba(255,255,255,.92); color: var(--color-navy); font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; padding: 7px 12px; display: flex; align-items: center; gap: 7px; }
  .pdp__thumbs { display: flex; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .pdp__thumb { width: 84px; aspect-ratio: 4/5; overflow: hidden; border: 1px solid transparent; background: var(--color-light-text); padding: 0; cursor: pointer; }
  .pdp__thumb.is-active { border-color: var(--color-blue); }
  .pdp__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .pdp__accordion { margin-top: 36px; }
  .pdp-acc { border-top: 1px solid var(--color-line); }
  .pdp-acc__head { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 20px 2px; cursor: pointer; background: none; border: none; text-align: left; }
  .pdp-acc__title { font-family: var(--font-accent); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-navy); }
  .pdp-acc__icon { font-size: 20px; line-height: 1; color: var(--color-blue); transition: transform .3s ease; }
  .pdp-acc[data-open] .pdp-acc__icon { transform: rotate(45deg); }
  .pdp-acc__body { overflow: hidden; max-height: 0; opacity: 0; transition: max-height .4s ease, opacity .3s ease; }
  .pdp-acc[data-open] .pdp-acc__body { max-height: 600px; opacity: 1; }
  .pdp-acc__body-inner { font-size: 15px; line-height: 1.75; color: var(--color-text-muted); padding: 0 2px 22px; }

  .pdp__info { position: sticky; top: 100px; }
  .pdp__meta { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .pdp__type { font-family: var(--font-accent); font-size: 12px; letter-spacing: .26em; text-transform: uppercase; color: var(--color-blue); }
  .pdp__dot { width: 4px; height: 4px; border-radius: 50%; background: #C4CDDC; }
  .pdp__sku { font-size: 12px; letter-spacing: .08em; color: var(--color-text-faint); }
  .pdp__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.08; letter-spacing: -.01em; margin-bottom: 16px; color: var(--color-navy); }
  .pdp__rating { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
  .pdp__stars { color: var(--color-blue); letter-spacing: 2px; font-size: 14px; }
  .pdp__rating-text { font-size: 13.5px; color: var(--color-text-soft); }
  .pdp__price-row { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; }
  .pdp__price { font-family: var(--font-display); font-size: 40px; line-height: 1; color: var(--color-navy); }
  .pdp__size-label { font-size: 13px; color: var(--color-text-soft); }
  .pdp__status { font-size: 13px; color: #1F8A5B; margin-bottom: 28px; display: flex; align-items: center; gap: 7px; }
  .pdp__status-dot { width: 7px; height: 7px; border-radius: 50%; background: #1F8A5B; }
  .pdp__quote-banner { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--color-panel); border: 1px solid rgba(43,123,232,.25); padding: 14px 18px; margin-bottom: 24px; transition: all .2s ease; }
  .pdp__quote-banner:hover { border-color: var(--color-blue); background: #E6EEFA; }
  .pdp__quote-banner-text { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--color-navy); }
  .pdp__quote-banner-cta { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-blue); font-weight: 600; white-space: nowrap; }

  .pdp__sizes { margin-bottom: 26px; }
  .pdp__sizes-label { font-family: var(--font-accent); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-navy); margin-bottom: 13px; }
  .pdp__sizes-list { display: flex; flex-direction: column; gap: 9px; }
  .size-btn { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 20px; cursor: pointer; font-family: var(--font-body); text-align: left; transition: all .2s ease; background: #fff; color: var(--color-navy); border: 1px solid rgba(22,51,94,.18); }
  .size-btn.is-active { background: var(--color-navy); color: #fff; border-color: var(--color-navy); }
  .size-btn.is-unavailable { opacity: .45; }
  .size-btn__name { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
  .size-btn__cm { font-size: 14.5px; font-weight: 600; }
  .size-btn__inch { font-size: 12px; opacity: .7; }
  .size-btn__price { font-family: var(--font-display); font-size: 22px; }

  .pdp__buy { display: flex; gap: 14px; margin-bottom: 18px; }
  .pdp__qty { display: flex; align-items: center; border: 1px solid rgba(22,51,94,.2); }
  .pdp__qty-btn { width: 46px; height: 54px; background: transparent; border: none; cursor: pointer; color: var(--color-navy); font-size: 20px; transition: background .2s ease; }
  .pdp__qty-btn:hover { background: var(--color-panel); }
  .pdp__qty-input { width: 44px; text-align: center; font-size: 15px; color: var(--color-navy); border: none; outline: none; -moz-appearance: textfield; }
  .pdp__qty-input::-webkit-outer-spin-button, .pdp__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pdp__add { flex: 1; border: none; cursor: pointer; font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; padding: 0 28px; transition: background .25s ease; background: var(--color-blue); color: #fff; }
  .pdp__add:hover { background: #1E63C4; }
  .pdp__add[disabled] { background: var(--color-text-faint); cursor: not-allowed; }
  .pdp__add.is-added { background: #1F8A5B; }

  .pdp__wish { width: 100%; background: transparent; border: 1px solid rgba(22,51,94,.25); color: var(--color-navy); font-family: var(--font-body); font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; padding: 15px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 28px; transition: all .2s ease; }
  .pdp__wish:hover { border-color: var(--color-blue); color: var(--color-blue); }
  .pdp__wish.is-saved svg { fill: var(--color-blue); }

  .pdp__trust { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 22px; padding: 24px 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); margin-bottom: 26px; }
  .pdp__trust-item { display: flex; align-items: center; gap: 12px; }
  .pdp__trust-icon { flex-shrink: 0; color: var(--color-blue); display: flex; }
  .pdp__trust-icon svg { width: 20px; height: 20px; }
  .pdp__trust-label { font-size: 13.5px; line-height: 1.4; color: #46546E; }

  .pdp__pay { display: flex; align-items: center; gap: 12px; margin-bottom: 30px; flex-wrap: wrap; }
  .pdp__pay-label { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-text-faint); }
  .pdp__pay-icons { display: flex; gap: 7px; flex-wrap: wrap; }
  .pdp__pay-icon { height: 24px; width: auto; }

  /* Finishing / framing add-on options */
  .pdp__addons { display: flex; flex-direction: column; gap: 10px; margin-bottom: 26px; }
  .pdp__addons-label { font-family: var(--font-accent); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-navy); margin-bottom: 3px; }
  .pdp__addons-opt { color: var(--color-text-faint); }
  .pdp-opt { position: relative; display: flex; align-items: flex-start; gap: 14px; padding: 16px 18px; background: #fff; border: 1px solid rgba(22,51,94,.18); cursor: pointer; transition: border-color .2s ease, background .2s ease, box-shadow .2s ease; }
  .pdp-opt:hover { border-color: rgba(43,123,232,.55); }
  .pdp-opt.is-on { background: #F4F8FE; border-color: var(--color-blue); box-shadow: inset 0 0 0 1px var(--color-blue); }
  .pdp-opt__check { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .pdp-opt__tick { flex-shrink: 0; width: 22px; height: 22px; margin-top: 1px; border: 1.5px solid rgba(22,51,94,.3); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; transition: background .2s ease, border-color .2s ease; }
  .pdp-opt__tick svg { width: 13px; height: 13px; opacity: 0; transition: opacity .15s ease; }
  .pdp-opt.is-on .pdp-opt__tick { background: var(--color-blue); border-color: var(--color-blue); }
  .pdp-opt.is-on .pdp-opt__tick svg { opacity: 1; }
  .pdp-opt__body { flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .pdp-opt__title { font-size: 15px; font-weight: 600; color: var(--color-navy); }
  .pdp-opt__desc { font-size: 13px; line-height: 1.5; color: var(--color-text-muted); }
  .pdp-opt__flag { flex-shrink: 0; align-self: flex-start; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-text-soft); background: var(--color-panel); padding: 4px 9px; }
  .pdp-opt--frame { flex-direction: column; align-items: stretch; gap: 0; padding: 0; }
  .pdp-opt--frame .pdp-opt__main { display: flex; align-items: flex-start; gap: 14px; padding: 16px 18px; cursor: pointer; }
  .pdp-opt__contact { display: flex; align-items: center; gap: 9px; padding: 13px 18px; border-top: 1px dashed rgba(43,123,232,.45); background: #EEF4FD; color: var(--color-blue); font-size: 12.5px; font-weight: 600; letter-spacing: .03em; transition: background .2s ease; }
  .pdp-opt__contact:hover { background: #E2ECFB; }
  .pdp-opt__contact-arrow { margin-left: auto; }

  @media (max-width: 990px) {
    .pdp__grid { grid-template-columns: 1fr; gap: 36px; }
    .pdp__info { position: static; }
  }

</style>

<section class="pdp page-width" data-product>
  <!-- BREADCRUMB -->
  <nav class="pdp__crumb">
    <a href="{{ routes.root_url }}" class="nav-link">Home</a>
    <span class="pdp__crumb-sep">/</span>
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}" class="nav-link">{{ product.collections.first.title }}</a>
      <span class="pdp__crumb-sep">/</span>
    {%- endif -%}
    <span class="pdp__crumb-current">{{ product.title }}</span>
  </nav>

  <div class="pdp__grid">
    <!-- GALLERY -->
    <div class="pdp__gallery">
      <div class="pdp-stage" data-zoom-stage>
        {%- if product.featured_media -%}
          <img src="{{ product.featured_media | image_url: width: 1100 }}" alt="{{ product.title | escape }}" width="1100" height="1375" class="pdp-main" id="PdpMainImage">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pdp-main' }}
        {%- endif -%}
        <span class="pdp-stage__badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          Hover to Zoom
        </span>
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp__thumbs">
          {%- for media in product.media limit: 8 -%}
            <button type="button" class="pdp__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ media | image_url: width: 1100 }}">
              <img src="{{ media | image_url: width: 200 }}" alt="" width="84" height="105" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- ACCORDION -->
      <div class="pdp__accordion">
        {%- if product.description != blank -%}
          <div class="pdp-acc" data-accordion data-open>
            <button type="button" class="pdp-acc__head" data-accordion-toggle>
              <span class="pdp-acc__title">Description</span>
              <span class="pdp-acc__icon">+</span>
            </button>
            <div class="pdp-acc__body"><div class="pdp-acc__body-inner rte">{{ product.description }}</div></div>
          </div>
        {%- endif -%}
        {%- assign acc_blocks = section.blocks | where: 'type', 'collapsible' -%}
        {%- if acc_blocks.size > 0 -%}
          {%- for block in acc_blocks -%}
            <div class="pdp-acc" data-accordion {% unless product.description != blank %}{% if forloop.first %}data-open{% endif %}{% endunless %} {{ block.shopify_attributes }}>
              <button type="button" class="pdp-acc__head" data-accordion-toggle>
                <span class="pdp-acc__title">{{ block.settings.heading }}</span>
                <span class="pdp-acc__icon">+</span>
              </button>
              <div class="pdp-acc__body"><div class="pdp-acc__body-inner rte">{{ block.settings.content }}</div></div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- assign acc_titles = section.settings.acc_titles | split: '|' -%}
          {%- assign acc_bodies = section.settings.acc_bodies | split: '|' -%}
          {%- for t in acc_titles -%}
            <div class="pdp-acc" data-accordion>
              <button type="button" class="pdp-acc__head" data-accordion-toggle>
                <span class="pdp-acc__title">{{ t | strip }}</span>
                <span class="pdp-acc__icon">+</span>
              </button>
              <div class="pdp-acc__body"><div class="pdp-acc__body-inner rte"><p>{{ acc_bodies[forloop.index0] | strip }}</p></div></div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!-- INFO -->
    <div class="pdp__info">
      <div class="pdp__meta">
        {%- if product.type != blank -%}<span class="pdp__type">{{ product.type }}</span>{%- endif -%}
        {%- if product.selected_or_first_available_variant.sku != blank -%}
          <span class="pdp__dot"></span>
          <span class="pdp__sku">SKU: {{ product.selected_or_first_available_variant.sku }}</span>
        {%- endif -%}
      </div>
      <h1 class="pdp__title">{{ product.title }}</h1>

      {%- if section.settings.show_rating -%}
        <div class="pdp__rating">
          <span class="pdp__stars">★★★★★</span>
          <span class="pdp__rating-text">{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}

      <div class="pdp__price-row">
        <span class="pdp__price" data-price>{{ product.selected_or_first_available_variant.price | money }}</span>
        <span class="pdp__size-label" data-size-label>{{ product.selected_or_first_available_variant.title }}</span>
      </div>
      {%- if section.settings.availability_note != blank -%}
        <p class="pdp__status"><span class="pdp__status-dot"></span>{{ section.settings.availability_note }}</p>
      {%- endif -%}

      {%- if section.settings.show_quote_banner -%}
        <a href="#quote-form" class="pdp__quote-banner">
          <span class="pdp__quote-banner-text">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h13l5 5-9 9-9-9z"/><line x1="7" y1="11" x2="13" y2="17"/></svg>
            {{ section.settings.quote_banner_text }}
          </span>
          <span class="pdp__quote-banner-cta">Request a Quote</span>
        </a>
      {%- endif -%}

      {%- form 'product', product, class: 'pdp__form', id: 'ProductForm' -%}
        {%- unless product.has_only_default_variant -%}
          <div class="pdp__sizes">
            <div class="pdp__sizes-label">{{ section.settings.variant_label | default: 'Select Size' }}</div>
            <div class="pdp__sizes-list" data-variant-picker>
              {%- for variant in product.variants -%}
                <button type="button"
                  class="size-btn{% if variant.id == product.selected_or_first_available_variant.id %} is-active{% endif %}{% unless variant.available %} is-unavailable{% endunless %}"
                  data-variant-id="{{ variant.id }}"
                  data-variant-price="{{ variant.price | money }}"
                  data-variant-title="{{ variant.title | escape }}"
                  {% unless variant.available %}aria-disabled="true"{% endunless %}>
                  {%- assign vparts = variant.title | split: '(' -%}
                  <span class="size-btn__name">
                    <span class="size-btn__cm">{{ vparts[0] | strip }}{% unless variant.available %} — Sold out{% endunless %}</span>
                    {%- if vparts.size > 1 -%}<span class="size-btn__inch">({{ vparts[1] }}</span>{%- endif -%}
                  </span>
                  <span class="size-btn__price">{{ variant.price | money }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endunless -%}

        {%- if section.settings.show_addons -%}
          <div class="pdp__addons">
            <div class="pdp__addons-label">{{ section.settings.addons_label | default: 'Finishing Options' }} <span class="pdp__addons-opt">— optional</span></div>

            <label class="pdp-opt" data-addon>
              <input type="checkbox" class="pdp-opt__check" name="properties[Finish]" value="{{ section.settings.polished_value | default: 'Polished — museum-grade hand-sealed finish' }}">
              <span class="pdp-opt__tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12.5 10 17.5 19 7"/></svg></span>
              <span class="pdp-opt__body">
                <span class="pdp-opt__title">{{ section.settings.polished_title | default: 'Polished Finish' }}</span>
                <span class="pdp-opt__desc">{{ section.settings.polished_desc | default: 'A hand-applied seal that deepens colour and lends a refined, museum-grade sheen.' }}</span>
              </span>
              <span class="pdp-opt__flag">Optional</span>
            </label>

            <div class="pdp-opt pdp-opt--frame" data-addon>
              <label class="pdp-opt__main">
                <input type="checkbox" class="pdp-opt__check" name="properties[Framing]" value="{{ section.settings.frame_value | default: 'Requested — please contact me for a bespoke framing quote' }}" data-frame-check>
                <span class="pdp-opt__tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12.5 10 17.5 19 7"/></svg></span>
                <span class="pdp-opt__body">
                  <span class="pdp-opt__title">{{ section.settings.frame_title | default: 'Add a Handcrafted Frame' }}</span>
                  <span class="pdp-opt__desc">{{ section.settings.frame_desc | default: 'Bespoke framing tailored to your piece. Priced individually — our team will guide you through the options.' }}</span>
                </span>
                <span class="pdp-opt__flag">By request</span>
              </label>
              <a class="pdp-opt__contact" href="{{ section.settings.frame_contact_url | default: '/pages/contact-us' }}" data-frame-contact hidden>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v13H7l-3 3z"/></svg>
                {{ section.settings.frame_contact_label | default: 'Contact us about framing' }}
                <span class="pdp-opt__contact-arrow">→</span>
              </a>
            </div>
          </div>
        {%- endif -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-input>

        <div class="pdp__buy">
          <div class="pdp__qty">
            <button type="button" class="pdp__qty-btn" data-qty-dec aria-label="Decrease">−</button>
            <input type="number" name="quantity" value="1" min="1" class="pdp__qty-input" data-qty-input aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" class="pdp__qty-btn" data-qty-inc aria-label="Increase">+</button>
          </div>
          <button type="submit" name="add" class="pdp__add" data-add-btn {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <button type="button" class="pdp__wish" data-wishlist data-product-handle="{{ product.handle }}" data-wish-title="{{ product.title | escape }}" data-wish-url="{{ product.url }}" data-wish-image="{% if product.featured_media %}{{ product.featured_media | image_url: width: 600 }}{% endif %}" data-wish-price="{% if product.price_varies %}From {{ product.price_min | money }}{% else %}{{ product.price | money }}{% endif %}" data-wish-sub="{{ product.type | default: product.vendor | escape }}">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
        <span data-wishlist-label>Add to Wishlist</span>
      </button>

      <div class="pdp__trust">
        {%- assign trust_labels = section.settings.trust_labels | split: '|' -%}
        {%- for lbl in trust_labels -%}
          <div class="pdp__trust-item">
            <span class="pdp__trust-icon">
              {%- case forloop.index -%}
                {%- when 1 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19"/><path d="M12 2.5c2.7 2.6 4.2 5.9 4.2 9.5s-1.5 6.9-4.2 9.5c-2.7-2.6-4.2-5.9-4.2-9.5s1.5-6.9 4.2-9.5z"/></svg>
                {%- when 2 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 12a8.5 8.5 0 1 1-2.4-5.9"/><path d="M20.7 3.6V9.1H15.2"/></svg>
                {%- when 3 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l8 3v5.5c0 5-3.4 8.6-8 10.5-4.6-1.9-8-5.5-8-10.5V5.5z"/><path d="M9 12l2 2 4-4.5"/></svg>
                {%- when 4 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1-.6-1.4V4a1.5 1.5 0 0 1 1.5-1.5h8a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8z"/><circle cx="7.6" cy="7.6" r="1.3" fill="currentColor" stroke="none"/></svg>
              {%- endcase -%}
            </span>
            <span class="pdp__trust-label">{{ lbl | strip }}</span>
          </div>
        {%- endfor -%}
      </div>

      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="pdp__pay">
          <span class="pdp__pay-label">Secure payment</span>
          <div class="pdp__pay-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'pdp__pay-icon' }}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Handcrafted reproduction · 4.9 (38 reviews)" },
    { "type": "text", "id": "availability_note", "label": "Availability note", "default": "Made to order · ships free worldwide" },
    { "type": "text", "id": "variant_label", "label": "Variant selector label", "default": "Select Size" },
    { "type": "checkbox", "id": "show_quote_banner", "label": "Show custom-quote banner", "default": true },
    { "type": "text", "id": "quote_banner_text", "label": "Quote banner text", "default": "Want a custom size or subject?" },
    { "type": "header", "content": "Finishing & framing options" },
    { "type": "checkbox", "id": "show_addons", "label": "Show finishing / framing options", "default": true },
    { "type": "text", "id": "addons_label", "label": "Section label", "default": "Finishing Options" },
    { "type": "text", "id": "polished_title", "label": "Polished option title", "default": "Polished Finish" },
    { "type": "text", "id": "polished_desc", "label": "Polished option description", "default": "A hand-applied seal that deepens colour and lends a refined, museum-grade sheen." },
    { "type": "text", "id": "polished_value", "label": "Polished order note (recorded on order)", "default": "Polished — museum-grade hand-sealed finish" },
    { "type": "text", "id": "frame_title", "label": "Frame option title", "default": "Add a Handcrafted Frame" },
    { "type": "text", "id": "frame_desc", "label": "Frame option description", "default": "Bespoke framing tailored to your piece. Priced individually — our team will guide you through the options." },
    { "type": "text", "id": "frame_value", "label": "Frame order note (recorded on order)", "default": "Requested — please contact me for a bespoke framing quote" },
    { "type": "url", "id": "frame_contact_url", "label": "Frame contact link", "info": "Where the 'Contact us about framing' button points (e.g. contact page)." },
    { "type": "text", "id": "frame_contact_label", "label": "Frame contact button text", "default": "Contact us about framing" },
    { "type": "header", "content": "Accordion rows (shown under the gallery)" },
    { "type": "textarea", "id": "acc_titles", "label": "Row titles (pipe-separated)", "default": "Materials & Craft|Shipping & Returns" },
    { "type": "textarea", "id": "acc_bodies", "label": "Row bodies (pipe-separated)", "default": "Hand-cut from natural stone and glass tesserae, assembled tile by tile by master artisans and mounted on a fiber-mesh backing for easy installation. Each piece is unique — slight variation in colour and texture is part of its handmade character.|Made to order with a 4–5 week handling time, then shipped free worldwide with full tracking. Covered by our 14-day returns policy and lifetime warranty." },
    { "type": "header", "content": "Trust row" },
    { "type": "textarea", "id": "trust_labels", "label": "Trust labels (pipe-separated, up to 4)", "default": "Free worldwide shipping|14-day returns policy|Lifetime warranty|Hand-cut by master artisans" }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Materials & Craft" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Hand-cut from natural stone and glass tesserae, assembled tile by tile by master artisans.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Product" }
  ]
}
{% endschema %}
