{%- assign caps = section.blocks | where: 'type', 'capability' -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- assign points = section.blocks | where: 'type', 'point' -%}

<!-- HERO -->
<section class="cm-hero page-width">
  <div class="cm-hero__grid">
    <div class="cm-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="cm-hero__eyebrow"><span class="cm-hero__rule"></span><span class="cm-hero__eyebrow-text">{{ section.settings.eyebrow }}</span></div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="cm-hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="cm-hero__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="cm-hero__ctas">
        {%- if section.settings.button_label_1 != blank -%}<a href="{{ section.settings.button_link_1 | default: '#form' }}" class="btn btn--dark cm-hero__btn">{{ section.settings.button_label_1 }}</a>{%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}<a href="{{ section.settings.button_link_2 | default: '#process' }}" class="btn btn--outline cm-hero__btn">{{ section.settings.button_label_2 }}</a>{%- endif -%}
      </div>
    </div>
    <div class="cm-hero__media">
      <div class="cm-zoom cm-hero__frame">
        {%- if section.settings.hero_image != blank -%}
          <img src="{{ section.settings.hero_image | image_url: width: 1100 }}" alt="{{ section.settings.heading | strip_html | escape }}" width="1100" height="1320" class="cover-img">
        {%- else -%}<img src="{{ 'custom-flower-vase-room.jpg' | asset_url }}" alt="{{ section.settings.heading | strip_html | escape }}" width="1100" height="1320" class="cover-img">{%- endif -%}
      </div>
      {%- if section.settings.card_title != blank -%}
        <div class="cm-hero__card">
          <div class="cm-hero__card-eyebrow">{{ section.settings.card_eyebrow }}</div>
          <div class="cm-hero__card-title">{{ section.settings.card_title }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<!-- CAPABILITIES -->
{%- if caps.size > 0 -%}
<section class="cm-caps">
  <div class="page-width cm-caps__inner">
    <div class="cm-caps__head">
      {%- if section.settings.caps_eyebrow != blank -%}<div class="eyebrow">{{ section.settings.caps_eyebrow }}</div>{%- endif -%}
      {%- if section.settings.caps_heading != blank -%}<h2 class="section-title">{{ section.settings.caps_heading }}</h2>{%- endif -%}
    </div>
    <div class="cm-caps__grid">
      {%- for block in caps -%}
        <div class="cm-caps__item" {{ block.shopify_attributes }}>
          <div class="cm-caps__icon">{{ block.settings.icon }}</div>
          <h3 class="cm-caps__title">{{ block.settings.title }}</h3>
          <p class="cm-caps__desc">{{ block.settings.desc }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- PROCESS -->
{%- if steps.size > 0 -%}
<section id="process" class="cm-process">
  <div class="page-width cm-process__inner">
    <div class="cm-process__head">
      {%- if section.settings.process_eyebrow != blank -%}<div class="cm-process__eyebrow">{{ section.settings.process_eyebrow }}</div>{%- endif -%}
      {%- if section.settings.process_heading != blank -%}<h2 class="cm-process__heading">{{ section.settings.process_heading }}</h2>{%- endif -%}
    </div>
    <div class="cm-process__grid">
      {%- for block in steps -%}
        <div class="cm-process__step" {{ block.shopify_attributes }}>
          <div class="cm-process__n">{{ block.settings.number }}</div>
          <div class="cm-process__title">{{ block.settings.title }}</div>
          <div class="cm-process__desc">{{ block.settings.desc }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- DESIGNER -->
<section class="cm-designer page-width">
  <div class="cm-designer__grid">
    <div class="cm-zoom cm-designer__media">
      {%- if section.settings.designer_image != blank -%}
        <img src="{{ section.settings.designer_image | image_url: width: 900 }}" alt="" width="900" height="1125" class="cover-img">
      {%- else -%}<img src="{{ 'install-finish-hands.jpg' | asset_url }}" alt="" width="900" height="1125" class="cover-img">{%- endif -%}
    </div>
    <div class="cm-designer__content">
      {%- if section.settings.designer_eyebrow != blank -%}<div class="eyebrow">{{ section.settings.designer_eyebrow }}</div>{%- endif -%}
      {%- if section.settings.designer_heading != blank -%}<h2 class="section-title cm-designer__heading">{{ section.settings.designer_heading }}</h2>{%- endif -%}
      {%- if section.settings.designer_text != blank -%}<p class="cm-designer__text">{{ section.settings.designer_text }}</p>{%- endif -%}
      <div class="cm-designer__points">
        {%- for block in points -%}
          <div class="cm-designer__point" {{ block.shopify_attributes }}>
            <span class="cm-designer__point-icon">{{ block.settings.icon }}</span>
            <div><span class="cm-designer__point-title">{{ block.settings.title }}</span><span class="cm-designer__point-desc"> — {{ block.settings.desc }}</span></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<!-- FORM -->
<section id="form" class="cm-form-section">
  <div class="cm-form-section__inner">
    <div class="cm-form-section__head">
      {%- if section.settings.form_eyebrow != blank -%}<div class="eyebrow">{{ section.settings.form_eyebrow }}</div>{%- endif -%}
      {%- if section.settings.form_heading != blank -%}<h2 class="section-title">{{ section.settings.form_heading }}</h2>{%- endif -%}
      {%- if section.settings.form_text != blank -%}<p class="cm-form-section__text">{{ section.settings.form_text }}</p>{%- endif -%}
    </div>

    {%- form 'contact', class: 'cm-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="cm-form__success">
          <div class="cm-form__success-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7BB0F4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"/></svg>
          </div>
          <h3 class="cm-form__success-title">Thank you — your vision is on its way.</h3>
          <p class="cm-form__success-text">One of our designers will be in touch within one business day to begin shaping your custom mosaic.</p>
        </div>
      {%- else -%}
        {%- if form.errors -%}<div class="cm-form__error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="cm-form__row cm-form__row--2">
          <div><label class="cm-form__label">Name <span>*</span></label><input class="cm-input" name="contact[name]" type="text" required placeholder="Your full name"></div>
          <div><label class="cm-form__label">Email <span>*</span></label><input class="cm-input" name="contact[email]" type="email" required placeholder="you@email.com"></div>
        </div>
        <div class="cm-form__row cm-form__row--3">
          <div><label class="cm-form__label">Phone</label><input class="cm-input" name="contact[phone]" type="tel" placeholder="(315) 000-0000"></div>
          <div><label class="cm-form__label">Width (in)</label><input class="cm-input" name="contact[Width (in)]" type="number" placeholder="e.g. 36"></div>
          <div><label class="cm-form__label">Height (in)</label><input class="cm-input" name="contact[Height (in)]" type="number" placeholder="e.g. 48"></div>
        </div>
        <div class="cm-form__row">
          <div style="width:100%"><label class="cm-form__label">Tell us about your vision</label><textarea class="cm-input" name="contact[body]" placeholder="Subject, style, colors, where it will hang, timeline… (you can email reference images to info@imosaicart.com)"></textarea></div>
        </div>
        <div class="cm-form__submit-row">
          <button type="submit" class="cm-form__submit">Submit Request</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <div class="cm-form-section__contact">
      <a href="tel:+13152175538" class="nav-link">☎ (315) 217-5538</a>
      <span class="cm-form-section__dot">·</span>
      <a href="mailto:info@imosaicart.com" class="nav-link">✉ info@imosaicart.com</a>
    </div>
  </div>
</section>

<style>
  .cm-hero__grid { display: grid; grid-template-columns: 1.02fr 1fr; gap: 64px; align-items: center; padding: 64px 0 72px; }
  .cm-hero__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 26px; }
  .cm-hero__rule { width: 42px; height: 1px; background: var(--color-blue); }
  .cm-hero__eyebrow-text { font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-navy); }
  .cm-hero__heading { font-family: var(--font-display); font-weight: 500; font-size: clamp(44px,5vw,74px); line-height: 1.02; letter-spacing: -.01em; margin-bottom: 26px; color: var(--color-navy); }
  .cm-hero__heading em, .cm-hero__heading i { font-style: italic; color: var(--color-blue); }
  .cm-hero__text { font-size: 17px; line-height: 1.7; color: var(--color-text-muted); max-width: 520px; margin-bottom: 36px; }
  .cm-hero__ctas { display: flex; gap: 16px; }
  .cm-hero__btn { flex: 1; }
  .cm-hero__media { position: relative; align-self: stretch; min-height: 620px; }
  .cm-hero__frame { position: absolute; inset: 0; background: var(--color-light-text); }
  .cm-hero__card { position: absolute; left: -30px; bottom: 46px; background: #fff; padding: 22px 26px; box-shadow: 0 24px 60px rgba(22,51,94,.18); max-width: 248px; }
  .cm-hero__card-eyebrow { font-family: var(--font-accent); font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-blue); margin-bottom: 9px; }
  .cm-hero__card-title { font-family: var(--font-display); font-style: italic; font-size: 22px; line-height: 1.25; color: var(--color-navy); }

  .cm-caps { background: #fff; border-top: 1px solid rgba(22,51,94,.08); border-bottom: 1px solid rgba(22,51,94,.08); }
  .cm-caps__inner { padding-top: 96px; padding-bottom: 96px; }
  .cm-caps__head { text-align: center; margin-bottom: 56px; }
  .cm-caps__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; }
  .cm-caps__item { padding: 0 32px; text-align: center; border-left: 1px solid rgba(22,51,94,.1); }
  .cm-caps__item:first-child { border-left: none; }
  .cm-caps__icon { width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--color-blue); color: var(--color-blue); display: flex; align-items: center; justify-content: center; margin: 0 auto 22px; font-size: 24px; }
  .cm-caps__title { font-family: var(--font-display); font-weight: 600; font-size: 22px; margin-bottom: 12px; color: var(--color-navy); }
  .cm-caps__desc { font-size: 14px; line-height: 1.65; color: var(--color-text-muted); }

  .cm-process { background: var(--color-navy); color: var(--color-light-text); }
  .cm-process__inner { padding-top: 100px; padding-bottom: 100px; }
  .cm-process__head { text-align: center; margin-bottom: 60px; }
  .cm-process__eyebrow { font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-blue-light); margin-bottom: 14px; }
  .cm-process__heading { font-family: var(--font-display); font-weight: 500; font-size: clamp(32px,4vw,52px); line-height: 1.05; color: #fff; }
  .cm-process__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 28px; }
  .cm-process__step { border-top: 1px solid rgba(220,230,245,.18); padding-top: 26px; }
  .cm-process__n { font-family: var(--font-display); font-size: 42px; color: var(--color-blue-light); line-height: 1; margin-bottom: 18px; }
  .cm-process__title { font-size: 17px; font-weight: 600; color: #fff; margin-bottom: 10px; }
  .cm-process__desc { font-size: 14px; line-height: 1.65; color: var(--color-text-faint); }

  .cm-designer { padding-top: 100px; padding-bottom: 100px; }
  .cm-designer__grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 70px; align-items: center; }
  .cm-designer__media { position: relative; aspect-ratio: 4/5; overflow: hidden; background: var(--color-light-text); }
  .cm-designer__heading { margin-bottom: 22px; }
  .cm-designer__text { font-size: 16px; line-height: 1.75; color: var(--color-text-muted); max-width: 500px; margin-bottom: 32px; }
  .cm-designer__points { display: flex; flex-direction: column; gap: 18px; }
  .cm-designer__point { display: flex; align-items: flex-start; gap: 14px; }
  .cm-designer__point-icon { color: var(--color-blue); margin-top: 2px; flex-shrink: 0; font-size: 18px; }
  .cm-designer__point-title { font-size: 15.5px; font-weight: 600; color: var(--color-navy); }
  .cm-designer__point-desc { font-size: 14.5px; color: var(--color-text-muted); }

  .cm-form-section { background: var(--color-panel); border-top: 1px solid rgba(22,51,94,.08); }
  .cm-form-section__inner { max-width: 1080px; margin: 0 auto; padding: 96px 40px; }
  .cm-form-section__head { text-align: center; margin-bottom: 48px; }
  .cm-form-section__head .eyebrow { margin-bottom: 14px; }
  .cm-form-section__text { font-size: 16px; line-height: 1.7; color: var(--color-text-muted); max-width: 560px; margin: 16px auto 0; }
  .cm-form { background: #fff; padding: 48px; box-shadow: 0 30px 70px rgba(22,51,94,.1); }
  .cm-form__row { margin-bottom: 22px; }
  .cm-form__row--2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .cm-form__row--3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 22px; }
  .cm-form__label { display: block; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #46546E; margin-bottom: 9px; }
  .cm-form__label span { color: var(--color-blue); }
  .cm-input { width: 100%; font-family: var(--font-body); font-size: 15px; color: var(--color-navy); background: #fff; border: 1px solid rgba(22,51,94,.18); padding: 14px 16px; outline: none; transition: border-color .2s ease; }
  .cm-input:focus { border-color: var(--color-blue); }
  .cm-input::placeholder { color: var(--color-text-faint); }
  textarea.cm-input { resize: vertical; min-height: 104px; }
  .cm-form__submit-row { display: flex; justify-content: flex-end; }
  .cm-form__submit { background: var(--color-blue); color: #fff; border: none; font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; padding: 17px 44px; cursor: pointer; transition: background .25s ease; }
  .cm-form__submit:hover { background: #1E63C4; }
  .cm-form__error { font-size: 13.5px; color: #C2724B; margin-bottom: 18px; }
  .cm-form__success { text-align: center; padding: 16px 0; }
  .cm-form__success-icon { width: 64px; height: 64px; border-radius: 50%; background: var(--color-navy); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; }
  .cm-form__success-title { font-family: var(--font-display); font-size: 32px; margin-bottom: 12px; color: var(--color-navy); }
  .cm-form__success-text { font-size: 15.5px; line-height: 1.7; color: var(--color-text-muted); max-width: 460px; margin: 0 auto; }
  .cm-form-section__contact { display: flex; align-items: center; justify-content: center; gap: 30px; flex-wrap: wrap; margin-top: 34px; font-size: 13.5px; color: var(--color-text-muted); }
  .cm-form-section__dot { color: #C4CDDC; }

  @media (max-width: 990px) {
    .cm-hero__grid, .cm-designer__grid { grid-template-columns: 1fr; gap: 40px; }
    .cm-hero__media { min-height: 460px; }
    .cm-caps__grid, .cm-process__grid { grid-template-columns: 1fr 1fr; gap: 40px 24px; }
    .cm-caps__item { border-left: none; }
    .cm-form { padding: 32px 24px; }
    .cm-form__row--2, .cm-form__row--3 { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
