<section class="auth">
  <div class="auth__panel">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1100 }}" alt="" width="1100" height="1100" class="auth__panel-img">
    {%- else -%}
      <img src="https://www.imosaicart.com/cdn/shop/files/MAS081_b2d557a7-36fa-418b-b736-ec6f27f75af3.jpg?width=1100" alt="Handcrafted mosaic" loading="lazy" class="auth__panel-img">
    {%- endif -%}
    <div class="auth__panel-veil"></div>
    <div class="auth__panel-content">
      <div class="auth__panel-eyebrow">{{ section.settings.panel_eyebrow }}</div>
      <h2 class="auth__panel-heading">{{ section.settings.panel_heading }}</h2>
      <p class="auth__panel-text">{{ section.settings.panel_text }}</p>
    </div>
  </div>

  <div class="auth__form-wrap">
    <div class="auth__form">
      <div class="auth__tabs">
        <span class="auth__tab is-active">Sign In</span>
        <a href="{{ routes.account_register_url }}" class="auth__tab">Create Account</a>
      </div>

      <div id="RecoverPassword" style="display:none;">
        <h1 class="auth__title">Reset your password</h1>
        <p class="auth__subtitle">We'll send you an email to reset it.</p>
        {%- form 'recover_customer_password' -%}
          {%- if form.posted_successfully? -%}<div class="auth__notice">We've sent you an email with a link to update your password.</div>{%- endif -%}
          <label class="auth__label">Email Address</label>
          <input type="email" name="email" class="auth__field" placeholder="you@email.com" required>
          <button type="submit" class="auth__submit">Send reset link</button>
        {%- endform -%}
        <p class="auth__switch"><button type="button" class="auth__switch-btn" data-show-login>← Back to sign in</button></p>
      </div>

      <div id="LoginForm">
        <h1 class="auth__title">{{ section.settings.form_heading }}</h1>
        <p class="auth__subtitle">{{ section.settings.form_subtitle }}</p>
        {%- form 'customer_login' -%}
          {%- if form.errors -%}<div class="auth__error">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label class="auth__label">Email Address</label>
          <input type="email" name="customer[email]" class="auth__field" placeholder="you@email.com" required>
          <label class="auth__label">Password</label>
          <input type="password" name="customer[password]" class="auth__field" placeholder="••••••••" required>
          <div class="auth__forgot"><button type="button" class="auth__forgot-btn" data-show-recover>Forgot password?</button></div>
          <button type="submit" class="auth__submit">Sign In</button>
        {%- endform -%}
        <p class="auth__switch">New to iMosaicArt? <a href="{{ routes.account_register_url }}" class="auth__switch-link">Create an account</a></p>
      </div>
    </div>
  </div>
</section>

<script>
  (function(){
    var rec = document.getElementById('RecoverPassword'), log = document.getElementById('LoginForm');
    document.querySelectorAll('[data-show-recover]').forEach(function(b){ b.addEventListener('click', function(){ rec.style.display='block'; log.style.display='none'; }); });
    document.querySelectorAll('[data-show-login]').forEach(function(b){ b.addEventListener('click', function(){ rec.style.display='none'; log.style.display='block'; }); });
    if (window.location.hash === '#recover') { rec.style.display='block'; log.style.display='none'; }
  })();
</script>

<style>
  .auth { display: grid; grid-template-columns: 1.05fr 1fr; min-height: 620px; }
  .auth__panel { position: relative; background: var(--color-navy); overflow: hidden; min-height: 560px; }
  .auth__panel-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .auth__panel-veil { position: absolute; inset: 0; background: linear-gradient(120deg, rgba(16,42,79,.85) 0%, rgba(22,51,94,.5) 100%); }
  .auth__panel-content { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding: 60px 56px; }
  .auth__panel-eyebrow { font-family: var(--font-accent); font-size: 13px; letter-spacing: .32em; text-transform: uppercase; color: var(--color-blue-light); margin-bottom: 18px; }
  .auth__panel-heading { font-family: var(--font-display); font-weight: 500; font-size: clamp(30px,3vw,44px); line-height: 1.12; margin-bottom: 16px; color: #fff; }
  .auth__panel-text { font-size: 16px; line-height: 1.7; color: #C7CFDD; max-width: 380px; }

  .auth__form-wrap { display: flex; align-items: center; justify-content: center; padding: 64px 40px; }
  .auth__form { width: 100%; max-width: 420px; }
  .auth__tabs { display: flex; margin-bottom: 38px; border-bottom: 1px solid rgba(22,51,94,.14); }
  .auth__tab { padding: 0 4px 16px; margin-right: 28px; font-family: var(--font-body); font-size: 14px; font-weight: 600; letter-spacing: .04em; color: var(--color-text-soft); background: none; border: none; cursor: pointer; }
  .auth__tab.is-active { color: var(--color-navy); border-bottom: 2px solid var(--color-blue); margin-bottom: -1px; }
  .auth__title { font-family: var(--font-display); font-weight: 500; font-size: 34px; line-height: 1.1; margin-bottom: 8px; color: var(--color-navy); }
  .auth__subtitle { font-size: 15px; line-height: 1.6; color: var(--color-text-muted); margin-bottom: 30px; }
  .auth__label { display: block; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-text-soft); margin-bottom: 9px; }
  .auth__field { width: 100%; background: #fff; border: 1px solid rgba(22,51,94,.18); outline: none; color: var(--color-navy); font-family: var(--font-body); font-size: 15px; padding: 15px 18px; margin-bottom: 18px; transition: border-color .2s ease; }
  .auth__field:focus { border-color: var(--color-blue); }
  .auth__forgot { text-align: right; margin-bottom: 24px; margin-top: -6px; }
  .auth__forgot-btn, .auth__switch-btn { background: none; border: none; cursor: pointer; font-family: var(--font-body); font-size: 13px; color: var(--color-blue); }
  .auth__submit { width: 100%; background: var(--color-blue); color: #fff; border: none; font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; padding: 17px; cursor: pointer; transition: background .25s ease; }
  .auth__submit:hover { background: #1E63C4; }
  .auth__switch { text-align: center; font-size: 14px; color: var(--color-text-muted); margin-top: 28px; }
  .auth__switch-link { color: var(--color-blue); font-weight: 600; }
  .auth__error, .auth__notice { font-size: 13px; margin-bottom: 18px; padding: 12px 14px; }
  .auth__error { color: #C0432F; background: rgba(192,67,47,.08); }
  .auth__notice { color: #1F8A5B; background: rgba(31,138,91,.08); }

  @media (max-width: 900px) {
    .auth { grid-template-columns: 1fr; }
    .auth__panel { min-height: 280px; }
    .auth__panel-content { padding: 36px 28px; }
  }
</style>

{% schema %}
{
  "name": "Login",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Panel image" },
    { "type": "text", "id": "panel_eyebrow", "label": "Panel eyebrow", "default": "Welcome to the Home of Mosaics" },
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "Where Art Meets Elegance" },
    { "type": "textarea", "id": "panel_text", "label": "Panel text", "default": "Sign in to track orders, save your favorite mosaics, and earn rewards on every handcrafted piece." },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Welcome Back" },
    { "type": "text", "id": "form_subtitle", "label": "Form subtitle", "default": "Sign in to your account to continue." }
  ]
}
{% endschema %}
