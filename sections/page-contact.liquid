    </div>
  </div>
</section>


{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reach Us" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Let's Create Something <em>Timeless</em></p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about a piece, a custom commission, or your order? Our studio team is here to help — reach out and we'll respond within one business day." },
    { "type": "text", "id": "details_heading", "label": "Details heading", "default": "We'd Love to Hear From You" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1 (315) 217-5538" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@imosaicart.com" },
    { "type": "text", "id": "address", "label": "Address", "default": "28 Liberty St, New York, NY 10005, United States" },
    { "type": "header", "content": "Opening hours" },
    { "type": "text", "id": "hours_1_label", "label": "Row 1 label", "default": "Monday – Saturday" },
    { "type": "text", "id": "hours_1", "label": "Row 1 hours", "default": "8:00am – 7:00pm" },
    { "type": "text", "id": "hours_2_label", "label": "Row 2 label", "default": "Sunday" },
    { "type": "text", "id": "hours_2", "label": "Row 2 hours", "default": "9:00am – 2:00pm" }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
