<style>
  .srch-hero { background: var(--color-panel); border-bottom: 1px solid rgba(22,51,94,.08); }
  .srch-hero__crumb-wrap { padding-top: 30px; }
  .srch-hero__crumb { display: flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-soft); }
  .srch-hero__crumb-sep { color: #B7C0D2; }
  .srch-hero__crumb-current { color: var(--color-navy); }
  .srch-hero__inner { max-width: 780px; margin: 0 auto; padding: 44px 40px 50px; text-align: center; }
  .srch-hero__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(36px,4.4vw,56px); line-height: 1.04; margin-bottom: 26px; color: var(--color-navy); }
  .srch-hero__title em { font-style: italic; color: var(--color-blue); }
  .srch-hero__form { position: relative; }
  .srch-hero__icon { position: absolute; left: 20px; top: 50%; transform: translateY(-50%); }
  .srch-hero__input { width: 100%; background: #fff; border: 1px solid rgba(22,51,94,.18); outline: none; color: var(--color-navy); font-family: var(--font-body); font-size: 16px; padding: 18px 52px; }
  .srch-hero__input:focus { border-color: var(--color-blue); }

  .srch { padding-top: 50px; padding-bottom: 100px; }
  .srch__count { margin-bottom: 30px; font-size: 14px; color: var(--color-text-muted); }

  /* Layout: filter sidebar + results */
  .srch__layout { display: grid; grid-template-columns: 248px 1fr; gap: 44px; align-items: start; }
  .srch__layout--full { grid-template-columns: 1fr; }
  .srch__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px 24px; }
  .srch__layout:not(.srch__layout--full) .srch__main .srch__grid { grid-template-columns: repeat(3, 1fr); }

  /* Filters */
  .srch__filters { position: sticky; top: 100px; }
  .srch__filters-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: 1px solid rgba(22,51,94,.14); }
  .srch__filters-title { font-family: var(--font-accent); font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-navy); }
  .srch__filter-reset { font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-blue); }
  .srch__filter-reset:hover { color: var(--color-navy); }
  .srch-facet { border-bottom: 1px solid rgba(22,51,94,.1); padding: 16px 0; }
  .srch-facet__title { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--color-navy); margin-bottom: 12px; }
  .srch-facet__list { list-style: none; margin: 0; padding: 0 8px 0 0; max-height: 260px; overflow-y: auto; scrollbar-gutter: stable; scrollbar-width: thin; scrollbar-color: transparent transparent; }
  .srch-facet__list:hover { scrollbar-color: rgba(22,51,94,.28) transparent; }
  .srch-facet__list::-webkit-scrollbar { width: 5px; }
  .srch-facet__list::-webkit-scrollbar-thumb { background: transparent; border-radius: 10px; }
  .srch-facet__list:hover::-webkit-scrollbar-thumb { background: rgba(22,51,94,.28); }
  .srch-facet__opt { display: flex; align-items: center; gap: 11px; padding: 7px 0; font-size: 14px; color: #46546E; transition: color .2s ease; }
  .srch-facet__opt:hover .srch-facet__lbl { color: var(--color-navy); }
  .srch-facet__opt.is-empty { opacity: .4; pointer-events: none; }
  .srch-facet__box { position: relative; flex-shrink: 0; width: 17px; height: 17px; border: 1px solid rgba(22,51,94,.3); }
  .srch-facet__opt.is-active .srch-facet__box { background: var(--color-blue); border-color: var(--color-blue); }
  .srch-facet__opt.is-active .srch-facet__box::after { content: ""; position: absolute; left: 5px; top: 1px; width: 5px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .srch-facet__lbl { flex: 1; }
  .srch-facet__cnt { flex-shrink: 0; min-width: 34px; text-align: right; color: var(--color-text-faint); font-size: 12px; font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; }
  /* Price slider (same as the collection page) */
  .srch-facet .coll-facet__pricetop { font-size: 13px; color: #5E6B85; margin-bottom: 14px; }
  .srch-facet .coll-facet__pricetop strong { color: var(--color-navy); font-weight: 600; }
  .srch-facet .coll-facet__slider { position: relative; height: 24px; margin: 6px 0 20px; }
  .srch-facet .coll-facet__track { position: absolute; top: 10px; left: 8px; right: 8px; height: 3px; background: #DCE6F5; border-radius: 2px; }
  .srch-facet .coll-facet__track-fill { position: absolute; top: 0; bottom: 0; background: var(--color-blue); border-radius: 2px; }
  .srch-facet .coll-facet__range { -webkit-appearance: none; appearance: none; position: absolute; top: 0; left: 0; width: 100%; height: 24px; margin: 0; background: transparent; pointer-events: none; }
  .srch-facet .coll-facet__range:focus { outline: none; }
  .srch-facet .coll-facet__range--min { z-index: 4; }
  .srch-facet .coll-facet__range--max { z-index: 3; }
  .srch-facet .coll-facet__range::-webkit-slider-runnable-track { -webkit-appearance: none; height: 24px; background: transparent; border: none; }
  .srch-facet .coll-facet__range::-moz-range-track { height: 24px; background: transparent; border: none; }
  .srch-facet .coll-facet__range::-webkit-slider-thumb { -webkit-appearance: none; pointer-events: auto; margin-top: 4px; width: 16px; height: 16px; border-radius: 50%; background: var(--color-navy); border: 2px solid #fff; box-shadow: 0 1px 5px rgba(22,51,94,.4); cursor: grab; }
  .srch-facet .coll-facet__range::-webkit-slider-thumb:active { cursor: grabbing; }
  .srch-facet .coll-facet__range::-moz-range-thumb { pointer-events: auto; width: 16px; height: 16px; border-radius: 50%; background: var(--color-navy); border: 2px solid #fff; box-shadow: 0 1px 5px rgba(22,51,94,.4); cursor: grab; }
  .srch-facet .coll-facet__price { display: flex; gap: 10px; align-items: center; }
  .srch-facet .coll-facet__price-box { flex: 1; display: flex; align-items: center; gap: 4px; border: 1px solid rgba(22,51,94,.2); padding: 9px 12px; }
  .srch-facet .coll-facet__price-cur { font-size: 13px; color: #5E6B85; }
  .srch-facet .coll-facet__price-box input { flex: 1; width: 100%; border: none; outline: none; background: none; font-size: 13px; color: #5E6B85; padding: 0; -moz-appearance: textfield; }
  .srch-facet .coll-facet__price-box input::-webkit-outer-spin-button, .srch-facet .coll-facet__price-box input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  /* Pages / guides / journal / collection results */
  .srch__docs { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }
  .srch__doc {
    display: flex; align-items: center; gap: 18px;
    background: #fff; border: 1px solid rgba(22,51,94,.1);
    padding: 18px 20px; transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  .srch__doc:hover { border-color: var(--color-blue); box-shadow: 0 8px 24px rgba(22,51,94,.08); transform: translateY(-1px); }
  .srch__doc-ic { flex-shrink: 0; width: 46px; height: 46px; border-radius: 50%; background: var(--color-panel); display: flex; align-items: center; justify-content: center; }
  .srch__doc-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .srch__doc-kind { font-family: var(--font-accent); font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-blue); }
  .srch__doc-title { font-family: var(--font-display); font-size: 21px; line-height: 1.2; color: var(--color-navy); }
  .srch__doc-ex { font-size: 13.5px; line-height: 1.55; color: var(--color-text-muted); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .srch__doc-arrow { flex-shrink: 0; color: #B7C0D2; transition: color .2s ease, transform .2s ease; }
  .srch__doc:hover .srch__doc-arrow { color: var(--color-blue); transform: translateX(3px); }
  .srch__section-label { font-family: var(--font-accent); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 20px; }

  /* Pager */
  .srch__pager { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 60px; flex-wrap: wrap; }
  .srch__page { min-width: 42px; height: 42px; padding: 0 12px; display: inline-flex; align-items: center; justify-content: center; background: #fff; border: 1px solid rgba(22,51,94,.18); color: var(--color-navy); font-size: 14px; transition: border-color .2s ease, color .2s ease, transform .2s ease; }
  .srch__page:hover { border-color: var(--color-blue); color: var(--color-blue); transform: translateY(-2px); }
  .srch__page.is-active { background: var(--color-navy); color: #fff; border-color: var(--color-navy); font-weight: 600; transform: none; cursor: default; }
  .srch__page--gap { border: none; background: none; min-width: auto; color: var(--color-text-faint); }
  .srch__page--nav svg { width: 17px; height: 17px; }

  .srch__suggest { max-width: 780px; margin: 0 auto 48px; }
  .srch__suggest-label { font-family: var(--font-accent); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 18px; }
  .srch__suggest-label--mt { margin-top: 10px; }
  .srch__chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .srch__chip { background: #fff; border: 1px solid rgba(22,51,94,.18); color: #46546E; font-size: 13px; padding: 10px 20px; transition: all .2s ease; }
  .srch__chip:hover { border-color: var(--color-blue); color: var(--color-navy); }
  .srch__empty { text-align: center; padding: 60px 20px 80px; }
  .srch__empty-icon { width: 78px; height: 78px; border-radius: 50%; background: var(--color-panel); display: flex; align-items: center; justify-content: center; margin: 0 auto 26px; }
  .srch__empty-title { font-family: var(--font-display); font-weight: 500; font-size: 30px; margin-bottom: 10px; color: var(--color-navy); }
  .srch__empty-text { font-size: 15.5px; line-height: 1.6; color: var(--color-text-muted); margin-bottom: 26px; }

  @media (max-width: 990px) {
    .srch__layout { grid-template-columns: 1fr; gap: 28px; }
    .srch__filters { position: static; }
    .srch__grid, .srch__layout:not(.srch__layout--full) .srch__main .srch__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<section class="srch-hero">
  <div class="page-width srch-hero__crumb-wrap">
    <div class="srch-hero__crumb">
      <a href="{{ routes.root_url }}" class="nav-link">Home</a>
      <span class="srch-hero__crumb-sep">/</span>
      <span class="srch-hero__crumb-current">Search</span>
    </div>
  </div>
  <div class="srch-hero__inner">
    <h1 class="srch-hero__title">What are you <em>looking for?</em></h1>
    <form action="{{ routes.search_url }}" method="get" class="srch-hero__form" data-predictive data-money-format="{{ shop.money_format }}">
      <input type="hidden" name="options[prefix]" value="last">
      <svg class="srch-hero__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7E8AA0" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search mosaics by name, subject or style…" class="srch-hero__input" data-predictive-input>
      <div class="psg psg--page" data-predictive-results hidden></div>
    </form>
  </div>
</section>

<section class="srch page-width">
  {%- if search.performed -%}
    {%- assign per_page = section.settings.per_page | default: 24 -%}
    {%- paginate search.results by per_page -%}
      <div class="srch__count">{{ 'general.search.results_with_count' | t: count: search.results_count }} for “{{ search.terms }}”</div>
      {%- if search.results_count > 0 -%}
        <div class="srch__layout{% if search.filters.size == 0 %} srch__layout--full{% endif %}">

          {%- if search.filters.size > 0 -%}
            <aside class="srch__filters">
              <div class="srch__filters-head">
                <span class="srch__filters-title">Filter</span>
                <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&options%5Bprefix%5D=last" class="srch__filter-reset">Reset</a>
              </div>
              {%- for filter in search.filters -%}
                <div class="srch-facet">
                  <div class="srch-facet__title">{{ filter.label }}</div>
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      {%- assign rmax = filter.range_max | money_without_currency | replace: ',', '' | replace: '.00', '' | plus: 0 -%}
                      {%- if rmax == 0 -%}{%- assign rmax = 1 -%}{%- endif -%}
                      {%- assign vmin = 0 -%}
                      {%- if filter.min_value.value != blank -%}{%- assign vmin = filter.min_value.value | money_without_currency | replace: ',', '' | replace: '.00', '' | plus: 0 -%}{%- endif -%}
                      {%- assign vmax = rmax -%}
                      {%- if filter.max_value.value != blank -%}{%- assign vmax = filter.max_value.value | money_without_currency | replace: ',', '' | replace: '.00', '' | plus: 0 -%}{%- endif -%}
                      {%- assign lpct = vmin | times: 100 | divided_by: rmax -%}
                      {%- assign mpct = vmax | times: 100 | divided_by: rmax -%}
                      <form method="get" action="{{ routes.search_url }}" class="coll-facet">
                        <input type="hidden" name="q" value="{{ search.terms | escape }}">
                        <input type="hidden" name="options[prefix]" value="last">
                        {%- for f2 in search.filters -%}{%- unless f2.type == 'price_range' -%}{%- for v in f2.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}{%- endunless -%}{%- endfor -%}
                        <div class="coll-facet__slider" data-price-slider data-max="{{ rmax }}">
                          <div class="coll-facet__track"><span class="coll-facet__track-fill" data-price-fill style="left:{{ lpct }}%; right:{{ 100 | minus: mpct }}%;"></span></div>
                          <input type="range" class="coll-facet__range coll-facet__range--min" min="0" max="{{ rmax }}" step="1" value="{{ vmin }}" data-price-range="min" aria-label="Minimum price">
                          <input type="range" class="coll-facet__range coll-facet__range--max" min="0" max="{{ rmax }}" step="1" value="{{ vmax }}" data-price-range="max" aria-label="Maximum price">
                        </div>
                        <div class="coll-facet__price">
                          <div class="coll-facet__price-box"><span class="coll-facet__price-cur">$</span><input type="number" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value != blank %}{{ vmin }}{% endif %}" placeholder="0" min="0" max="{{ rmax }}" data-price-input="min"></div>
                          <div class="coll-facet__price-box"><span class="coll-facet__price-cur">$</span><input type="number" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value != blank %}{{ vmax }}{% endif %}" placeholder="{{ rmax }}" min="0" max="{{ rmax }}" data-price-input="max"></div>
                        </div>
                      </form>
                    {%- else -%}
                      <ul class="srch-facet__list">
                        {%- for value in filter.values -%}
                          <li>
                            <a href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}" class="srch-facet__opt{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-empty{% endif %}" rel="nofollow">
                              <span class="srch-facet__box"></span>
                              <span class="srch-facet__lbl">{{ value.label }}</span>
                              <span class="srch-facet__cnt">({{ value.count }})</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            </aside>
          {%- endif -%}

          <div class="srch__main">
            {%- comment -%} Non-product matches (pages, guides, journal, collections) — shown on the first page. {%- endcomment -%}
            {%- if paginate.current_page == 1 -%}
              {%- assign has_docs = false -%}
              {%- for item in search.results -%}{%- unless item.object_type == 'product' -%}{%- assign has_docs = true -%}{%- endunless -%}{%- endfor -%}
              {%- if has_docs -%}
                <div class="srch__docs">
                  {%- for item in search.results -%}
                    {%- unless item.object_type == 'product' -%}
                      {%- if item.object_type == 'article' -%}
                        {%- assign doc_kind = 'Journal' -%}{%- assign doc_ex = item.excerpt | default: item.content -%}
                      {%- elsif item.object_type == 'collection' -%}
                        {%- assign doc_kind = 'Collection' -%}{%- assign doc_ex = item.description -%}
                      {%- else -%}
                        {%- assign doc_kind = 'Guide & Info' -%}{%- assign doc_ex = item.content -%}
                      {%- endif -%}
                      {%- assign doc_ex = doc_ex | strip_html | truncatewords: 26 -%}
                      <a href="{{ item.url }}" class="srch__doc">
                        <span class="srch__doc-ic">
                          {%- if item.object_type == 'collection' -%}
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.6"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                          {%- elsif item.object_type == 'article' -%}
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.6"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                          {%- else -%}
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/></svg>
                          {%- endif -%}
                        </span>
                        <span class="srch__doc-body">
                          <span class="srch__doc-kind">{{ doc_kind }}</span>
                          <span class="srch__doc-title">{{ item.title }}</span>
                          {%- if doc_ex != blank -%}<span class="srch__doc-ex">{{ doc_ex }}</span>{%- endif -%}
                        </span>
                        <span class="srch__doc-arrow" aria-hidden="true">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                      </a>
                    {%- endunless -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endif -%}

            {%- assign has_products = false -%}
            {%- for item in search.results -%}{%- if item.object_type == 'product' -%}{%- assign has_products = true -%}{%- endif -%}{%- endfor -%}
            {%- if has_products -%}
              {%- if paginate.current_page == 1 and has_docs -%}<div class="srch__section-label">Mosaics</div>{%- endif -%}
              <div class="srch__grid">
                {%- for item in search.results -%}
                  {%- if item.object_type == 'product' -%}
                    {% render 'card-collection', product: item, stacked_cta: true %}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if paginate.pages > 1 -%}
              <nav class="srch__pager" aria-label="Pagination">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="srch__page srch__page--nav" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="srch__page">{{ part.title }}</a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span class="srch__page is-active">{{ part.title }}</span>
                  {%- else -%}
                    <span class="srch__page srch__page--gap">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="srch__page srch__page--nav" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <div class="srch__empty">
          <div class="srch__empty-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></div>
          <h2 class="srch__empty-title">No mosaics found for “{{ search.terms }}”</h2>
          <p class="srch__empty-text">Try a different name, subject or style — or browse the full collection.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--dark">Browse All Mosaics</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- if section.settings.popular != blank -%}
      <div class="srch__suggest">
        <div class="srch__suggest-label">Popular Searches</div>
        <div class="srch__chips">
          {%- assign terms = section.settings.popular | split: ',' -%}
          {%- for term in terms -%}
            {%- assign t = term | strip -%}
            <a href="{{ routes.search_url }}?q={{ t | url_encode }}" class="srch__chip">{{ t }}</a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    {%- comment -%} Resolve a source of featured products: chosen setting → frontpage → first non-empty collection. {%- endcomment -%}
    {%- assign feat = section.settings.featured_collection -%}
    {%- if feat == blank or feat.products.size == 0 -%}{%- assign feat = collections['frontpage'] -%}{%- endif -%}
    {%- if feat == blank or feat.products.size == 0 -%}
      {%- for c in collections -%}
        {%- unless c.handle == 'all' or c.handle == 'frontpage' -%}
          {%- if c.products.size > 0 -%}{%- assign feat = c -%}{%- break -%}{%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if feat != blank and feat.products.size > 0 -%}
      <div class="srch__suggest-label srch__suggest-label--mt">Featured Mosaics</div>
      <div class="srch__grid">
        {%- for product in feat.products limit: 8 -%}
          {% render 'card-collection', product: product, stacked_cta: true %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>


<script>
  (function () {
    function initSlider(slider) {
      var max = parseFloat(slider.getAttribute('data-max')) || 1;
      var rMin = slider.querySelector('[data-price-range="min"]');
      var rMax = slider.querySelector('[data-price-range="max"]');
      var fill = slider.querySelector('[data-price-fill]');
      var form = slider.closest('form');
      var scope = slider.closest('.coll-facet') || document;
      var iMin = scope.querySelector('[data-price-input="min"]');
      var iMax = scope.querySelector('[data-price-input="max"]');
      if (!rMin || !rMax) return;
      function pct(v) { return (v / max) * 100; }
      function lohi() { return [Math.min(+rMin.value, +rMax.value), Math.max(+rMin.value, +rMax.value)]; }
      function draw() { var lh = lohi(); if (fill) { fill.style.left = pct(lh[0]) + '%'; fill.style.right = (100 - pct(lh[1])) + '%'; } }
      function syncInputs() { var lh = lohi(); if (iMin) iMin.value = lh[0] > 0 ? lh[0] : ''; if (iMax) iMax.value = lh[1] < max ? lh[1] : ''; }
      var appliedLo = Math.min(+rMin.value, +rMax.value);
      var appliedHi = Math.max(+rMin.value, +rMax.value);
      function apply() { if (!form) return; var lh = lohi(); if (lh[0] === appliedLo && lh[1] === appliedHi) return; if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); } }
      rMin.addEventListener('input', function () { if (+rMin.value > +rMax.value) { rMin.value = rMax.value; } draw(); syncInputs(); });
      rMax.addEventListener('input', function () { if (+rMax.value < +rMin.value) { rMax.value = rMin.value; } draw(); syncInputs(); });
      rMin.addEventListener('change', apply);
      rMax.addEventListener('change', apply);
      [rMin, rMax].forEach(function (r) {
        r.addEventListener('pointerdown', function () { rMin.style.zIndex = (r === rMin) ? 6 : 4; rMax.style.zIndex = (r === rMax) ? 6 : 4; });
        r.addEventListener('wheel', function (e) { e.preventDefault(); }, { passive: false });
      });
      if (iMin) { iMin.addEventListener('input', function () { var v = parseFloat(iMin.value); rMin.value = isNaN(v) ? 0 : Math.max(0, Math.min(v, max)); draw(); }); iMin.addEventListener('change', apply); }
      if (iMax) { iMax.addEventListener('input', function () { var v = parseFloat(iMax.value); rMax.value = isNaN(v) ? max : Math.max(0, Math.min(v, max)); draw(); }); iMax.addEventListener('change', apply); }
      draw();
    }
    document.querySelectorAll('[data-price-slider]').forEach(initSlider);
  })();
</script>

{% schema %}
