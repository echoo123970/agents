  "name": "Search",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Results per page", "default": 24 },
    { "type": "text", "id": "popular", "label": "Popular searches (comma separated)", "default": "Portrait, Nautical, Flower, Geometric, Van Gogh, Religious" },
    { "type": "collection", "id": "featured_collection", "label": "Featured collection (shown before searching)" }
  ]
}
