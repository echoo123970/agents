<style>
  .lc { background: var(--color-bg); padding-top: 60px; padding-bottom: 96px; }
  .lc__head { text-align: center; max-width: 720px; margin: 0 auto 54px; }
  .lc__eyebrow { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 20px; font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-navy); }
  .lc__eyebrow-rule { width: 38px; height: 1px; background: var(--color-blue); }
  .lc__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(38px, 5vw, 64px); line-height: 1.02; letter-spacing: -.01em; color: var(--color-navy); margin-bottom: 18px; }
  .lc__sub { font-size: 17px; line-height: 1.7; color: var(--color-text-muted); }
  .lc__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .lc-card { position: relative; display: block; overflow: hidden; aspect-ratio: 3/4; background: var(--color-light-text); container-type: inline-size; }
  .lc-card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .9s cubic-bezier(.2,.7,.2,1); }
  .lc-card:hover .lc-card__img { transform: scale(1.06); }
  .lc-card__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(11,28,53,.74), rgba(11,28,53,0) 58%); transition: background .4s ease; z-index: 1; }
  .lc-card:hover .lc-card__scrim { background: linear-gradient(to top, rgba(11,28,53,.84), rgba(11,28,53,.14) 72%); }
  .lc-card::after { content: ""; position: absolute; inset: 18px; border: 1px solid rgba(255,255,255,.85); opacity: 0; transform: scale(1.03); transition: opacity .4s ease, transform .4s ease; pointer-events: none; z-index: 2; }
  .lc-card:hover::after { opacity: 1; transform: scale(1); }
  .lc-card__label { position: absolute; left: 30px; right: 30px; bottom: 38px; color: var(--color-bg); font-family: var(--font-display); font-weight: 500; font-size: clamp(19px, 7cqw, 25px); line-height: 1.05; letter-spacing: .01em; z-index: 3; }
  .lc-card__cta { position: absolute; left: 30px; bottom: 22px; color: #fff; font-size: clamp(9px, 3.4cqw, 10.5px); letter-spacing: .18em; text-transform: uppercase; z-index: 3; opacity: 0; transform: translateY(8px); transition: opacity .4s ease, transform .4s ease; }
  .lc-card:hover .lc-card__cta { opacity: 1; transform: translateY(0); }
  .lc__empty { text-align: center; padding: 60px 20px; font-family: var(--font-display); font-style: italic; font-size: 24px; color: var(--color-navy); }
  .lc-card--vg .lc-card__img { object-position: 60% center; transform: scale(1.1); }
  .lc-card--vg:hover .lc-card__img { transform: scale(1.16); }
  .lc-card--fl .lc-card__img { transform: scale(1.12); }
  .lc-card--fl:hover .lc-card__img { transform: scale(1.18); }
  .lc-card--ab .lc-card__img { transform: scale(1.28); }
  .lc-card--ab:hover .lc-card__img { transform: scale(1.34); }
  @media (max-width: 990px) { .lc { padding-top: 40px; } .lc__head { margin-bottom: 40px; } .lc__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 749px) {
    .lc__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .lc-card__label { left: 18px; right: 18px; bottom: 20px; }
    .lc-card__cta { display: none; }
  }
</style>

<section class="lc page-width">
  <div class="lc__head">
    <div class="lc__eyebrow"><span class="lc__eyebrow-rule"></span>Browse<span class="lc__eyebrow-rule"></span></div>
    <h1 class="lc__title">Shop by Collection</h1>
    <p class="lc__sub">Explore our handcrafted marble and glass mosaic collections — each piece hand-cut by master artisans and made to order.</p>
  </div>

  {%- assign shown = 0 -%}
  <div class="lc__grid">
    {%- for collection in collections -%}
      {%- assign h = collection.handle -%}
      {%- comment -%} Only live categories: collections that actually have products, excluding system/meta collections. {%- endcomment -%}
      {%- unless collection.products_count == 0 or h == 'all' or h == 'frontpage' or h == 'home-page' or h == 'mosaic-tile-art' or collection.title contains 'Studio Specials' or collection.title contains 'Limited Edition' or collection.title contains 'Best Sellers' or collection.title contains 'New Arrivals' -%}
        {%- assign shown = shown | plus: 1 -%}
        <a href="{{ collection.url }}" class="lc-card{% if h == 'van-gogh-mosaics' %} lc-card--vg{% endif %}{% if h == 'flower-mosaics' %} lc-card--fl{% endif %}{% if h == 'abstract-mosaics' %} lc-card--ab{% endif %}">
          {%- if collection.featured_image != blank -%}
            <img src="{{ collection.featured_image | image_url: width: 700 }}" alt="{{ collection.title | escape }}" width="700" height="933" class="lc-card__img" loading="lazy"{% if h == 'portrait-mosaics' %} style="object-position: center 8%;"{% endif %}>
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'lc-card__img' }}
          {%- endif -%}
          <span class="lc-card__scrim"></span>
          <span class="lc-card__label">{{ collection.title }}</span>
          <span class="lc-card__cta">View Collection</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>

  {%- if shown == 0 -%}
    <div class="lc__empty">Collections are coming online soon.</div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}
