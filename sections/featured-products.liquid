        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "sub", "label": "Subtitle", "default": "Mosaic" },
        { "type": "text", "id": "title", "label": "Title", "default": "Mosaic Artwork" },
        { "type": "text", "id": "price", "label": "Price", "default": "From $1,200" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
