{%- comment -%} Bestsellers grid: hand-picked Product blocks, else a live collection. {%- endcomment -%}
{%- assign manual = section.blocks | where: 'type', 'product' -%}
{%- assign manual_count = manual | size -%}
<section class="bestsellers page-width">
  <div class="bestsellers__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: section.settings.collection.url | default: routes.all_products_collection_url }}" class="btn btn--ghost">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  <div class="bestsellers__grid" style="grid-template-columns: repeat({{ section.settings.columns }}, 1fr);">
    {%- if manual_count > 0 -%}
      {%- for block in manual -%}
        <a href="{{ block.settings.link | default: '#' }}" class="prod-card" {{ block.shopify_attributes }}>
          <div class="prod-card__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="600" height="750" class="prod-img cover-img" loading="lazy">
            {%- elsif block.settings.image_file != blank -%}
              <img src="{{ block.settings.image_file | asset_url }}" alt="{{ block.settings.title | escape }}" width="600" height="750" class="prod-img cover-img" loading="lazy">
            {%- elsif block.settings.image_url != blank -%}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape }}" width="600" height="750" class="prod-img cover-img" loading="lazy" referrerpolicy="no-referrer">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'prod-img cover-img' }}
            {%- endif -%}
          </div>
          {%- if block.settings.sub != blank -%}<div class="prod-card__sub">{{ block.settings.sub }}</div>{%- endif -%}
          <div class="prod-title prod-card__title">{{ block.settings.title }}</div>
          {%- if block.settings.price != blank -%}<div class="prod-card__price">{{ block.settings.price }}</div>{%- endif -%}
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- assign products_to_show = section.settings.collection.products | default: collections.all.products -%}
      {%- for product in products_to_show limit: section.settings.product_limit -%}
        {% render 'card-product', product: product %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  .bestsellers { padding-top: 90px; padding-bottom: 100px; }
  .bestsellers__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 46px; flex-wrap: wrap; }
  .bestsellers__grid { display: grid; gap: 28px 22px; }
  .prod-card { display: block; }
  .prod-card__media { position: relative; overflow: hidden; aspect-ratio: 4/5; background: var(--color-light-text); margin-bottom: 16px; }
  .prod-card__badge { position: absolute; top: 14px; left: 14px; background: #fff; color: var(--color-blue); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; padding: 6px 11px; }
  .prod-card__sub { font-family: var(--font-accent); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 6px; }
  .prod-card__title { font-family: var(--font-display); font-size: 23px; line-height: 1.15; color: var(--color-navy); margin-bottom: 8px; }
  .prod-card__price { font-size: 14px; color: var(--color-text-muted); letter-spacing: .02em; }
  @media (max-width: 990px) { .bestsellers__grid { grid-template-columns: repeat(2, 1fr) !important; } }
  @media (max-width: 600px) { .bestsellers { padding-top: 60px; padding-bottom: 70px; } }
</style>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collector's Favorites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Iconic Mosaic Masterpieces" },
    { "type": "paragraph", "content": "Add Product blocks for a hand-picked grid, or leave empty and pick a Collection to show live products." },
    { "type": "collection", "id": "collection", "label": "Collection (used if no Product blocks)" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns", "min": 3, "max": 4, "step": 1, "label": "Columns", "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All Mosaics" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (upload — overrides below)" },
