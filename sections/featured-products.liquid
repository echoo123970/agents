        { "type": "product", "settings": { "image_file": "flower-vase.jpg", "sub": "Floral Mosaic", "title": "Luxury Flower Vase", "price": "From $1,150", "link": "/products/flower-mosaics-luxury-mosaic-flowers-vase" } },
        { "type": "product", "settings": { "image_url": "https://www.imosaicart.com/cdn/shop/files/MAS081_b2d557a7-36fa-418b-b736-ec6f27f75af3.jpg?width=600", "sub": "Landscape Mosaic", "title": "Coastal Horizon", "price": "From $2,200", "link": "/collections/landscape-mosaics" } },
        { "type": "product", "settings": { "image_file": "bird-peacock.jpg", "sub": "Bird Mosaic", "title": "Vivid Peacock", "price": "From $980", "link": "/products/bird-mosaics-vivid-colorful-mosaic-mosaic-wall-art" } },
        { "type": "product", "settings": { "image_url": "https://www.imosaicart.com/cdn/shop/files/MAT053_-_60cm_x_85cm_8343d742-e897-4c91-b648-f7480e0e8ee5.jpg?width=600", "sub": "Tree Mosaic", "title": "Olive Grove", "price": "From $1,260", "link": "/collections/tree-mosaics" } },
        { "type": "product", "settings": { "image_file": "religious-lady-jesus.png", "sub": "Religious Mosaic", "title": "Our Lady & Baby Jesus", "price": "From $1,320", "link": "/products/religious-mosaics-religious-mosaic-art-our-lady-baby-jesus" } },
