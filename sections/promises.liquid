<section class="promises page-width">
  <div class="promises__head">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
  </div>
  <div class="promises__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="promises__item" {{ block.shopify_attributes }}>
          <div class="promises__icon">{{ block.settings.icon }}</div>
          <h3 class="promises__title">{{ block.settings.title }}</h3>
          <p class="promises__desc">{{ block.settings.desc }}</p>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- assign p_icons = section.settings.default_icons | split: '|' -%}
      {%- assign p_titles = section.settings.default_titles | split: '|' -%}
      {%- assign p_descs = section.settings.default_descs | split: '|' -%}
      {%- for t in p_titles -%}
        <div class="promises__item">
          <div class="promises__icon">{{ p_icons[forloop.index0] | strip }}</div>
          <h3 class="promises__title">{{ t | strip }}</h3>
          <p class="promises__desc">{{ p_descs[forloop.index0] | strip }}</p>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  .promises { padding-top: 128px; padding-bottom: 128px; }
  .promises__head { text-align: center; margin-bottom: 56px; }
  .promises__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; }
  .promises__item { padding: 0 32px; text-align: center; border-left: 1px solid var(--color-line); }
  .promises__item:first-child { border-left: none; }
  .promises__icon { width: 54px; height: 54px; border-radius: 50%; border: 1px solid var(--color-blue); color: var(--color-blue); display: flex; align-items: center; justify-content: center; margin: 0 auto 22px; font-size: 22px; }
  .promises__title { font-family: var(--font-display); font-weight: 600; font-size: 22px; margin-bottom: 12px; color: var(--color-navy); }
  .promises__desc { font-size: 14px; line-height: 1.65; color: var(--color-text-muted); }
  @media (max-width: 990px) {
    .promises { padding-top: 80px; padding-bottom: 80px; }
    .promises__grid { grid-template-columns: 1fr 1fr; gap: 40px 0; }
    .promises__item:nth-child(odd) { border-left: none; }
  }
  @media (max-width: 600px) {
    .promises__grid { grid-template-columns: 1fr; }
    .promises__item { border-left: none; }
  }
</style>

{% schema %}
{
  "name": "Promises",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where Timeless Craft Meets Precision" },
    { "type": "paragraph", "content": "Shown when no Promise blocks are added. Pipe-separated (|), in matching order." },
    { "type": "textarea", "id": "default_icons", "label": "Default icons", "default": "✦|↺|✈|◈|♦" },
    { "type": "textarea", "id": "default_titles", "label": "Default titles", "default": "Premium Craft|Satisfaction Promise|Safe Worldwide Ship|Easy & Secure Pay|Lifetime Warranty" },
    { "type": "textarea", "id": "default_descs", "label": "Default descriptions", "default": "Mosaics handcrafted from the finest stones and glass tiles for lasting beauty.|Love it or return it — 100% satisfaction or your money back.|Carefully packed to ensure your mosaic arrives in perfect condition.|Multiple payment options with a fast, secure checkout.|Every mosaic is backed by a lifetime warranty, protecting your investment for years to come." }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Craft" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "Mosaics handcrafted from the finest stones and glass tiles for lasting beauty." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promises",
      "blocks": [
        { "type": "promise", "settings": { "icon": "✦", "title": "Premium Craft", "desc": "Mosaics handcrafted from the finest stones and glass tiles for lasting beauty." } },
        { "type": "promise", "settings": { "icon": "↺", "title": "Satisfaction Promise", "desc": "Love it or return it — 100% satisfaction or your money back." } },
        { "type": "promise", "settings": { "icon": "✈", "title": "Safe Worldwide Ship", "desc": "Carefully packed to ensure your mosaic arrives in perfect condition." } },
        { "type": "promise", "settings": { "icon": "◈", "title": "Easy & Secure Pay", "desc": "Multiple payment options with a fast, secure checkout." } },
        { "type": "promise", "settings": { "icon": "♦", "title": "Lifetime Warranty", "desc": "Every mosaic is backed by a lifetime warranty, protecting your investment for years to come." } }
      ]
    }
  ]
}
{% endschema %}
