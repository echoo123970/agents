<footer class="site-footer" role="contentinfo">
  <div class="page-width site-footer__top">
    <div class="site-footer__brand">
      <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="{{ shop.name | escape }} — home">
        {%- if settings.logo_light != blank -%}
          <img src="{{ settings.logo_light | image_url: width: 200 }}" alt="{{ shop.name | escape }}" width="40" height="40">
        {%- else -%}
          <img src="{{ 'mark-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="40" height="40">
        {%- endif -%}
        <span class="site-footer__name">iMosaic<span class="site-footer__name-accent">Art</span></span>
      </a>
      {%- if section.settings.about_text != blank -%}
        <p class="site-footer__about">{{ section.settings.about_text }}</p>
      {%- endif -%}
      <div class="site-footer__contact">
        {%- if section.settings.phone != blank -%}
          <div class="site-footer__contact-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-blue)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8.1 9.6a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2z"/></svg>
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="footer-link">{{ section.settings.phone }}</a>
          </div>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <div class="site-footer__contact-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-blue)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
            <a href="mailto:{{ section.settings.email }}" class="footer-link">{{ section.settings.email }}</a>
          </div>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <div class="site-footer__contact-row site-footer__contact-row--top">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-blue)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px;"><path d="M20 10c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{{ section.settings.address }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- assign menu_cols = section.blocks | where: 'type', 'menu_column' -%}
    {%- if menu_cols.size > 0 -%}
      {%- for block in menu_cols -%}
        <div class="site-footer__col" {{ block.shopify_attributes }}>
          <div class="site-footer__col-title">{{ block.settings.heading }}</div>
          <div class="site-footer__col-links">
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="site-footer__col">
        <div class="site-footer__col-title">Explore</div>
        <div class="site-footer__col-links">
          <a href="{{ routes.all_products_collection_url }}" class="footer-link">Mosaics</a>
          <a href="/pages/portfolio-mosaics" class="footer-link">Portfolio</a>
          <a href="/pages/custom-mosaics" class="footer-link">Custom Mosaics</a>
          <a href="/pages/color-palette" class="footer-link">Color Palette</a>
          <a href="/pages/all-reviews" class="footer-link">Testimonials</a>
          <a href="/pages/imosaicart-loyalty-program" class="footer-link">Rewards Program</a>
          <a href="{{ blogs.news.url | default: '/blogs/news' }}" class="footer-link">Journal</a>
        </div>
      </div>
      <div class="site-footer__col">
        <div class="site-footer__col-title">Support</div>
        <div class="site-footer__col-links">
          <a href="/pages/installation-guide" class="footer-link">Installation Guide</a>
          <a href="/pages/frequently-asked-questions" class="footer-link">FAQ</a>
          <a href="/pages/shipping-policy" class="footer-link">Shipping Policy</a>
          <a href="/pages/refund-policy" class="footer-link">Returns &amp; Refunds</a>
          <a href="/pages/contact-us" class="footer-link">Contact Us</a>
        </div>
      </div>
      <div class="site-footer__col">
        <div class="site-footer__col-title">Company</div>
        <div class="site-footer__col-links">
          <a href="/pages/about-us" class="footer-link">About Us</a>
          <a href="/pages/privacy-policy" class="footer-link">Privacy Policy</a>
          <a href="/pages/terms-conditions" class="footer-link">Terms of Service</a>
          <a href="/pages/billing-terms-conditions" class="footer-link">Billing Terms</a>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="page-width site-footer__bottom">
    <span class="site-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <div class="site-footer__pay-icons" role="img" aria-label="Accepted payment methods">
      <span class="pay-ic" title="Visa"><svg viewBox="0 0 40 26" role="img" aria-label="Visa"><rect width="40" height="26" rx="4" fill="#fff"/><rect x=".5" y=".5" width="39" height="25" rx="3.5" fill="none" stroke="#E6E9EF"/><text x="20" y="17.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="10" font-style="italic" font-weight="700" fill="#1A1F71">VISA</text></svg></span>
      <span class="pay-ic" title="Mastercard"><svg viewBox="0 0 40 26" role="img" aria-label="Mastercard"><rect width="40" height="26" rx="4" fill="#fff"/><rect x=".5" y=".5" width="39" height="25" rx="3.5" fill="none" stroke="#E6E9EF"/><circle cx="16" cy="13" r="7" fill="#EB001B"/><circle cx="24" cy="13" r="7" fill="#F79E1B"/><path d="M20 7.7a7 7 0 0 0 0 10.6 7 7 0 0 0 0-10.6z" fill="#FF5F00"/></svg></span>
      <span class="pay-ic" title="American Express"><svg viewBox="0 0 40 26" role="img" aria-label="American Express"><rect width="40" height="26" rx="4" fill="#1F72CD"/><text x="20" y="16" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="7" font-weight="700" fill="#fff" letter-spacing=".3">AMEX</text></svg></span>
      <span class="pay-ic" title="PayPal"><svg viewBox="0 0 40 26" role="img" aria-label="PayPal"><rect width="40" height="26" rx="4" fill="#fff"/><rect x=".5" y=".5" width="39" height="25" rx="3.5" fill="none" stroke="#E6E9EF"/><text x="20" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9" font-style="italic" font-weight="700"><tspan fill="#003087">Pay</tspan><tspan fill="#009CDE">Pal</tspan></text></svg></span>
      <span class="pay-ic" title="Apple Pay"><svg viewBox="0 0 40 26" role="img" aria-label="Apple Pay"><rect width="40" height="26" rx="4" fill="#000"/><path d="M13.9 10.2c.3-.4.5-.9.4-1.5-.4 0-1 .3-1.3.7-.3.3-.5.9-.4 1.4.5 0 1-.3 1.3-.6zm.5.7c-.7 0-1.3.4-1.6.4-.4 0-.9-.4-1.4-.4-.7 0-1.4.4-1.7 1.1-.7 1.2-.2 3.1.5 4.1.3.5.7 1 1.2 1 .5 0 .7-.3 1.3-.3.6 0 .8.3 1.3.3.5 0 .9-.5 1.2-1 .2-.4.4-.7.4-.8-1-.4-1.2-1.9-.1-2.5-.3-.6-.9-1-1.8-1z" fill="#fff"/><text x="25" y="17" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9" font-weight="600" fill="#fff">Pay</text></svg></span>
      <span class="pay-ic" title="Google Pay"><svg viewBox="0 0 40 26" role="img" aria-label="Google Pay"><rect width="40" height="26" rx="4" fill="#fff"/><rect x=".5" y=".5" width="39" height="25" rx="3.5" fill="none" stroke="#E6E9EF"/><text x="20" y="16.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8" font-weight="700"><tspan fill="#4285F4">G</tspan><tspan fill="#EA4335">o</tspan><tspan fill="#FBBC04">o</tspan><tspan fill="#4285F4">g</tspan><tspan fill="#34A853">l</tspan><tspan fill="#EA4335">e</tspan><tspan fill="#5F6368"> Pay</tspan></text></svg></span>
    </div>
    <div class="site-footer__social">
      <a href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/i.mosaicart/' }}" class="social-btn social-btn--ig" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href="https://www.pinterest.com/iMosaicArt/" class="social-btn social-btn--pin" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.14 2C6.98 2 4 5.35 4 9.03c0 1.7.9 3.83 2.35 4.5.22.1.34.06.39-.16l.32-1.3c.03-.11.01-.2-.07-.3a3.9 3.9 0 0 1-.73-2.28c0-2.94 2.2-5.79 5.94-5.79 3.24 0 5.5 2.2 5.5 5.36 0 3.56-1.8 6.03-4.14 6.03-1.29 0-2.26-1.07-1.95-2.38.37-1.56 1.09-3.25 1.09-4.38 0-1.01-.54-1.85-1.66-1.85-1.32 0-2.37 1.36-2.37 3.18 0 1.16.39 1.94.39 1.94l-1.58 6.68c-.47 1.98-.07 4.41-.04 4.65.02.15.2.18.29.07.12-.16 1.67-2.07 2.2-3.98.15-.54.85-3.33.85-3.33.42.8 1.65 1.5 2.96 1.5 3.9 0 6.54-3.55 6.54-8.31C20.5 5.16 17.29 2 12.14 2z"/></svg>
      </a>
      <a href="{{ settings.social_facebook_link | default: 'https://www.facebook.com/profile.php?id=100094048131287' }}" class="social-btn social-btn--fb" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
      </a>
      <a href="{{ settings.social_youtube_link | default: 'https://www.youtube.com/@iMosaicArt' }}" class="social-btn social-btn--yt" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.19-.41-4.72a2.46 2.46 0 0 0-1.73-1.73C19.33 5.13 12 5.13 12 5.13s-7.33 0-8.86.42A2.46 2.46 0 0 0 1.41 7.28C1 8.81 1 12 1 12s0 3.19.41 4.72a2.46 2.46 0 0 0 1.73 1.73c1.53.42 8.86.42 8.86.42s7.33 0 8.86-.42a2.46 2.46 0 0 0 1.73-1.73C23 15.19 23 12 23 12zM9.75 15.27V8.73L15.4 12l-5.65 3.27z"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-navy-deep); color: var(--color-text-faint); }
  .site-footer__top {
    padding-top: 58px;
    padding-bottom: 40px;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 48px;
  }
  .site-footer__logo { display: flex; align-items: center; gap: 13px; margin-bottom: 20px; }
  .site-footer__name { font-family: var(--font-display); font-weight: 600; font-size: 26px; color: #fff; line-height: 1; }
  .site-footer__name-accent { font-style: italic; color: var(--color-blue-lighter); }
  .site-footer__about { font-size: 14px; line-height: 1.7; max-width: 320px; margin-bottom: 22px; }
  .site-footer__contact { font-size: 14px; color: var(--color-text-soft); display: flex; flex-direction: column; gap: 13px; }
  .site-footer__contact-row { display: flex; align-items: center; gap: 12px; }
  .site-footer__contact-row--top { align-items: flex-start; }
  .site-footer__contact-row span { max-width: 240px; }
  .site-footer__col-title {
    font-family: var(--font-accent);
    font-size: 13px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--color-bg);
    margin-bottom: 20px;
  }
  .site-footer__col-links { display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  .site-footer__bottom {
    padding-top: 24px;
    padding-bottom: 30px;
    border-top: 1px solid rgba(220,230,245,.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px 28px;
    flex-wrap: wrap;
    font-size: 13px;
  }
  .site-footer__copy { color: #7B879F; letter-spacing: .01em; }

  /* Accepted payment methods — sits in the centre of the bottom bar */
  .site-footer__pay-icons { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .pay-ic { display: inline-flex; transition: transform .2s ease; }
  .pay-ic:hover { transform: translateY(-2px); }
  .pay-ic svg { display: block; width: 40px; height: 26px; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,.32); }

  /* Social — each logo in its own brand colour, hover fills with it */
  .site-footer__social { display: flex; gap: 10px; }
  .social-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(220,230,245,.16);
    background: rgba(255,255,255,.04);
    transition: color .25s ease, background .25s ease, border-color .25s ease, transform .25s ease;
  }
  .social-btn svg { width: 17px; height: 17px; }
  .social-btn:hover { color: #fff; transform: translateY(-3px); }
  .social-btn--ig { color: #F06292; }
  .social-btn--ig:hover { background: linear-gradient(45deg,#F58529,#DD2A7B,#8134AF,#515BD4); border-color: transparent; }
  .social-btn--fb { color: #4C8DF5; }
  .social-btn--fb:hover { background: #1877F2; border-color: #1877F2; }
  .social-btn--yt { color: #FF4B4B; }
  .social-btn--yt:hover { background: #FF0000; border-color: #FF0000; }
  .social-btn--pin { color: #F14B5E; }
  .social-btn--pin:hover { background: #E60023; border-color: #E60023; }
  @media (max-width: 990px) {
    .site-footer__top { grid-template-columns: 1fr 1fr; gap: 36px; }
  }
  @media (max-width: 700px) {
    .site-footer__bottom { flex-direction: column; text-align: center; gap: 20px; padding-top: 26px; }
  }
  @media (max-width: 600px) {
    .site-footer__top { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Step into a world where art meets elegance — handcrafted mosaics woven into every space."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(315) 217-5538"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@imosaicart.com"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "28 Liberty St, New York, NY 10005, United States"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu_column", "settings": { "heading": "Explore" } },
        { "type": "menu_column", "settings": { "heading": "Support" } },
        { "type": "menu_column", "settings": { "heading": "Company" } }
      ]
    }
  ]
}
{% endschema %}
