    .ab-gallery__cta { text-align:center; margin-top:44px; }
    .ab-ghostbtn { display:inline-block; font-size:12.5px; letter-spacing:.16em; text-transform:uppercase; color:#16335E; border:1px solid rgba(22,51,94,.3); padding:15px 34px; transition:all .25s ease; }
    .ab-ghostbtn:hover { background:#2B7BE8; color:#fff; border-color:#2B7BE8; }

    .ab-promise { background:#EEF1F6; border-top:1px solid rgba(22,51,94,.08); }
    .ab-promise__inner { padding-top:100px; padding-bottom:100px; }
    .ab-promise__grid { display:grid; grid-template-columns:repeat(5,1fr); gap:0; }
    .ab-promise__col { padding:0 32px; text-align:center; border-left:1px solid rgba(22,51,94,.12); }
    .ab-promise__col:first-child { border-left:none; }
    .ab-promise__t { font-family:'Cormorant Garamond',serif; font-weight:600; font-size:21px; margin:0 0 12px; color:#16335E; }
    .ab-promise__d { font-size:14px; line-height:1.65; color:#5E6B85; margin:0; }

    .ab-quote { max-width:920px; margin:0 auto; padding:100px 40px; text-align:center; }
    .ab-quote__mark { color:#2B7BE8; font-size:46px; font-family:'Cormorant Garamond',serif; line-height:1; margin-bottom:18px; }
    .ab-quote__t { font-family:'Cormorant Garamond',serif; font-style:italic; font-weight:500; font-size:clamp(26px,3.2vw,38px); line-height:1.35; color:#16335E; margin:0 0 28px; }
    .ab-quote__by { font-size:13px; letter-spacing:.16em; text-transform:uppercase; color:#7E8AA0; }

    .ab-cta { background:#16335E; color:#DCE6F5; }
    .ab-cta__inner { display:flex; align-items:center; justify-content:space-between; gap:48px; flex-wrap:wrap; padding-top:84px; padding-bottom:84px; }
    .ab-cta__copy { max-width:620px; }
    .ab-cta__eyebrow { font-family:'Marcellus',serif; font-size:13px; letter-spacing:.36em; text-transform:uppercase; color:#7BB0F4; margin-bottom:18px; }
    .ab-cta__title { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:clamp(32px,3.8vw,50px); line-height:1.08; margin:0 0 16px; color:#fff; }
    .ab-cta__text { font-size:16px; line-height:1.7; color:#9AA4B8; margin:0; }
    .ab-cta__actions { display:flex; gap:14px; flex-wrap:wrap; }
    .ab-cta__btn { font-size:13px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; padding:18px 36px; white-space:nowrap; transition:all .25s ease; }
    .ab-cta__btn--blue { background:#2B7BE8; color:#fff; }
    .ab-cta__btn--blue:hover { background:#5C9AF0; }
    .ab-cta__btn--ghost { background:transparent; color:#fff; border:1px solid rgba(220,230,245,.4); }
    .ab-cta__btn--ghost:hover { background:rgba(255,255,255,.1); }

    @media (max-width:990px) {
      .ab-hero__grid, .ab-story__grid { grid-template-columns:1fr; gap:40px; }
      .ab-story__grid { padding:70px 0; }
      .ab-hero__media { min-height:420px; }
      .ab-stats__grid { grid-template-columns:repeat(2,1fr); gap:34px 24px; }
      .ab-pillars__grid { grid-template-columns:1fr; gap:48px; }
