</div>

<style>
  .cmx { background:#F4F6FA; color:#16335E; }
  .cmx-wrap { max-width:1320px; margin:0 auto; padding:0 40px; }
  .cmx-i { font-style:italic; color:#2B7BE8; }
  .cmx-eyebrow { display:flex; align-items:center; gap:12px; margin-bottom:26px; font-family:'Marcellus',serif; font-size:13px; letter-spacing:.36em; text-transform:uppercase; color:#16335E; }
  .cmx-eyebrow__ln { width:42px; height:1px; background:#2B7BE8; }
  .cmx-kicker { font-family:'Marcellus',serif; font-size:13px; letter-spacing:.36em; text-transform:uppercase; color:#16335E; margin-bottom:14px; }
  .cmx-kicker--light { color:#7BB0F4; }
  .cmx-h2 { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:clamp(32px,4vw,52px); line-height:1.05; margin:0; color:#16335E; }
  .cmx-h2--light { color:#fff; }
  .cmx-center { text-align:center; margin-bottom:56px; }
  .cmx-ico { width:56px; height:56px; border-radius:50%; border:1px solid #2B7BE8; color:#2B7BE8; display:flex; align-items:center; justify-content:center; margin:0 auto 22px; }
  .cm-zoom { overflow:hidden; }
  .cm-zoom img { transition:transform .8s cubic-bezier(.2,.7,.2,1); }
  .cm-zoom:hover img { transform:scale(1.08); }

  .cmx-hero__grid { display:grid; grid-template-columns:1.02fr 1fr; gap:64px; align-items:center; padding:64px 0 72px; }
  .cmx-hero__title { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:clamp(44px,5vw,74px); line-height:1.02; letter-spacing:-.01em; margin:0 0 26px; color:#16335E; }
  .cmx-hero__text { font-size:17px; line-height:1.7; color:#5E6B85; max-width:520px; margin:0 0 36px; }
  .cmx-hero__ctas { display:flex; gap:16px; }
  .cmx-btn { flex:1; justify-content:center; font-size:13px; letter-spacing:.14em; text-transform:uppercase; padding:17px 28px; display:inline-flex; align-items:center; white-space:nowrap; transition:all .25s ease; }
  .cmx-btn--dark { background:#16335E; color:#F4F6FA; border:1px solid #16335E; }
  .cmx-btn--dark:hover { background:#22467E; border-color:#22467E; }
  .cmx-btn--outline { background:transparent; color:#16335E; border:1px solid rgba(22,51,94,.35); }
  .cmx-btn--outline:hover { background:#16335E; color:#F4F6FA; border-color:#16335E; }
  .cmx-hero__media { position:relative; align-self:stretch; min-height:620px; }
  .cmx-hero__img { position:absolute; inset:0; background:#DCE6F5; }
  .cmx-hero__img img { width:100%; height:100%; object-fit:cover; }
  .cmx-hero__badge { position:absolute; left:-30px; bottom:46px; background:#fff; padding:22px 26px; box-shadow:0 24px 60px rgba(22,51,94,.18); max-width:248px; }
