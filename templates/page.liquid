          <div class="ab-promise__col"><div class="ab-ico ab-ico--sm"><svg class="ab-ico__svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M8.5 12.5L7 22l5-3 5 3-1.5-9.5"/></svg></div><h3 class="ab-promise__t">Lifetime Warranty</h3><p class="ab-promise__d">Every mosaic is backed by a lifetime warranty, protecting your investment for years to come.</p></div>
      </div>
    </div></section>

    <!-- QUOTE -->
    <section class="ab-quote">
      <div class="ab-quote__mark">&ldquo;</div>
      <p class="ab-quote__t">We don't just make mosaics. We preserve a craft that has survived for millennia, one handcut tile at a time — so a piece of it can live in your home.</p>
      <div class="ab-quote__by">The iMosaicArt Studio</div>
    </section>

    <!-- CTA BAND -->
    <section class="ab-cta"><div class="ab-container ab-cta__inner">
      <div class="ab-cta__copy">
        <div class="ab-cta__eyebrow">Begin Your Piece</div>
        <h2 class="ab-cta__title">Bring a timeless work of art into your space.</h2>
        <p class="ab-cta__text">Browse our handcrafted collection or commission a one-of-a-kind mosaic designed around your vision — with free worldwide shipping on every order.</p>
      </div>
      <div class="ab-cta__actions">
        <a href="{{ routes.all_products_collection_url }}" class="ab-cta__btn ab-cta__btn--blue">Shop Mosaics</a>
        <a href="{{ cm_url }}" class="ab-cta__btn ab-cta__btn--ghost">Start a Commission</a>
      </div>
    </div></section>
  </div>

  <style>
    .ab { background:#F4F6FA; color:#16335E; }
    .ab-container { max-width:1320px; margin:0 auto; padding:0 40px; }
    .ab-eyebrow { display:flex; align-items:center; gap:12px; margin-bottom:26px; font-family:'Marcellus',serif; font-size:13px; letter-spacing:.36em; text-transform:uppercase; color:#16335E; }
    .ab-eyebrow__ln { width:42px; height:1px; background:#2B7BE8; }
    .ab-i { font-style:italic; color:#2B7BE8; }
    .ab-kicker { font-family:'Marcellus',serif; font-size:13px; letter-spacing:.36em; text-transform:uppercase; color:#16335E; margin-bottom:18px; }
    .ab-h2 { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:clamp(32px,3.8vw,50px); line-height:1.08; margin:0 0 24px; color:#16335E; }
    .ab-h2--c { margin:0; }
    .ab-center { text-align:center; margin-bottom:56px; }
    .ab-center .ab-kicker { margin-bottom:14px; }
    .ab-ico { width:58px; height:58px; border-radius:50%; border:1px solid #2B7BE8; color:#2B7BE8; display:flex; align-items:center; justify-content:center; margin:0 auto 24px; }
    .ab-ico--sm { width:54px; height:54px; margin-bottom:22px; }

    .ab-hero__grid { display:grid; grid-template-columns:1.02fr 1fr; gap:64px; align-items:center; padding:64px 0 76px; }
    .ab-hero__title { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:clamp(44px,5vw,74px); line-height:1.02; letter-spacing:-.01em; margin:0 0 26px; color:#16335E; }
    .ab-hero__text { font-size:17px; line-height:1.75; color:#5E6B85; max-width:520px; margin:0 0 36px; }
    .ab-hero__ctas { display:flex; gap:16px; flex-wrap:wrap; }
    .ab-btn { min-width:230px; justify-content:center; font-size:13px; letter-spacing:.14em; text-transform:uppercase; padding:17px 36px; display:inline-flex; align-items:center; transition:all .25s ease; }
    .ab-btn--dark { background:#16335E; color:#F4F6FA; border:1px solid #16335E; }
    .ab-btn--dark:hover { background:#22467E; border-color:#22467E; }
    .ab-btn--outline { background:transparent; color:#16335E; border:1px solid rgba(22,51,94,.35); }
    .ab-btn--outline:hover { background:#16335E; color:#F4F6FA; border-color:#16335E; }
    .ab-hero__media { position:relative; }
    .ab-hero__img { position:relative; overflow:hidden; background:#DCE6F5; }
    .ab-hero__img img { width:100%; height:auto; display:block; }
    .ab-hero__badge { position:absolute; left:-30px; top:50%; transform:translateY(-50%); background:#FFFFFF; padding:22px 26px; box-shadow:0 24px 60px rgba(22,51,94,.18); max-width:240px; }
    .ab-hero__badge-n { font-family:'Cormorant Garamond',serif; font-size:38px; line-height:1; color:#16335E; font-variant-numeric:lining-nums; font-feature-settings:"lnum" 1; }
    .ab-hero__badge-l { font-size:12.5px; letter-spacing:.1em; text-transform:uppercase; color:#7E8AA0; margin-top:8px; }

    .ab-stats { background:#16335E; color:#DCE6F5; }
    .ab-stats__grid { display:grid; grid-template-columns:repeat(4,1fr); gap:24px; padding:46px 0; }
    .ab-stat { text-align:center; }
    .ab-stat__n { font-family:'Cormorant Garamond',serif; font-size:clamp(34px,3.4vw,46px); line-height:1; color:#fff; font-variant-numeric:lining-nums; font-feature-settings:"lnum" 1; }
    .ab-stat__l { font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:#9AA4B8; margin-top:10px; }

    .ab-story__grid { display:grid; grid-template-columns:1fr 1.05fr; gap:72px; align-items:center; padding:104px 0; }
    .ab-story__img { position:relative; overflow:hidden; background:#DCE6F5; }
    .ab-story__img img { width:100%; height:auto; display:block; }
    .ab-hero__img img, .ab-story__img img { transition:transform .7s cubic-bezier(.2,.7,.2,1); }
    .ab-hero__img:hover img, .ab-story__img:hover img { transform:scale(1.05); }
    .ab-story__p { font-size:16px; line-height:1.78; color:#5E6B85; margin:0 0 20px; }
    .ab-story__p:last-child { margin-bottom:0; }

    .ab-pillars { background:#fff; border-top:1px solid rgba(22,51,94,.08); border-bottom:1px solid rgba(22,51,94,.08); }
    .ab-pillars__inner { padding-top:100px; padding-bottom:100px; }
    .ab-pillars__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:0; }
    .ab-pillar { padding:0 40px; text-align:center; border-left:1px solid rgba(22,51,94,.1); }
    .ab-pillar:first-child { border-left:none; }
    .ab-pillar__t { font-family:'Cormorant Garamond',serif; font-weight:600; font-size:24px; margin:0 0 14px; color:#16335E; }
    .ab-pillar__d { font-size:14.5px; line-height:1.7; color:#5E6B85; margin:0; }

    .ab-gallery { padding:100px 0 80px; }
    .ab-gallery__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
    .ab-gtile { position:relative; overflow:hidden; aspect-ratio:4/5; background:#DCE6F5; }
    .ab-gtile img { width:100%; height:100%; object-fit:cover; transition:transform .65s cubic-bezier(.2,.7,.2,1); }
    .ab-gtile:hover img { transform:scale(1.05); }
    .ab-gallery__cta { text-align:center; margin-top:44px; }
    .ab-ghostbtn { display:inline-block; font-size:12.5px; letter-spacing:.16em; text-transform:uppercase; color:#16335E; border:1px solid rgba(22,51,94,.3); padding:15px 34px; transition:all .25s ease; }
    .ab-ghostbtn:hover { background:#2B7BE8; color:#fff; border-color:#2B7BE8; }

    .ab-promise { background:#EEF1F6; border-top:1px solid rgba(22,51,94,.08); }
    .ab-promise__inner { padding-top:100px; padding-bottom:100px; }
    .ab-promise__grid { display:grid; grid-template-columns:repeat(5,1fr); gap:0; }
    .ab-promise__col { padding:0 32px; text-align:center; border-left:1px solid rgba(22,51,94,.12); }
    .ab-promise__col:first-child { border-left:none; }
    .ab-promise__t { font-family:'Cormorant Garamond',serif; font-weight:600; font-size:21px; margin:0 0 12px; color:#16335E; }
    .ab-promise__d { font-size:14px; line-height:1.65; color:#5E6B85; margin:0; }

    .ab-quote { max-width:920px; margin:0 auto; padding:100px 40px; text-align:center; }
    .ab-quote__mark { color:#2B7BE8; font-size:46px; font-family:'Cormorant Garamond',serif; line-height:1; margin-bottom:18px; }
    .ab-quote__t { font-family:'Cormorant Garamond',serif; font-style:italic; font-weight:500; font-size:clamp(26px,3.2vw,38px); line-height:1.35; color:#16335E; margin:0 0 28px; }
    .ab-quote__by { font-size:13px; letter-spacing:.16em; text-transform:uppercase; color:#7E8AA0; }

    .ab-cta { background:#16335E; color:#DCE6F5; }
    .ab-cta__inner { display:flex; align-items:center; justify-content:space-between; gap:48px; flex-wrap:wrap; padding-top:84px; padding-bottom:84px; }
    .ab-cta__copy { max-width:620px; }
    .ab-cta__eyebrow { font-family:'Marcellus',serif; font-size:13px; letter-spacing:.36em; text-transform:uppercase; color:#7BB0F4; margin-bottom:18px; }
    .ab-cta__title { font-family:'Cormorant Garamond',serif; font-weight:500; font-size:clamp(32px,3.8vw,50px); line-height:1.08; margin:0 0 16px; color:#fff; }
    .ab-cta__text { font-size:16px; line-height:1.7; color:#9AA4B8; margin:0; }
    .ab-cta__actions { display:flex; gap:14px; flex-wrap:wrap; }
    .ab-cta__btn { font-size:13px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; padding:18px 36px; white-space:nowrap; transition:all .25s ease; }
    .ab-cta__btn--blue { background:#2B7BE8; color:#fff; }
    .ab-cta__btn--blue:hover { background:#5C9AF0; }
    .ab-cta__btn--ghost { background:transparent; color:#fff; border:1px solid rgba(220,230,245,.4); }
    .ab-cta__btn--ghost:hover { background:rgba(255,255,255,.1); }

    .ab { overflow-x: clip; }
    @media (max-width:1100px) {
      .ab-hero__grid { gap:44px; }
      .ab-story__grid { gap:48px; }
    }
    @media (max-width:990px) {
      .ab-hero__grid, .ab-story__grid { grid-template-columns:1fr; gap:40px; }
      .ab-story__grid { padding:70px 0; }
      .ab-hero__media { min-height:0; }
      .ab-stats__grid { grid-template-columns:repeat(2,1fr); gap:34px 24px; }
      .ab-pillars__grid { grid-template-columns:1fr; gap:48px; }
      .ab-pillar { border-left:none; }
      .ab-promise__grid { grid-template-columns:repeat(3,1fr); gap:44px 24px; }
      .ab-promise__col { border-left:none; }
      .ab-gallery__grid { grid-template-columns:repeat(2,1fr); }
      .ab-pillars__inner, .ab-promise__inner { padding-top:70px; padding-bottom:70px; }
    }
    @media (max-width:600px) {
      .ab-container { padding:0 22px; }
      .ab-hero__grid { padding:40px 0 52px; }
      .ab-hero__media { min-height:0; }
      .ab-hero__badge { left:16px; top:auto; bottom:16px; transform:none; padding:15px 18px; max-width:200px; }
      .ab-hero__badge-n { font-size:32px; }
      .ab-hero__ctas { flex-direction:column; }
      .ab-btn { min-width:0; width:100%; }
      .ab-stats__grid { grid-template-columns:repeat(2,1fr); gap:26px 16px; padding:36px 0; }
      .ab-promise__grid { grid-template-columns:1fr 1fr; gap:34px 20px; }
      .ab-gallery__grid { grid-template-columns:1fr; }
      .ab-quote { padding:64px 22px; }
      .ab-cta__inner { padding-top:56px; padding-bottom:56px; }
      .ab-cta__actions { width:100%; }
      .ab-cta__btn { flex:1; text-align:center; }
    }
    @media (max-width:400px) {
      .ab-stats__grid, .ab-promise__grid { grid-template-columns:1fr; }
    }
  </style>
{%- elsif ph == 'custom-mosaics' or ph == 'custom-mosaic-art' or ph == 'custom-mosaic' -%}
{%- comment -%} Custom Mosaics page — full static design (identical to Claude design). Uses Shopify contact form so submissions are delivered. {%- endcomment -%}
<div class="cmx">
  <!-- HERO -->
  <section class="cmx-hero"><div class="cmx-wrap">
    <div class="cmx-hero__grid">
      <div class="cmx-hero__copy">
        <div class="cmx-eyebrow"><span class="cmx-eyebrow__ln"></span>Bespoke Commissions</div>
        <h1 class="cmx-hero__title">If You Can Imagine It,<br>We Can Hand-cut It<br><span class="cmx-i">in Stone.</span></h1>
        <p class="cmx-hero__text">Personalize any design, reimagine a piece you love, or bring us a concept entirely your own. Our master artisans and in-house interior designers turn your vision into a one-of-a-kind marble and glass mosaic — tailored to your space, down to the last tessera.</p>
        <div class="cmx-hero__ctas">
          <a href="#cmx-form" class="cmx-btn cmx-btn--dark">Start Your Commission</a>
          <a href="#cmx-process" class="cmx-btn cmx-btn--outline">See the Process</a>
        </div>
      </div>
      <div class="cmx-hero__media">
        <div class="cmx-hero__img cm-zoom"><img src="{{ 'custom-flower-vase-room.jpg' | asset_url }}" alt="Custom mosaic commission" loading="eager"></div>
        <div class="cmx-hero__badge">
          <div class="cmx-hero__badge-k">Designed With You</div>
          <div class="cmx-hero__badge-t">Guided by our in-house interior designers.</div>
        </div>
      </div>
    </div>
  </div></section>

  <!-- CAPABILITIES -->
  <section class="cmx-cap"><div class="cmx-wrap cmx-cap__inner">
    <div class="cmx-center"><div class="cmx-kicker">Endless Possibilities</div><h2 class="cmx-h2 cmx-h2--c">Customize Anything, Down To The Detail</h2></div>
    <div class="cmx-cap__grid">
          <div class="cmx-cap__col"><div class="cmx-ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg></div><h3 class="cmx-cap__t">Personalize Any Design</h3><p class="cmx-cap__d">Start from any piece in our catalog and make it yours — your colors, your size, your finish.</p></div>
          <div class="cmx-cap__col"><div class="cmx-ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div><h3 class="cmx-cap__t">Modify A Piece You Love</h3><p class="cmx-cap__d">Found a design that is almost perfect? Tell us the changes and we will adapt it to your taste.</p></div>
          <div class="cmx-cap__col"><div class="cmx-ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div><h3 class="cmx-cap__t">Bring Your Own Concept</h3><p class="cmx-cap__d">Send a photo, painting or sketch and our artists will transform it into stone and glass.</p></div>
          <div class="cmx-cap__col"><div class="cmx-ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></div><h3 class="cmx-cap__t">Guided By Designers</h3><p class="cmx-cap__d">Our in-house interior designers help with palette, scale and placement at no extra cost.</p></div>
    </div>
  </div></section>

  <!-- PROCESS -->
  <section id="cmx-process" class="cmx-proc"><div class="cmx-wrap cmx-proc__inner">
    <div class="cmx-center"><div class="cmx-kicker cmx-kicker--light">How It Works</div><h2 class="cmx-h2 cmx-h2--c cmx-h2--light">From Your Idea To Your Wall</h2></div>
    <div class="cmx-proc__grid">
          <div class="cmx-step"><div class="cmx-step__n">01</div><div class="cmx-step__t">Share Your Vision</div><div class="cmx-step__d">Send a photo, sketch or idea with your desired dimensions through the form below.</div></div>
          <div class="cmx-step"><div class="cmx-step__n">02</div><div class="cmx-step__t">Design &amp; Quote</div><div class="cmx-step__d">Our designers draft your piece, confirm materials and palette, and send a tailored quote.</div></div>
          <div class="cmx-step"><div class="cmx-step__n">03</div><div class="cmx-step__t">Hand-Cut In Stone</div><div class="cmx-step__d">Once approved, master artisans place thousands of tesserae by hand in our studio.</div></div>
          <div class="cmx-step"><div class="cmx-step__n">04</div><div class="cmx-step__t">Delivered To You</div><div class="cmx-step__d">Your finished mosaic is crated, insured and shipped free, anywhere in the world.</div></div>
    </div>
  </div></section>

  <!-- INTERIOR DESIGNER -->
  <section class="cmx-desg"><div class="cmx-wrap">
    <div class="cmx-desg__grid">
      <div class="cmx-desg__img cm-zoom"><img src="{{ 'install-finish-hands.jpg' | asset_url }}" alt="Master artisan hand-placing tesserae" loading="lazy"></div>
      <div class="cmx-desg__copy">
        <div class="cmx-kicker">Design Consultation</div>
        <h2 class="cmx-h2">Work Hand In Hand With Our Interior Designers</h2>
        <p class="cmx-desg__p">Not sure where to start? Our in-house interior designers help you choose the right subject, palette, scale and placement so your mosaic feels made for the room — because it is. Every commission begins with a complimentary design consultation.</p>
        <div class="cmx-desg__points">
            <div class="cmx-point"><span class="cmx-point__ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="10.5" r="2.5"/><circle cx="8.5" cy="7.5" r="2.5"/><path d="M12 22a10 10 0 1 1 0-20 8 8 0 0 1 0 16h-1.5a1.5 1.5 0 0 0 0 4z"/></svg></span><div class="cmx-point__tx"><span class="cmx-point__t">Palette matching</span><span class="cmx-point__d"> — we tune the stone and glass tones to your room.</span></div></div>
            <div class="cmx-point"><span class="cmx-point__ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 3 3 21"/><path d="M21 3v6h-6"/><path d="M3 21v-6h6"/></svg></span><div class="cmx-point__tx"><span class="cmx-point__t">Perfect proportions</span><span class="cmx-point__d"> — sized precisely for your wall, floor or feature.</span></div></div>
            <div class="cmx-point"><span class="cmx-point__ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-10a7 7 0 0 1 14 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="10" r="2.5"/></svg></span><div class="cmx-point__tx"><span class="cmx-point__t">Placement advice</span><span class="cmx-point__d"> — lighting, framing and installation guidance.</span></div></div>
            <div class="cmx-point"><span class="cmx-point__ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><div class="cmx-point__tx"><span class="cmx-point__t">Free consultation</span><span class="cmx-point__d"> — every commission starts with expert guidance.</span></div></div>
        </div>
      </div>
    </div>
  </div></section>

  <!-- FORM -->
  <section id="cmx-form" class="cmx-formsec"><div class="cmx-wrap cmx-formsec__inner">
    <div class="cmx-center">
      <div class="cmx-kicker">Start The Conversation</div>
      <h2 class="cmx-h2 cmx-h2--c">Let's Create Your Dream Mosaic</h2>
      <p class="cmx-formsec__sub">Share your vision below — a photo, a sketch or just an idea and your dimensions. Our team replies within one business day with a tailored design and quote.</p>
    </div>

    {%- form 'contact', id: 'CmxForm', class: 'cmx-form', enctype: 'multipart/form-data' -%}
      {%- if form.posted_successfully? -%}
        <div class="cmx-form__success">
          <div class="cmx-form__success-ic">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7BB0F4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"/></svg>
          </div>
          <h3 class="cmx-form__success-t">Thank you — your vision is on its way.</h3>
          <p class="cmx-form__success-p">One of our designers will be in touch within one business day to begin shaping your custom mosaic.</p>
        </div>
      {%- else -%}
        {%- if form.errors -%}<div class="cmx-form__err">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="cmx-form__row cmx-form__row--2">
          <div class="cmx-field"><label class="cmx-label">Name <span class="cmx-req">*</span></label><input class="cm-input" name="contact[name]" type="text" required placeholder="Your full name"></div>
