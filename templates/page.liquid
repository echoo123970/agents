  .cmx-hero__badge-t { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:22px; line-height:1.25; color:#16335E; }

  .cmx-cap { background:#fff; border-top:1px solid rgba(22,51,94,.08); border-bottom:1px solid rgba(22,51,94,.08); }
  .cmx-cap__inner { padding-top:96px; padding-bottom:96px; }
  .cmx-cap__grid { display:grid; grid-template-columns:repeat(4,1fr); gap:0; }
  .cmx-cap__col { padding:0 32px; text-align:center; border-left:1px solid rgba(22,51,94,.1); }
  .cmx-cap__col:first-child { border-left:none; }
  .cmx-cap__t { font-family:'Cormorant Garamond',serif; font-weight:600; font-size:22px; margin:0 0 12px; color:#16335E; }
  .cmx-cap__d { font-size:14px; line-height:1.65; color:#5E6B85; margin:0; }

  .cmx-proc { background:#16335E; color:#DCE6F5; }
  .cmx-proc__inner { padding-top:100px; padding-bottom:100px; }
  .cmx-proc__grid { display:grid; grid-template-columns:repeat(4,1fr); gap:28px; }
  .cmx-step { border-top:1px solid rgba(220,230,245,.18); padding-top:26px; }
  .cmx-step__n { font-family:'Cormorant Garamond',serif; font-size:42px; color:#7BB0F4; line-height:1; margin-bottom:18px; }
  .cmx-step__t { font-size:17px; font-weight:600; color:#fff; margin-bottom:10px; }
  .cmx-step__d { font-size:14px; line-height:1.65; color:#9AA4B8; }

  .cmx-desg__grid { display:grid; grid-template-columns:1fr 1.05fr; gap:70px; align-items:center; padding:100px 0; }
  .cmx-desg__img { position:relative; aspect-ratio:4/5; background:#DCE6F5; }
  .cmx-desg__img img { width:100%; height:100%; object-fit:cover; }
  .cmx-desg__p { font-size:16px; line-height:1.75; color:#5E6B85; max-width:500px; margin:22px 0 32px; }
  .cmx-desg__points { display:flex; flex-direction:column; gap:18px; }
  .cmx-point { display:flex; align-items:flex-start; gap:14px; }
  .cmx-point__ico { color:#2B7BE8; margin-top:2px; flex-shrink:0; display:flex; }
  .cmx-point__t { font-size:15.5px; font-weight:600; color:#16335E; }
  .cmx-point__d { font-size:14.5px; color:#5E6B85; }

  .cmx-formsec { background:#EEF1F6; border-top:1px solid rgba(22,51,94,.08); }
  .cmx-formsec__inner { max-width:1080px; padding-top:96px; padding-bottom:96px; }
  .cmx-formsec__sub { font-size:16px; line-height:1.7; color:#5E6B85; max-width:560px; margin:16px auto 0; }
  .cmx-form { background:#fff; padding:48px; box-shadow:0 30px 70px rgba(22,51,94,.1); }
  .cmx-form__row { display:grid; gap:22px; margin-bottom:22px; }
  .cmx-form__row--2 { grid-template-columns:1fr 1fr; }
  .cmx-form__row--3 { grid-template-columns:1fr 1fr 1fr; }
  .cmx-field { margin-bottom:22px; }
  .cmx-field--full { margin-bottom:22px; }
  .cmx-form__row .cmx-field { margin-bottom:0; }
  .cmx-label { display:block; font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:#46546E; margin-bottom:9px; }
  .cmx-req { color:#2B7BE8; }
  .cm-input { width:100%; font-family:'Hanken Grotesk',sans-serif; font-size:15px; color:#16335E; background:#fff; border:1px solid rgba(22,51,94,.18); padding:14px 16px; outline:none; transition:border-color .2s ease; }
  .cm-input:focus { border-color:#2B7BE8; }
  .cm-input::placeholder { color:#9AA4B8; }
  textarea.cm-input { resize:vertical; min-height:104px; }
  .cmx-upload { display:flex; align-items:center; gap:14px; border:1px dashed rgba(22,51,94,.3); background:#F8FAFD; padding:18px 20px; cursor:pointer; transition:all .2s ease; }
  .cmx-upload:hover { border-color:#2B7BE8; background:#F2F7FE; }
  .cmx-upload__label { font-size:14px; color:#5E6B85; }
  .cmx-form__foot { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap; }
  .cmx-field--cap { margin-bottom:0; }
  .cmx-field--cap .cm-input { width:160px; }
  .cmx-cap-err { display:none; margin-top:10px; font-size:13.5px; color:#C2724B; }
  .cmx-submit { background:#2B7BE8; color:#fff; border:none; font-family:'Hanken Grotesk',sans-serif; font-size:13px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; padding:17px 44px; cursor:pointer; transition:background .25s ease; }
  .cmx-submit:hover { background:#5C9AF0; }
  .cmx-form__err { margin-bottom:20px; font-size:13.5px; color:#C2724B; }
  .cmx-form__success { background:#fff; padding:64px 40px; text-align:center; box-shadow:0 30px 70px rgba(22,51,94,.1); }
  .cmx-form__success-ic { width:64px; height:64px; border-radius:50%; background:#16335E; display:flex; align-items:center; justify-content:center; margin:0 auto 24px; }
  .cmx-form__success-t { font-family:'Cormorant Garamond',serif; font-size:32px; margin:0 0 12px; color:#16335E; }
  .cmx-form__success-p { font-size:15.5px; line-height:1.7; color:#5E6B85; max-width:460px; margin:0 auto; }
  .cmx-contact { display:flex; align-items:center; justify-content:center; gap:30px; flex-wrap:wrap; margin-top:34px; font-size:13.5px; color:#5E6B85; }
  .cmx-contact__l { display:inline-flex; align-items:center; gap:9px; color:inherit; }
  .cmx-contact__l:hover { color:#2B7BE8; }
  .cmx-contact__dot { color:#C4CDDC; }

  @media (max-width:990px) {
    .cmx-hero__grid, .cmx-desg__grid { grid-template-columns:1fr; gap:40px; }
    .cmx-desg__grid { padding:70px 0; }
    .cmx-hero__media { min-height:440px; }
    .cmx-cap__grid { grid-template-columns:1fr 1fr; gap:44px 0; }
    .cmx-proc__grid { grid-template-columns:1fr 1fr; gap:32px; }
    .cmx-cap__inner, .cmx-proc__inner { padding-top:70px; padding-bottom:70px; }
  }
  @media (max-width:600px) {
    .cmx-wrap { padding:0 22px; }
    .cmx-hero__badge { left:16px; padding:18px 20px; }
    .cmx-cap__grid, .cmx-proc__grid { grid-template-columns:1fr; }
    .cmx-form { padding:30px 22px; }
    .cmx-form__row--2, .cmx-form__row--3 { grid-template-columns:1fr; }
  }
</style>

<script>
  (function () {
    var form = document.getElementById('CmxForm');
    if (!form) return;
    var qEl = form.querySelector('[data-cap-q]');
    var capIn = form.querySelector('[data-cap-input]');
    var errEl = form.querySelector('[data-cap-err]');
    var a = 3 + Math.floor(Math.random() * 5);
    var b = 2 + Math.floor(Math.random() * 5);
    if (qEl) qEl.textContent = a + ' + ' + b + ' =';
    form.addEventListener('submit', function (e) {
      if (capIn && parseInt((capIn.value || '').trim(), 10) !== a + b) {
        e.preventDefault();
        if (errEl) errEl.style.display = 'block';
        capIn.focus();
      }
    });
    var file = form.querySelector('[data-file]');
    var flabel = form.querySelector('[data-file-label]');
    if (file) file.addEventListener('change', function () {
      flabel.textContent = file.files && file.files[0] ? file.files[0].name : 'Click to upload an image (JPG, PNG)';
    });
  })();
</script>
{%- else -%}
  {% section 'main-page' %}
{%- endif -%}
