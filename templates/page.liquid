{%- comment -%}
  Default page template. The FAQ page renders the full designed FAQ experience
  (hero + search + category filter + accordion + contact panel), identical to the
  Claude design, matched by handle so no admin template change is required.
{%- endcomment -%}
{%- assign ph = page.handle -%}
{%- if ph == 'frequently-asked-questions' or ph == 'faq' or ph == 'faqs' -%}
  <div class="faqx">
    <!-- HERO -->
    <section class="faqx-hero">
      <div class="faqx-hero__crumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="faqx-hero__sep">/</span>
        <span class="faqx-hero__cur">FAQ</span>
      </div>
      <div class="faqx-hero__inner">
        <div class="faqx-hero__eyebrow"><span class="faqx-hero__ln"></span>Help Center<span class="faqx-hero__ln"></span></div>
        <h1 class="faqx-hero__title">Frequently Asked <span class="faqx-i">Questions</span></h1>
        <p class="faqx-hero__sub">Everything you need to know about our materials, custom process, shipping and installation. Can’t find an answer? We’re a message away.</p>
        <div class="faqx-search">
          <svg class="faqx-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7E8AA0" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
          <input type="text" class="faqx-search__input" placeholder="Search questions…" data-faq-search aria-label="Search questions">
        </div>
      </div>
    </section>

    <!-- FILTER PILLS -->
    <section class="faqx-pills">
      <div class="faqx-pills__row">
          <button type="button" class="faqx-pill is-active" data-faq-cat="all">All</button>
          <button type="button" class="faqx-pill" data-faq-cat="materials">Materials &amp; Craft</button>
          <button type="button" class="faqx-pill" data-faq-cat="custom">Custom Design</button>
          <button type="button" class="faqx-pill" data-faq-cat="shipping">Shipping &amp; Delivery</button>
          <button type="button" class="faqx-pill" data-faq-cat="installation">Installation &amp; Care</button>
          <button type="button" class="faqx-pill" data-faq-cat="orders">Orders &amp; Payment</button>
      </div>
    </section>

    <!-- FAQ LIST -->
    <section class="faqx-list">
      <div class="faqx-items" data-faq-items>
        <div class="faqx-item is-open" data-faq-item data-cat="materials">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Materials &amp; Craft</span>
              <span class="faqx-item__q">What materials are used in your mosaics?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">We use only the finest materials, including marble and glass, ensuring exceptional quality, durability, and timeless elegance.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="materials">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Materials &amp; Craft</span>
              <span class="faqx-item__q">Do you use natural stones in your mosaics?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">We use high-quality natural stones, including marble and other premium materials, to craft our mosaics. These stones provide timeless beauty, durability, and a luxurious feel for each piece.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="materials">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Materials &amp; Craft</span>
              <span class="faqx-item__q">Are your mosaics made by skilled artisans?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Every mosaic we create is meticulously handcrafted by skilled artisans using the finest techniques. Our talented team of mosaicists hand-cut and hand-set each tile to ensure precision and artistry. Depending on the design’s complexity, a team of 4 to 10 experts work together to bring each piece to life.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="materials">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Materials &amp; Craft</span>
              <span class="faqx-item__q">Who are the artisans behind my mosaic?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Our team consists of highly skilled international and local mosaic artists, masters of both ancient techniques and modern craftsmanship. With years of experience, they blend traditional methods with contemporary design to bring your vision to life.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="custom">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Custom Design</span>
              <span class="faqx-item__q">Can I customize the size, colors, or design?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">We specialize in custom mosaic art tailored to your vision. Choose your preferred size, colors, and design to perfectly match your space.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="custom">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Custom Design</span>
              <span class="faqx-item__q">Can I create a mosaic from an image?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">We can turn any image into a custom mosaic, creating a unique piece of art tailored to your vision.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="custom">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Custom Design</span>
              <span class="faqx-item__q">Will the mosaic I receive be identical to the design shown on your website?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">As all of our mosaics are custom-made to order, each piece is handcrafted individually after you place your order. The design on our website serves as a reference; slight variations in color and texture may occur due to the natural properties of marble and glass. These natural variations make your mosaic truly unique — we do not keep stock; every mosaic is created specifically for you.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="custom">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Custom Design</span>
              <span class="faqx-item__q">What mosaic design styles do you offer?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">We offer a diverse range of mosaic designs, from classic to modern, incorporating various patterns and themes. Whether you’re looking for something geometric, floral, or abstract, we tailor the design to fit the unique style and aesthetic of your space.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="shipping">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Shipping &amp; Delivery</span>
              <span class="faqx-item__q">Do you offer free shipping worldwide?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">We offer free shipping on all orders, ensuring our exquisite mosaics are delivered to your doorstep, no matter where you are across the globe.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="shipping">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Shipping &amp; Delivery</span>
              <span class="faqx-item__q">What is the production and shipping time?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Each mosaic is handcrafted with precision. Production times vary based on complexity, with a handling time of 4–5 weeks. Transit then typically takes around 10 days. We ensure secure packaging and reliable shipping for a smooth experience.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="shipping">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Shipping &amp; Delivery</span>
              <span class="faqx-item__q">Am I responsible for any import duties?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Yes, customers are responsible for any applicable import duties, taxes, or fees upon delivery, based on the destination country’s regulations.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="shipping">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Shipping &amp; Delivery</span>
              <span class="faqx-item__q">How do you ensure my mosaic artwork is safely delivered?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Each mosaic is carefully glued to a fiber mesh backing, securing the hand-cut tiles for safe transport, then packaged with thick paper and heavy-duty polyester film. Mosaics up to 10 sq. ft. are delivered in one piece, rolled like a carpet. Larger mosaics are split into smaller, clearly numbered pieces for easy assembly — just like a puzzle.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">Are your mosaics suitable for outdoor or wet areas?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">All our mosaics are designed to be installed in pools, bathrooms, kitchens, and outdoor spaces. Made from durable, weather-resistant, and waterproof materials, they maintain their beauty and quality even in wet or humid environments.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">How is the mosaic installed and maintained?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Our mosaics come in easy-to-install sheets, and we provide detailed installation guides. They are also low-maintenance, requiring simple cleaning for long-lasting beauty.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">Where can mosaic projects be installed?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Mosaic tiles are highly versatile and can be installed both indoors and outdoors — on walls, floors, swimming pools, tabletops, kitchen and bathroom backsplashes, ceiling inlays, mirror borders, and much more. Essentially anywhere you want to bring your creative vision to life.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">Do you provide installation services for mosaics?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Currently, we do not offer installation services. However, many customers find that installing mosaic artwork is easier than expected and enjoy it as a fulfilling DIY project that saves on professional installation. For assistance, check our installation guide or contact us at info@imosaicart.com.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">Are your mosaics weatherproof?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Yes — every mosaic is fully weatherproof. Crafted from natural marble, stone, and glass, they withstand sun, frost, heat, and humidity without fading or cracking, making them ideal for patios, façades, garden walls, and any outdoor space.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">Are your mosaics waterproof?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Absolutely. Our mosaics are made from non-porous, waterproof materials, so they’re perfectly suited for swimming pools, fountains, bathrooms, showers, and kitchen backsplashes. They retain their color and integrity even with constant water exposure.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">Can I add a frame to my mosaic?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Yes — frames can be added to mosaics intended for wall application. Framing options depend on the size and weight of the piece, so contact us at info@imosaicart.com and our team will help you choose the best framing solution for your case.</p>
              
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">How do I install my mosaic?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
            <div class="faqx-item__body-inner">
              <p class="faqx-item__a">Installation is a straightforward, beginner-friendly process — prepare your surface, spread the adhesive, press the mosaic into place, let it cure, then grout and seal. For a full step-by-step walkthrough with photos and timing, see our Installation Guide, or email us at info@imosaicart.com for help.</p>
              <a href="/pages/installation-guide" class="faqx-item__link">View the Installation Guide</a>
            </div>
          </div>
        </div>
        <div class="faqx-item" data-faq-item data-cat="installation">
          <button type="button" class="faqx-item__head" data-faq-toggle>
            <span class="faqx-item__hgroup">
              <span class="faqx-item__cat">Installation &amp; Care</span>
              <span class="faqx-item__q">Do your mosaics pass a slip test?</span>
            </span>
            <span class="faqx-item__icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faqx-item__body">
