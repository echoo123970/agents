{{ 'mosaic-designer.css' | asset_url | stylesheet_tag }}
<section class="md-hero">
  <div class="md-hero__crumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>{{ page.title }}</span></div>
  <div class="md-hero__inner">
    <div class="md-hero__eyebrow">Create Your Own</div>
    <h1 class="md-hero__title">Design Your <em>Mosaic</em></h1>
    <p class="md-hero__text">Upload a photo or drawing, or draw and write your own design. Fill it with our natural marble and engineered stones, and see it as a hand-cut mosaic with a full list of materials.</p>
  </div>
</section>
<div class="imd">


<header class="topbar">
  <div class="steps" role="group" aria-label="Step">
    <button id="step-sketch" type="button" aria-pressed="false"><span class="n">1</span>Design</button>
    <button id="step-color" type="button" aria-pressed="true"><span class="n">2</span>Color</button>
    <button id="step-mosaic" type="button" aria-pressed="false"><span class="n">3</span>Mosaic</button>
  </div>
  <div class="actions">
    <button class="btn" id="new-design" type="button">New design</button>
    <button class="btn" id="undo" type="button" title="Undo (Ctrl+Z)">Undo</button>
    <button class="btn" id="redo" type="button" title="Redo (Ctrl+Shift+Z)">Redo</button>
    <button class="btn" id="open-design" type="button">Open design</button>
    <button class="btn" id="save-design" type="button">Save design</button>
    <button class="btn primary" id="export" type="button">Export</button>
  </div>
</header>

<main class="bench">
  <!-- Tools -->
  <aside class="panel tools" aria-label="Tools">
    <div id="sketch-tools" class="group" hidden>
      <p class="label">Draw</p>
      <div class="toolgrid" role="group" aria-label="Drawing tools">
        <button class="tool" type="button" data-tool="select" title="Select (V)"><svg viewBox="0 0 24 24"><path d="M5 3l12 9-5 1 3 6-2 1-3-6-4 4z"/></svg>Select</button>
        <button class="tool" type="button" data-tool="pen" title="Pen (B)"><svg viewBox="0 0 24 24"><path d="M4 20c4-1 6-4 9-8l4-5-3-2-5 5c-3 3-5 6-5 10z"/></svg>Pen</button>
        <button class="tool" type="button" data-tool="line" title="Line (L)"><svg viewBox="0 0 24 24"><path d="M5 19L19 5"/></svg>Line</button>
        <button class="tool" type="button" data-tool="path" title="Path (P)"><svg viewBox="0 0 24 24"><path d="M4 18l5-11 6 8 5-9"/><circle cx="4" cy="18" r="1.5"/><circle cx="20" cy="6" r="1.5"/></svg>Path</button>
        <button class="tool" type="button" data-tool="rect" title="Rectangle (R)"><svg viewBox="0 0 24 24"><rect x="4" y="6" width="16" height="12"/></svg>Rectangle</button>
        <button class="tool" type="button" data-tool="ellipse" title="Ellipse (O)"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="8" ry="6"/></svg>Ellipse</button>
        <button class="tool" type="button" data-tool="polygon" title="Polygon (G)"><svg viewBox="0 0 24 24"><path d="M12 3l8 6-3 10H7L4 9z"/></svg>Polygon</button>
        <button class="tool" type="button" data-tool="star" title="Star (S)"><svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6-5.3-3-5.3 3 1.2-6L3.4 9.3l6-.7z"/></svg>Star</button>
        <button class="tool" type="button" data-tool="heart" title="Heart (K)"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>Heart</button>
        <button class="tool" type="button" data-tool="text" title="Text (T)"><svg viewBox="0 0 24 24"><path d="M5 6V4h14v2M12 4v16M9 20h6"/></svg>Text</button>
        <button class="tool" type="button" data-tool="eraser" title="Eraser (X)"><svg viewBox="0 0 24 24"><path d="M8 20h12M5 15l8-9 6 6-7 8H9z"/></svg>Eraser</button>
        <button class="tool" type="button" data-tool="hand" title="Move view (H)"><svg viewBox="0 0 24 24"><path d="M8 12V6a1.5 1.5 0 0 1 3 0v5V4.5a1.5 1.5 0 0 1 3 0V11V6a1.5 1.5 0 0 1 3 0v8c0 4-2.5 6-6 6s-5-2-6.5-4.5L4 13a1.4 1.4 0 0 1 2.3-1.6z"/></svg>Move view</button>
      </div>
      <p class="hint" id="tool-hint">Drag to draw. Hold Shift for straight angles, squares and circles.</p>
      <label class="field" for="weight">Line weight
        <span class="row"><input id="weight" type="range" min="1" max="14" value="3"><span class="val" id="weight-val">3</span></span>
      </label>
      <label class="field" for="sides" id="sides-field" hidden>Sides / points
        <span class="row"><input id="sides" type="range" min="3" max="12" value="6"><span class="val" id="sides-val">6</span></span>
      </label>
      <div class="group" id="text-field" hidden>
        <label class="field" for="text-input">Text<input id="text-input" value="iMosaicArt" maxlength="40"></label>
        <div class="grid2">
          <label class="field" for="text-font">Font
            <select id="text-font">
              <option value="600 {s}px 'Cormorant Garamond', Georgia, serif">Classic</option>
              <option value="{s}px Marcellus, Georgia, serif">Roman</option>
              <option value="700 {s}px 'Hanken Grotesk', system-ui, sans-serif">Modern</option>
            </select>
          </label>
          <label class="field" for="text-size">Size<input id="text-size" type="number" min="20" max="400" value="120"></label>
        </div>
        <p class="hint">Click the design to place the text, then move or resize it. Each letter becomes an outlined area you can color.</p>
      </div>
      <div class="group" id="sel-actions" hidden>
        <p class="label">Selection</p>
        <div class="toolgrid">
          <button class="btn" type="button" data-sel="flipx">Flip ↔</button>
          <button class="btn" type="button" data-sel="flipy">Flip ↕</button>
          <button class="btn" type="button" data-sel="rot">Rotate 90°</button>
          <button class="btn" type="button" data-sel="dup">Duplicate</button>
          <button class="btn danger" type="button" data-sel="del">Delete</button>
          <button class="btn primary" type="button" data-sel="done">Done</button>
        </div>
        <p class="hint">Drag inside to move, a corner to resize, the round handle to rotate. Ctrl+C and Ctrl+V copy and paste.</p>
      </div>
      <details class="more">
        <summary>Symmetry, grid &amp; tracing</summary>
        <div class="group">
      <div class="grid2">
        <label class="field" for="symmetry">Symmetry
          <select id="symmetry">
            <option value="0">Off</option><option value="1">Mirror</option><option value="2">4-way</option>
            <option value="3">6-way</option><option value="4">8-way</option><option value="6">12-way</option>
          </select>
        </label>
        <label class="field" for="grid">Grid
          <select id="grid"><option value="0">Off</option><option value="20">Fine</option><option value="40">Medium</option><option value="80">Large</option></select>
        </label>
      </div>
      <label class="check" for="snap"><input type="checkbox" id="snap" checked> Snap to grid and center</label>
      <button class="btn block" id="trace-photo" type="button">Trace over a photo…</button>
      <div class="group" id="trace-opts" hidden>
        <label class="check" for="trace-on"><input type="checkbox" id="trace-on" checked> Show the photo under the drawing</label>
        <label class="field" for="trace-alpha">Photo strength
          <span class="row"><input id="trace-alpha" type="range" min="10" max="80" value="35"><span class="val" id="trace-alpha-val">35</span></span>
        </label>
      </div>
        </div>
      </details>
      <p class="label" id="pic-label">Picture</p>
      <button class="btn block" id="import-sketch" type="button">Upload a picture…</button>
      <div class="group" id="trace-field" hidden>
        <label class="field" for="trace-mode">Convert the upload as
          <select id="trace-mode">
            <option value="outline">Black &amp; white outline of a photo or colored picture</option>
            <option value="lines">Line drawing: keep its black lines</option>
            <option value="colors">Outline and color it with our stones</option>
          </select>
        </label>
        <label class="field" for="colors" id="colors-field">Detail (number of areas)
          <span class="row"><input id="colors" type="range" min="2" max="16" value="8"><span class="val" id="colors-val">8</span></span>
        </label>
        <label class="field" for="threshold" id="threshold-field" hidden>Ink threshold
          <span class="row"><input id="threshold" type="range" min="10" max="90" value="55"><span class="val" id="threshold-val">55</span></span>
        </label>
      </div>
      <button class="btn block" id="ai-redraw" type="button" hidden>Redraw upload as clean lines (AI)</button>
      <details class="more" id="ai-more">
        <summary>Describe a design (AI)</summary>
        <div class="group">
      <div class="group" id="ai-box">
        <p class="label">Describe a design</p>
        <label class="field" for="ai-prompt"><span class="sr">What should we draw?</span>
          <textarea id="ai-prompt" rows="4" placeholder="Compass rose medallion with a wave border"></textarea>
        </label>
        <label class="check" for="ai-edit"><input type="checkbox" id="ai-edit"> Change the current sketch instead</label>
        <div class="row">
          <button class="btn primary" id="ai-go" type="button" style="flex:1">Draw it</button>
          <button class="btn" id="ai-stop" type="button" hidden>Stop</button>
        </div>
        <p class="hint" id="ai-status">Claude draws black outlines you can edit, then color.</p>
      </div>
      <p class="hint" id="ai-off" hidden>Drawing from a description works when this page is opened in Claude.</p>
        </div>
      </details>
      <details class="more">
        <summary>Start over</summary>
        <div class="group">
          <button class="btn block" id="sample" type="button">Start from one of our designs</button>
      <button class="btn block danger" id="clear-sketch" type="button">Clear sketch</button>
        </div>
      </details>
    </div>

    <div id="color-tools" class="group">
      <p class="label">Color</p>
      <div class="toolgrid" role="group" aria-label="Coloring tools">
        <button class="tool" type="button" data-tool="fill" title="Fill (F)"><svg viewBox="0 0 24 24"><path d="M5 11l7-7 7 7-7 7z"/><path d="M19 15c1 2 2 3 2 4a2 2 0 0 1-4 0c0-1 1-2 2-4z"/></svg>Fill</button>
        <button class="tool" type="button" data-tool="pick" title="Pick (I)"><svg viewBox="0 0 24 24"><path d="M14 4l6 6-9 9H5v-6z"/><path d="M12 6l6 6"/></svg>Pick</button>
        <button class="tool" type="button" data-tool="remove" title="Remove (D)"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>Remove</button>
      </div>
      <p class="hint">Pick a stone from the chart, then tap any area of your design.</p>
      <label class="field" for="any-color">Pick any color
        <span class="row"><input type="color" id="any-color" value="#c0603f"><span class="hint" id="any-color-match">We use the closest color in our chart.</span></span>
      </label>
      <details class="more" open>
        <summary>More options</summary>
        <div class="group">
      <p class="label">Show colors as</p>
      <div class="seg" role="group" aria-label="Show colors as">
        <button type="button" data-look="stone" aria-pressed="true">Stone</button>
        <button type="button" data-look="flat" aria-pressed="false">Plain colors</button>
      </div>
      <label class="field" for="gap">Gap closing
        <span class="row"><input id="gap" type="range" min="0" max="8" value="2"><span class="val" id="gap-val">2</span></span>
      </label>
      <p class="hint">Raise this if a fill leaks through a small gap in the lines.</p>
      <button class="btn block danger" id="clear-colors" type="button">Clear all colors</button>
        </div>
      </details>
    </div>

    <div id="mosaic-tools" class="group" hidden>
      <p class="label">Mosaic</p>
      <!-- tile size is set automatically (½ in, smaller for photos); kept hidden for customers -->
      <label class="field" for="tile-size" hidden>Tile size
        <select id="tile-size">
          <option value="0.25">¼ in (6 mm)</option>
          <option value="0.375">⅜ in (1 cm)</option>
          <option value="0.5" selected>½ in (1.3 cm)</option>
          <option value="0.625">⅝ in (1.6 cm)</option>
          <option value="0.75">¾ in (2 cm)</option>
          <option value="1">1 in (2.5 cm)</option>
        </select>
      </label>
      <div class="group" id="mosaic-from-group" hidden>
        <p class="label">Build the mosaic from</p>
        <div class="seg" role="group" aria-label="Build the mosaic from">
          <button type="button" data-from="picture" aria-pressed="true">Original picture</button>
          <button type="button" data-from="areas" aria-pressed="false">Colored areas</button>
        </div>
        <p class="hint" id="mosaic-from-hint">Every tile takes the stone from our chart that is closest to the picture under it, like our hand-made portraits. Smaller tiles show more detail.</p>
      </div>
      <p class="hint" id="mosaic-areas-hint">Each area is laid with hand-cut tiles of its stone, cut to fit the shape. Tap an area to change its stone.</p>
    </div>

    <div id="joint-group" class="group">
      <p class="label">Lines &amp; grout</p>
      <div class="joints" role="group" aria-label="Line and grout color">
        <button class="joint" type="button" data-joint="#1b1a19" style="background:#1b1a19" title="Black" aria-label="Black joints"></button>
        <button class="joint" type="button" data-joint="#8a8782" style="background:#8a8782" title="Grey grout" aria-label="Grey joints"></button>
        <button class="joint" type="button" data-joint="#f2f0ec" style="background:#f2f0ec" title="White grout" aria-label="White joints"></button>
        <button class="joint" type="button" data-joint="#b08d48" style="background:#b08d48" title="Brass strip" aria-label="Brass joints"></button>
        <button class="joint" type="button" data-joint="#4a4d52" style="background:#4a4d52" title="Lead came" aria-label="Lead came joints"></button>
      </div>
    </div>
  </aside>

  <!-- Slab -->
  <section class="stage" aria-label="Design">
    <div class="start" id="start" hidden>
      <div class="start-head">
        <div><h2>Create your mosaic</h2><p class="hint">How would you like to start? You can change everything afterwards.</p></div>
        <button class="start-close" type="button" id="start-close" aria-label="Close">×</button>
      </div>
      <div class="start-grid">
        <button type="button" data-start="upload"><svg viewBox="0 0 24 24"><path d="M4 16v3h16v-3M12 4v11M7 9l5-5 5 5"/></svg><b>Upload a picture</b><span>A drawing, a photo, or a picture of a mosaic. We'll ask what you'd like to do with it.</span></button>
        <button type="button" data-start="describe"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></svg><b>Describe it</b><span>Type your idea and we draw a black &amp; white design for you to color.</span></button>
        <button type="button" data-start="draw"><svg viewBox="0 0 24 24"><path d="M4 20c4-1 6-4 9-8l4-5-3-2-5 5c-3 3-5 6-5 10z"/></svg><b>Draw it myself</b><span>Shapes, text, symmetry and freehand on a blank canvas.</span></button>
        <button type="button" data-start="gallery"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 4l2 8-2 8-2-8z"/></svg><b>Start from one of our designs</b><span>Browse our best-selling mosaics by category, then make one your own.</span></button>
      </div>
    </div>
    <div class="start" id="gallery" hidden>
      <div class="start-head">
        <div><h2>Start from one of our designs</h2><p class="hint">Our best-selling mosaics by category. Pick one in your size, then change its stones or clear them and paint it your way.</p></div>
        <button class="start-close" type="button" id="gallery-close" aria-label="Close">×</button>
      </div>
      <div class="gallery-tabs" id="gallery-tabs" role="group" aria-label="Categories"></div>
      <div class="gallery-grid" id="gallery-grid"></div>
    </div>
    <div class="start" id="upload-panel" hidden>
      <div class="start-head">
        <div class="up-head"><img id="up-thumb" alt="Your upload"><div><h2 id="up-title">Your picture</h2><p class="hint"><span id="up-hint">Tell us what it is and what you'd like, and we'll set it up.</span> <a id="up-link" href="#" target="_blank" rel="noopener" hidden>See it in our shop</a></p></div></div>
        <button class="start-close" type="button" id="up-close" aria-label="Cancel">×</button>
      </div>
      <p class="label" id="up-kind-label">1 · What is this picture?</p>
      <div class="seg up-kind" role="group" aria-label="What is this picture">
        <button type="button" data-kind="bw">Black &amp; white drawing</button>
        <button type="button" data-kind="color">Colored picture or photo</button>
        <button type="button" data-kind="mosaic">Photo of a mosaic</button>
      </div>
      <p class="label" id="up-act-label"><span id="up-act-num">2 · </span>What would you like? <span class="hint" id="up-try" style="text-transform:none;letter-spacing:0">Try each one; the design changes as you click.</span></p>
      <div class="start-grid up-actions" id="up-actions"></div>
      <div class="row" style="justify-content: flex-end"><button class="btn primary" type="button" id="up-done" hidden>Continue with this →</button></div>
    </div>
    <div class="slab-wrap mode-color" id="slab">
      <div class="draw-hint" id="draw-hint" hidden><b>Your blank canvas</b><span>Pick a tool on the left (Pen, Line, Rectangle, Ellipse, Star, Heart, Text…) and drag here to draw. Closed shapes become areas you fill with our stones in step 2, and step 3 turns them into a hand-cut mosaic.</span></div>
      <div id="slab-inner">
        <canvas id="view" width="1000" height="750" aria-label="Design canvas"></canvas>
        <canvas id="overlay" width="1000" height="750"></canvas>
      </div>
      <div class="busy" id="busy" hidden>Working…</div>
      <div class="zoombar" role="group" aria-label="Zoom">
        <button type="button" id="zoom-out" title="Zoom out (−)" aria-label="Zoom out">−</button>
        <button type="button" id="zoom-fit" title="Fit (0)">100%</button>
        <button type="button" id="zoom-in" title="Zoom in (+)" aria-label="Zoom in">+</button>
      </div>
    </div>
    <div class="stepnav">
      <button class="btn" type="button" id="prev-step">← Back</button>
      <p class="step-help"><b id="step-title">Step 2 of 3 · Color</b><span id="status">Tap an area to fill it with <b id="status-mat">—</b></span></p>
      <button class="btn primary" type="button" id="next-step">Next: See the mosaic →</button>
    </div>
    <div class="sizebar" role="group" aria-label="Mosaic size">
      <span class="label">Mosaic size</span>
      <select id="size-preset" aria-label="Choose a size">
        <option value="">Choose a size…</option>
        <option value="12x12">12 × 12 in</option><option value="18x18">18 × 18 in</option>
        <option value="24x24">24 × 24 in</option><option value="36x36">36 × 36 in</option>
        <option value="24x18">24 × 18 in (wide)</option><option value="36x24">36 × 24 in (wide)</option>
        <option value="48x32">48 × 32 in (wide)</option><option value="18x24">18 × 24 in (tall)</option>
        <option value="24x36">24 × 36 in (tall)</option><option value="32x48">32 × 48 in (tall)</option>
      </select>
      <span class="row">
        <input id="size-w" type="number" min="4" max="400" step="0.5" value="36" aria-label="Width">
        <span>×</span>
        <input id="size-h" type="number" min="4" max="400" step="0.5" value="27" aria-label="Height">
        <select id="size-unit" aria-label="Unit"><option value="in">in</option><option value="cm">cm</option></select>
      </span>
      <span class="hint">width × height</span>
    </div>

  </section>

  <!-- Chart -->
  <aside class="panel chart" aria-label="Material chart">
    <div class="selected">
      <canvas id="sel-thumb" width="144" height="144"></canvas>
      <div>
        <span class="chip" id="sel-type">Marble</span>
        <div class="nm" id="sel-name">—</div>
        <div class="code" id="sel-code"></div>
      </div>
    </div>
    <div class="tabs" role="group" aria-label="Show">
      <button type="button" data-filter="marble" aria-pressed="true">Marble</button>
      <button type="button" data-filter="engineered" aria-pressed="false">Engineered</button>
    </div>
    <label class="field" for="search">Search chart
      <input id="search" type="search" placeholder="Name or code">
    </label>
    <div class="swatches" id="swatches" role="group" aria-label="Materials"></div>
    <!-- chart management, kept for staff use later; not shown to customers -->
    <div id="chart-admin" hidden>
    <p class="note" id="sample-note">The chart shows the 48 iMosaicArt stones with their real swatch photos, 01 to 48.</p>
    <div class="chart-actions">
      <button class="btn primary" id="add-mat" type="button">Add material</button>
      <button class="btn" id="import-chart" type="button">Import chart</button>
      <button class="btn" id="export-chart" type="button">Export chart</button>
      <button class="btn" id="reset-chart" type="button">Reset chart</button>
      <button class="btn primary" id="import-swatches" type="button" hidden style="grid-column: 1 / -1">Import our swatch photos from Shopify</button>
    </div>
    <p class="hint" id="import-status" hidden></p>
    </div>
  </aside>

  <section class="bom-wrap" aria-label="Materials used">
    <div class="bom">
      <div class="bom-head">
        <h2>Materials used</h2>
        <span class="bom-size" id="dims">36 × 27 in</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Material</th><th>Type</th><th class="num">Pieces</th><th class="num" id="tiles-head">Tiles</th><th class="num">Share</th><th class="num" id="area-head">Area (ft²)</th></tr></thead>
          <tbody id="bom-body"></tbody>
          <tfoot id="bom-foot"></tfoot>
        </table>
      </div>
    </div>
  </section>
</main>

<!-- Material editor -->
<dialog id="mat-dlg">
  <form class="dlg" id="mat-form" method="dialog">
    <h3 id="mat-dlg-title">Add material</h3>
    <div class="preview-row">
      <canvas id="mat-preview" width="240" height="240"></canvas>
      <div class="group">
        <label class="field" for="m-name">Name<input id="m-name" required placeholder="Calacatta Viola"></label>
        <label class="field" for="m-code">Chart code<input id="m-code" placeholder="MB-160"></label>
      </div>
    </div>
    <div class="grid2">
      <label class="field" for="m-type">Material
        <select id="m-type"><option value="marble">Marble</option><option value="engineered">Engineered stone</option></select>
      </label>
      <label class="field" for="m-style">Finish
        <select id="m-style"></select>
      </label>
    </div>
    <div class="grid2">
      <div class="field">Base color
        <span class="colorpair"><input type="color" id="m-base" value="#e9e8e4" aria-label="Base color"><span class="code" id="m-base-hex">#e9e8e4</span></span>
      </div>
      <div class="field" id="m-vein-field">Veining / streak color
        <span class="colorpair"><input type="color" id="m-vein" value="#8f9295" aria-label="Veining color"><span class="code" id="m-vein-hex">#8f9295</span></span>
      </div>
    </div>
    <div class="field">Swatch photo (optional, replaces the generated texture)
      <span class="row"><button class="btn" type="button" id="m-photo-btn">Choose photo…</button><button class="btn" type="button" id="m-photo-clear" hidden>Remove photo</button></span>
    </div>
    <div class="foot">
      <button class="btn danger" type="button" id="m-delete" hidden>Delete</button>
      <span class="spacer"></span>
      <button class="btn" type="button" id="m-cancel">Cancel</button>
      <button class="btn primary" type="submit" id="m-save">Save material</button>
    </div>
  </form>
</dialog>

<!-- Export -->
<dialog id="export-dlg">
  <div class="dlg">
    <h3>Export design</h3>
    <img class="export-img" id="export-img" alt="Colored design with materials list">
    <p class="hint">The image includes the materials list. If the download button does nothing in your viewer, right-click or long-press the image to save it.</p>
    <div class="foot">
      <button class="btn" type="button" id="export-close">Close</button>
      <a class="btn primary" id="export-dl" download="mosaic-design.png" href="#">Download PNG</a>
    </div>
  </div>
</dialog>

<!-- JSON (save design / chart) -->
<dialog id="json-dlg">
  <div class="dlg">
    <h3 id="json-title">Save design</h3>
    <p class="hint" id="json-hint"></p>
    <textarea class="json" id="json-text" readonly aria-label="File contents"></textarea>
    <div class="foot">
      <button class="btn" type="button" id="json-close">Close</button>
      <button class="btn" type="button" id="json-copy">Copy</button>
      <a class="btn primary" id="json-dl" href="#" download="design.json">Download file</a>
    </div>
  </div>
</dialog>

<!-- Confirm -->
<dialog id="confirm-dlg">
  <form class="dlg" method="dialog">
    <h3 id="confirm-title">Are you sure?</h3>
    <p class="hint" id="confirm-body"></p>
    <div class="foot">
      <button class="btn" value="cancel">Cancel</button>
      <button class="btn primary" value="ok" id="confirm-ok">Continue</button>
    </div>
  </form>
</dialog>

<input type="file" id="file-sketch" accept="image/*" hidden>
<input type="file" id="file-trace" accept="image/*" hidden>
<input type="file" id="file-design" accept=".json,application/json" hidden>
<input type="file" id="file-chart" accept=".json,application/json" hidden>
<input type="file" id="file-photo" accept="image/*" hidden>
<div class="toast" id="toast" hidden></div>

