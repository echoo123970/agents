<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
{% include 'limespot' %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0754/6093/5978/files/favicon-32.png?v=1783243826">
    <link rel="icon" type="image/png" sizes="512x512" href="https://cdn.shopify.com/s/files/1/0754/6093/5978/files/favicon-512.png?v=1783243826">
    <link rel="apple-touch-icon" href="https://cdn.shopify.com/s/files/1/0754/6093/5978/files/favicon-512.png?v=1783243826">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600;700&family=Marcellus&display=swap" rel="stylesheet">
    <link rel="preload" as="font" type="font/woff2" href="{{ 'hanken-grotesk-400-normal-latin.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'hanken-grotesk-600-normal-latin.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'cormorant-garamond-500-normal-latin.woff2' | asset_url }}" crossorigin>
    <style>
      @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'cormorant-garamond-400-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:500;font-display:swap;src:url({{ 'cormorant-garamond-500-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:600;font-display:swap;src:url({{ 'cormorant-garamond-600-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:700;font-display:swap;src:url({{ 'cormorant-garamond-700-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:400;font-display:swap;src:url({{ 'cormorant-garamond-400-italic-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:500;font-display:swap;src:url({{ 'cormorant-garamond-500-italic-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Hanken Grotesk';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'hanken-grotesk-400-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Hanken Grotesk';font-style:normal;font-weight:500;font-display:swap;src:url({{ 'hanken-grotesk-500-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Hanken Grotesk';font-style:normal;font-weight:600;font-display:swap;src:url({{ 'hanken-grotesk-600-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Hanken Grotesk';font-style:normal;font-weight:700;font-display:swap;src:url({{ 'hanken-grotesk-700-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Marcellus';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'marcellus-400-normal-latin.woff2' | asset_url }}) format('woff2');}
    </style>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-navy: {{ settings.color_navy }};
        --color-navy-deep: #102A4F;
        --color-navy-darker: #0B1C35;
        --color-blue: {{ settings.color_accent }};
        --color-blue-light: #7BB0F4;   /* Azure */
        --color-blue-lighter: #9CC0F5; /* Sky */
        --color-text: {{ settings.color_navy }};
        --color-text-muted: #4A5468;   /* Ink 70 — body copy on light */
        --color-text-soft: #7E8AA0;    /* Slate */
        --color-text-faint: #9AA4B8;
        --color-light-text: #DCE6F5;
        --color-line: #ECEFF4;         /* Hairline */
        --color-panel: #E9ECF1;        /* Mist */
        --color-card: #FFFFFF;
        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body: 'Hanken Grotesk', -apple-system, system-ui, sans-serif;
        --font-accent: 'Marcellus', Georgia, serif;
        --page-width: 1320px; /* exact Claude design width — keeps all font/layout proportions 1:1 */
      }
    </style>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main">
      {{ content_for_layout }}
<limespot></limespot>
    </main>

    {% sections 'footer-group' %}

    {% section 'floating-actions' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
