<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
{% include 'limespot' %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    {%- comment -%} Geo restriction: hide the storefront from selected regions. {%- endcomment -%}
    <script>
      (function () {
        var BLOCKED = ['TR','SY','IR','VN','CN','IN','PK','IL','SG','ID','PH'];
        function blockPage() {
          try {
            var html = document.documentElement;
            var o = document.createElement('div');
            o.id = 'geo-block';
            o.setAttribute('style', 'position:fixed;inset:0;z-index:2147483647;background:#0B1C35;color:#F4F6FA;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;font-family:Georgia,"Times New Roman",serif;');
            o.innerHTML = '<div style="max-width:520px"><div style="font-size:30px;line-height:1.3;margin-bottom:16px;letter-spacing:.02em">iMosaicArt</div><div style="font-size:18px;line-height:1.65;color:#C7CFDD">We\'re sorry — our website is not available in your region at this time.</div></div>';
            (document.body || html).appendChild(o);
            html.style.overflow = 'hidden';
            if (document.body) document.body.style.overflow = 'hidden';
          } catch (e) {}
        }
        try {
          fetch('https://get.geojs.io/v1/ip/country', { cache: 'no-store' })
            .then(function (r) { return r.text(); })
            .then(function (cc) {
              cc = (cc || '').trim().toUpperCase();
              if (BLOCKED.indexOf(cc) !== -1) {
                if (document.body) { blockPage(); }
                else { document.addEventListener('DOMContentLoaded', blockPage); }
              }
            })
            .catch(function () {});
        } catch (e) {}
      })();
    </script>
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%} Organization + LocalBusiness structured data (sitewide) — helps Google Knowledge Panel and LLM understanding. {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.imosaicart.com/#organization",
          "name": "iMosaicArt",
          "url": "https://www.imosaicart.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "{{ 'mark-color.png' | asset_url }}"
          },
          "image": "{{ 'mark-color.png' | asset_url }}",
          "description": "iMosaicArt is a premium US-based studio creating handcrafted natural stone and glass mosaic art — custom portraits, wall art, backsplashes, tabletops, and architectural installations. Every piece is made to order and shipped free worldwide.",
          "email": "info@imosaicart.com",
          "telephone": "+1-315-217-5538",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "28 Liberty St",
            "addressLocality": "New York",
            "addressRegion": "NY",
            "postalCode": "10005",
            "addressCountry": "US"
          },
          "sameAs": [
            {%- assign social_links = "" -%}
            {%- if settings.social_instagram_link != blank -%}{%- assign social_links = social_links | append: settings.social_instagram_link | append: "|" -%}{%- endif -%}
            {%- if settings.social_facebook_link != blank -%}{%- assign social_links = social_links | append: settings.social_facebook_link | append: "|" -%}{%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}{%- assign social_links = social_links | append: settings.social_pinterest_link | append: "|" -%}{%- endif -%}
            {%- if settings.social_youtube_link != blank -%}{%- assign social_links = social_links | append: settings.social_youtube_link | append: "|" -%}{%- endif -%}
            {%- assign social_arr = social_links | split: "|" -%}
            {%- for link in social_arr -%}"{{ link }}"{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
          ]
        },
        {
          "@type": "Store",
          "@id": "https://www.imosaicart.com/#store",
          "name": "iMosaicArt",
          "url": "https://www.imosaicart.com/",
          "image": "{{ 'mark-color.png' | asset_url }}",
          "parentOrganization": { "@id": "https://www.imosaicart.com/#organization" },
          "priceRange": "$$$",
          "email": "info@imosaicart.com",
          "telephone": "+1-315-217-5538",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "28 Liberty St",
            "addressLocality": "New York",
            "addressRegion": "NY",
            "postalCode": "10005",
            "addressCountry": "US"
          },
          "areaServed": "Worldwide"
        },
        {
          "@type": "WebSite",
          "@id": "https://www.imosaicart.com/#website",
          "url": "https://www.imosaicart.com/",
          "name": "iMosaicArt",
          "publisher": { "@id": "https://www.imosaicart.com/#organization" },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://www.imosaicart.com/search?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
    </script>

    <link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0754/6093/5978/files/favicon-32.png?v=1783243826">
    <link rel="apple-touch-icon" href="https://cdn.shopify.com/s/files/1/0754/6093/5978/files/favicon-32.png?v=1783243826">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600;700&family=Marcellus&display=swap" rel="stylesheet">
    <link rel="preload" as="font" type="font/woff2" href="{{ 'hanken-grotesk-400-normal-latin.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'hanken-grotesk-600-normal-latin.woff2' | asset_url }}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{ 'cormorant-garamond-500-normal-latin.woff2' | asset_url }}" crossorigin>
    <style>
      @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'cormorant-garamond-400-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:500;font-display:swap;src:url({{ 'cormorant-garamond-500-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:600;font-display:swap;src:url({{ 'cormorant-garamond-600-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:700;font-display:swap;src:url({{ 'cormorant-garamond-700-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:400;font-display:swap;src:url({{ 'cormorant-garamond-400-italic-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:500;font-display:swap;src:url({{ 'cormorant-garamond-500-italic-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Hanken Grotesk';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'hanken-grotesk-400-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Hanken Grotesk';font-style:normal;font-weight:500;font-display:swap;src:url({{ 'hanken-grotesk-500-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Hanken Grotesk';font-style:normal;font-weight:600;font-display:swap;src:url({{ 'hanken-grotesk-600-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Hanken Grotesk';font-style:normal;font-weight:700;font-display:swap;src:url({{ 'hanken-grotesk-700-normal-latin.woff2' | asset_url }}) format('woff2');}
      @font-face{font-family:'Marcellus';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'marcellus-400-normal-latin.woff2' | asset_url }}) format('woff2');}
    </style>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-navy: {{ settings.color_navy }};
        --color-navy-deep: #102A4F;
        --color-navy-darker: #0B1C35;
        --color-blue: {{ settings.color_accent }};
        --color-blue-light: #7BB0F4;   /* Azure */
        --color-blue-lighter: #9CC0F5; /* Sky */
        --color-text: {{ settings.color_navy }};
        --color-text-muted: #4A5468;   /* Ink 70 — body copy on light */
        --color-text-soft: #7E8AA0;    /* Slate */
        --color-text-faint: #9AA4B8;
        --color-light-text: #DCE6F5;
        --color-line: #ECEFF4;         /* Hairline */
        --color-panel: #E9ECF1;        /* Mist */
        --color-card: #FFFFFF;
        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body: 'Hanken Grotesk', -apple-system, system-ui, sans-serif;
        --font-accent: 'Marcellus', Georgia, serif;
        --page-width: 1320px; /* exact Claude design width — keeps all font/layout proportions 1:1 */
      }
    </style>

    <style>
      /* Shopify spam-protection (hCaptcha) challenge page */
      .shopify-challenge__container { max-width: 640px; margin: 0 auto; padding: 90px 24px 100px; text-align: center; }
      .shopify-challenge__container form { margin-top: 34px; }
      .shopify-challenge__container p, .shopify-challenge__container h1, .shopify-challenge__container h2 { margin-bottom: 34px; }
      .shopify-challenge__container .h-captcha, .shopify-challenge__container iframe { margin: 0 auto; }
      .shopify-challenge__button, .shopify-challenge__button.btn { display: inline-block; margin-top: 34px; background: {{ settings.color_navy | default: '#16335E' }}; color: #fff; border: none; font-family: 'Hanken Grotesk', sans-serif; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; padding: 16px 46px; cursor: pointer; transition: background .25s ease; }
      .shopify-challenge__button:hover, .shopify-challenge__button.btn:hover { background: #224A82; }
    </style>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main">
      {{ content_for_layout }}
<limespot></limespot>
    </main>

    {% sections 'footer-group' %}

    {% section 'floating-actions' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
