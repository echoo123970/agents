{%- comment -%}
  Black Friday 2026 schedule + countdown clock for the announcement bar.
  Sale window: Mon Nov 23 12:01 AM ET → Mon Nov 30 11:59 PM ET, matching the BLACKFRIDAY25 automatic discount.
  Outside the window nothing changes. Preview with ?bf=live, ?bf=last (last-day message), ?bf=off, ?bf=reset.
{%- endcomment -%}
<script>
  (function () {
    var START = Date.parse('2026-11-23T00:01:00-05:00');
    var END = Date.parse('2026-12-01T00:00:00-05:00');
    var mode = null;
    try {
      var q = new URLSearchParams(window.location.search).get('bf');
      if (q === 'live' || q === 'last' || q === 'off') sessionStorage.setItem('bf2026', q);
      if (q === 'reset') sessionStorage.removeItem('bf2026');
      mode = sessionStorage.getItem('bf2026');
    } catch (e) {}

    function inWindow(t) { return t >= START && t < END; }
    function active() {
      if (mode === 'off') return false;
      if (mode === 'live' || mode === 'last') return true;
      return inWindow(Date.now());
    }
    function etDay() {
      if (mode === 'last') return 30;
      var t = Date.now();
      if (!inWindow(t)) return 27;
      return Math.max(27, new Date(t - 5 * 3600 * 1000).getUTCDate());
    }
    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function render() {
      var on = active();
      document.documentElement.classList.toggle('bf-on', on);
      if (!on) return;
      var left = Math.max(0, END - Date.now());
      var s = Math.floor(left / 1000);
      var parts = { d: Math.floor(s / 86400), h: Math.floor(s % 86400 / 3600), m: Math.floor(s % 3600 / 60), s: s % 60 };
      var els = document.querySelectorAll('[data-bf-unit]');
      for (var i = 0; i < els.length; i++) els[i].textContent = pad(parts[els[i].getAttribute('data-bf-unit')]);
      var day = '' + etDay();
      els = document.querySelectorAll('[data-bf-days]');
      for (i = 0; i < els.length; i++) els[i].hidden = (' ' + els[i].getAttribute('data-bf-days') + ' ').indexOf(' ' + day + ' ') === -1;
    }

    render();
    document.addEventListener('DOMContentLoaded', render);
    setInterval(render, 1000);
  })();
</script>
<style>
  .bf-only { display: none !important; }
  html.bf-on .bf-only { display: block !important; }
  html.bf-on .bf-hide { display: none !important; }
</style>
<style>
  .bf-inline { display: none !important; }
  html.bf-on .bf-inline { display: inline-flex !important; }
  .bf-sticker { position: absolute; top: 14px; left: 14px; z-index: 3; flex-direction: column; align-items: center; gap: 4px; padding: 7px 11px 8px; background: var(--color-navy-darker); color: #fff; text-align: center; line-height: 1; box-shadow: 0 8px 22px rgba(11,28,53,.22); outline: 1px solid rgba(156,192,245,.45); outline-offset: -3px; pointer-events: none; }
  .bf-sticker small { font-size: 7px; font-weight: 600; letter-spacing: .26em; text-transform: uppercase; color: var(--color-blue-lighter); }
  .bf-sticker b { font-family: var(--font-display); font-weight: 500; font-size: 16px; letter-spacing: .02em; }
  .bf-sticker--pdp { top: 20px; left: auto; right: 20px; padding: 10px 16px 11px; gap: 6px; }
  .bf-sticker--pdp small { font-size: 8.5px; }
  .bf-sticker--pdp b { font-size: 22px; }
  .bf-note { align-items: center; gap: 10px; margin: 4px 0 14px; padding: 10px 14px; background: #EAF2FD; border-left: 3px solid var(--color-blue); color: var(--color-navy); font-size: 13.5px; line-height: 1.4; }
  .bf-note strong { font-weight: 700; }
  .bf-note { position: relative; overflow: hidden; }
  .bf-note::after { content: ""; position: absolute; top: 0; bottom: 0; left: -40%; width: 40%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.75), transparent); animation: bf-sweep 5.5s ease-in-out infinite; pointer-events: none; }
  .bf-note__light { position: relative; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--color-blue); box-shadow: 0 0 0 0 rgba(43,123,232,.45); animation: bf-glow 2.8s ease-in-out infinite; }
  @keyframes bf-glow { 0%, 100% { opacity: .35; box-shadow: 0 0 0 0 rgba(43,123,232,0); } 50% { opacity: 1; box-shadow: 0 0 0 5px rgba(43,123,232,.18), 0 0 12px 2px rgba(43,123,232,.45); } }
  @keyframes bf-sweep { 0%, 60% { left: -40%; } 100% { left: 110%; } }
  @media (prefers-reduced-motion: reduce) { .bf-note::after { display: none; } .bf-note__light { animation: none; opacity: 1; } }
  @media (max-width: 750px) {
    .bf-sticker { top: 8px; left: 8px; padding: 6px 8px 7px; gap: 3px; }
    .bf-sticker small { font-size: 6px; letter-spacing: .2em; }
    .bf-sticker b { font-size: 13px; }
    .bf-sticker--pdp { left: auto; right: 12px; }
    .bf-sticker--pdp b { font-size: 17px; }
  }
</style>
