  <script>
    (function () {
      var root = document.querySelector('.pf');
      if (!root) return;
      var tiles = [].slice.call(root.querySelectorAll('[data-pf-item]'));
      var tabs = [].slice.call(root.querySelectorAll('[data-pf-tab]'));
      var empty = root.querySelector('[data-pf-empty]');
      var lb = root.querySelector('[data-pf-lightbox]');
      var lbImg = root.querySelector('[data-pf-lightbox-img]');
      var lbCat = root.querySelector('[data-pf-lightbox-cat]');
      var lbTitle = root.querySelector('[data-pf-lightbox-title]');

      var moreBtn = root.querySelector('[data-pf-more]');
      var STEP = 24;
      var currentCat = 'All';
      var limit = STEP;
      function render() {
        var shown = 0, matched = 0;
        tiles.forEach(function (t) {
          var match = currentCat === 'All' || t.getAttribute('data-cat') === currentCat;
          if (match && shown < limit) { t.style.display = ''; shown++; }
          else { t.style.display = 'none'; }
          if (match) matched++;
        });
        if (empty) empty.hidden = matched !== 0;
        if (moreBtn) moreBtn.style.display = (matched > limit) ? '' : 'none';
      }
      function filter(cat) { currentCat = cat; limit = STEP; render(); }
      function openLb(tile) {
        if (!lb) return;
        lbImg.src = tile.getAttribute('data-full');
        lbImg.alt = tile.getAttribute('data-title') || '';
        if (lbCat) lbCat.textContent = tile.getAttribute('data-cat') || '';
        if (lbTitle) lbTitle.textContent = tile.getAttribute('data-title') || '';
        lb.hidden = false;
        document.documentElement.style.overflow = 'hidden';
      }
      function closeLb() {
        if (!lb) return;
        lb.hidden = true;
        if (lbImg) lbImg.src = '';
        document.documentElement.style.overflow = '';
      }

      root.addEventListener('click', function (e) {
        var tab = e.target.closest('[data-pf-tab]');
        if (tab) {
          tabs.forEach(function (x) { x.classList.toggle('is-active', x === tab); });
          filter(tab.getAttribute('data-pf-tab'));
          return;
        }
        if (e.target.closest('[data-pf-close]')) { closeLb(); return; }
        if (e.target.closest('[data-pf-lightbox]') && !e.target.closest('.pf-lightbox__meta')) {
          if (e.target.closest('[data-pf-item]')) {} else { closeLb(); return; }
        }
        var tile = e.target.closest('[data-pf-item]');
        if (tile) { openLb(tile); }
      });
      root.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeLb();
        var tile = e.target.closest && e.target.closest('[data-pf-item]');
        if (tile && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openLb(tile); }
      });
      if (moreBtn) moreBtn.addEventListener('click', function () { limit += STEP; render(); });
      render();
    })();
  </script>
