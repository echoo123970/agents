  <style>
    .pf { background:#F4F6FA; color:#16335E; }
    .pf-i { font-style:italic; color:#2B7BE8; white-space:nowrap; }
    .pf-hero { background:#EEF1F6; border-bottom:1px solid rgba(22,51,94,.08); }
