  <script>
    (function () {
      var root = document.querySelector('.faqx');
      if (!root) return;
      var items = [].slice.call(root.querySelectorAll('[data-faq-item]'));
      var pills = [].slice.call(root.querySelectorAll('[data-faq-cat]'));
      var search = root.querySelector('[data-faq-search]');
      var suggest = root.querySelector('[data-faq-suggest]');
      var empty = root.querySelector('[data-faq-empty]');
      var emptyQ = root.querySelector('[data-faq-empty-q]');
      var activeCat = 'all';

      // Build a lightweight index of the questions/answers for predictive search.
      var index = items.map(function (it) {
        var qEl = it.querySelector('.faqx-item__q');
        var catEl = it.querySelector('.faqx-item__cat');
        var aEl = it.querySelector('.faqx-item__a');
        var q = qEl ? qEl.textContent.trim() : '';
        var a = aEl ? aEl.textContent.trim() : '';
        var cat = catEl ? catEl.textContent.trim() : '';
        return { el: it, q: q, a: a, cat: cat, hay: (q + ' ' + a).toLowerCase() };
      });

      function esc(s) { return s.replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function highlight(text, q) {
        if (!q) return esc(text);
        var i = text.toLowerCase().indexOf(q);
        if (i === -1) return esc(text);
        return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + q.length)) + '</mark>' + esc(text.slice(i + q.length));
      }

      // ---- inline accordion filtering (kept) ----
      function apply() {
        var q = (search.value || '').trim().toLowerCase();
        var visible = 0;
        items.forEach(function (it) {
          var okCat = activeCat === 'all' || it.getAttribute('data-cat') === activeCat;
          var okQ = !q || it.textContent.toLowerCase().indexOf(q) !== -1;
          var show = okCat && okQ;
          it.hidden = !show;
          if (show) visible++;
        });
        if (empty) {
          empty.hidden = visible !== 0;
          if (emptyQ) emptyQ.textContent = q;
        }
      }

      // ---- predictive suggestions dropdown ----
      var activeIdx = -1;
      function closeSuggest() {
        if (!suggest) return;
        suggest.hidden = true; suggest.innerHTML = ''; activeIdx = -1;
        search.setAttribute('aria-expanded', 'false');
      }
      function openItem(entry) {
        items.forEach(function (it) { it.classList.remove('is-open'); it.hidden = false; });
        // reset filters so the target is guaranteed visible
        activeCat = 'all';
        pills.forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-faq-cat') === 'all'); });
        if (empty) empty.hidden = true;
        entry.el.classList.add('is-open');
        entry.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      function renderSuggest() {
        if (!suggest) return;
        var q = (search.value || '').trim().toLowerCase();
        var matches;
        var label;
        if (!q) {
          // popular: first question from each distinct category
          var seen = {}; matches = [];
          index.forEach(function (e) { if (!seen[e.cat]) { seen[e.cat] = 1; matches.push(e); } });
          matches = matches.slice(0, 6);
          label = 'Popular questions';
        } else {
          // rank: question-title hits first, then answer hits
          var titleHits = index.filter(function (e) { return e.q.toLowerCase().indexOf(q) !== -1; });
          var bodyHits = index.filter(function (e) { return e.q.toLowerCase().indexOf(q) === -1 && e.hay.indexOf(q) !== -1; });
          matches = titleHits.concat(bodyHits).slice(0, 6);
          label = matches.length ? 'Suggested answers' : '';
        }
        var html = '';
        if (!matches.length) {
          html = '<div class="faqx-suggest__empty">No matching questions. Try another keyword, or scroll the full list below.</div>';
        } else {
          html += '<div class="faqx-suggest__label">' + label + '</div>';
          matches.forEach(function (e, i) {
            html += '<button type="button" class="faqx-suggest__item" role="option" data-idx="' + i + '">' +
                      '<span class="faqx-suggest__q">' + highlight(e.q, q) + '</span>' +
                      '<span class="faqx-suggest__cat">' + esc(e.cat) + '</span>' +
                    '</button>';
          });
        }
        suggest._matches = matches;
        suggest.innerHTML = html;
        suggest.hidden = false;
        activeIdx = -1;
        search.setAttribute('aria-expanded', 'true');
      }
      function moveActive(dir) {
        if (!suggest || suggest.hidden) return;
        var opts = [].slice.call(suggest.querySelectorAll('.faqx-suggest__item'));
        if (!opts.length) return;
        activeIdx = (activeIdx + dir + opts.length) % opts.length;
        opts.forEach(function (o, i) { o.classList.toggle('is-active', i === activeIdx); });
        opts[activeIdx].scrollIntoView({ block: 'nearest' });
      }
      function chooseActive() {
        if (!suggest || suggest.hidden || !suggest._matches) return false;
        var idx = activeIdx >= 0 ? activeIdx : 0;
        var entry = suggest._matches[idx];
        if (!entry) return false;
        openItem(entry);
        closeSuggest();
        return true;
      }

      // ---- events ----
      var t;
      function onInput() {
        apply();
        clearTimeout(t);
        t = setTimeout(renderSuggest, 90);
      }
      root.addEventListener('click', function (e) {
        var sitem = e.target.closest('.faqx-suggest__item');
        if (sitem) {
          var idx = parseInt(sitem.getAttribute('data-idx'), 10);
          var entry = suggest._matches && suggest._matches[idx];
          if (entry) { openItem(entry); closeSuggest(); }
          return;
        }
        var toggle = e.target.closest('[data-faq-toggle]');
        if (toggle) {
          var item = toggle.closest('[data-faq-item]');
          var wasOpen = item.classList.contains('is-open');
          items.forEach(function (it) { it.classList.remove('is-open'); });
          if (!wasOpen) item.classList.add('is-open');
          return;
        }
        var pill = e.target.closest('[data-faq-cat]');
        if (pill) {
          activeCat = pill.getAttribute('data-faq-cat');
          pills.forEach(function (p) { p.classList.toggle('is-active', p === pill); });
          apply();
        }
      });

      if (search) {
        search.addEventListener('input', onInput);
        search.addEventListener('focus', renderSuggest);
        search.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') { e.preventDefault(); moveActive(1); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); moveActive(-1); }
          else if (e.key === 'Enter') { if (chooseActive()) e.preventDefault(); }
          else if (e.key === 'Escape') { closeSuggest(); }
        });
        document.addEventListener('click', function (e) {
          if (!e.target.closest('.faqx-search')) closeSuggest();
        });
      }
    })();
  </script>
