{%- comment -%} Collection grid card: image, favorite, hover add-to-cart, sku, title, price {%- endcomment -%}
<div class="cardc prod-card">
  <div class="cardc__media">
    <a href="{{ product.url }}" class="cardc__img-link">
      {%- if product.featured_media != blank -%}
        <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="750" class="prod-img cover-img" loading="lazy">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'prod-img cover-img' }}
      {%- endif -%}
    </a>
    <button type="button" class="cardc__fav" data-wish-add data-product-handle="{{ product.handle }}" data-wish-title="{{ product.title | escape }}" data-wish-url="{{ product.url }}" data-wish-image="{% if product.featured_media %}{{ product.featured_media | image_url: width: 600 }}{% endif %}" data-wish-price="{% if product.price_varies %}From {{ product.price_min | money }}{% else %}{{ product.price | money }}{% endif %}" data-wish-sub="{{ product.type | default: product.vendor | escape }}" aria-label="Add to wishlist">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#16335E" stroke-width="1.6"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
    </button>
    {%- unless stacked_cta -%}
      {%- if product.variants.size == 1 and product.selected_or_first_available_variant.available -%}
        <form method="post" action="{{ routes.cart_add_url }}" class="cardc__add">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="cardc__add-btn">Add to Cart</button>
        </form>
      {%- else -%}
        <a href="{{ product.url }}" class="cardc__add cardc__add-btn">{% if product.available %}Choose Options{% else %}Sold Out{% endif %}</a>
      {%- endif -%}
    {%- endunless -%}
  </div>
  {%- if product.selected_or_first_available_variant.sku != blank -%}
    <div class="cardc__sku">{{ product.selected_or_first_available_variant.sku }}</div>
  {%- elsif stacked_cta -%}
    <div class="cardc__sku">&nbsp;</div>
  {%- endif -%}
  <a href="{{ product.url }}" class="prod-title cardc__title">{{ product.title }}</a>
  <div class="cardc__price">
    {%- if product.price > 0 -%}
      {%- if product.price_varies -%}From {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
    {%- else -%}
      Price on request
    {%- endif -%}
  </div>
  {%- if stacked_cta -%}
    {%- if product.variants.size == 1 and product.selected_or_first_available_variant.available -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="cardc__cta">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="cardc__add-btn">Add to Cart</button>
      </form>
    {%- else -%}
      <div class="cardc__cta"><a href="{{ product.url }}" class="cardc__add-btn">{% if product.available %}Choose Options{% else %}Sold Out{% endif %}</a></div>
    {%- endif -%}
  {%- endif -%}
</div>

<style>
  .cardc { position: relative; display: block; }
  .cardc__media { position: relative; overflow: hidden; aspect-ratio: 1 / 1; background: #fff; border: 1px solid rgba(22,51,94,.08); margin-bottom: 16px; }
  .cardc__img-link { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .cardc__media .prod-img, .cardc__media .cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 10px; }
  .cardc__fav { position: absolute; top: 13px; right: 13px; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,.94); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(22,51,94,.14); border: none; cursor: pointer; opacity: 0; transform: translateY(-4px); transition: all .3s ease; z-index: 2; }
  .cardc:hover .cardc__fav { opacity: 1; transform: translateY(0); }
  .cardc__fav.is-saved svg { fill: var(--color-blue); stroke: var(--color-blue); }
  .cardc__add { position: absolute; left: 0; right: 0; bottom: 0; transform: translateY(101%); transition: transform .38s ease; }
  .cardc:hover .cardc__add { transform: translateY(0); }
  .cardc__add-btn { display: block; width: 100%; background: var(--color-navy); color: #fff; text-align: center; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; padding: 15px; border: none; cursor: pointer; }
  .cardc__add-btn:hover { background: #224A82; }
  .cardc__sku { font-family: var(--font-accent); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 7px; }
  .cardc__title { display: block; font-family: var(--font-display); font-size: 21px; line-height: 1.2; color: var(--color-navy); margin-bottom: 9px; min-height: 50px; transition: color .3s ease; }
  .cardc:hover .cardc__title { color: var(--color-blue); }
  .cardc__price { font-size: 14px; color: var(--color-text-muted); letter-spacing: .02em; }
  .cardc__cta { display: block; margin-top: 14px; }
</style>
