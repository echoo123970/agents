            <div class="ig-stat"><div class="ig-stat__n">6 Steps</div><div class="ig-stat__l">Start to Finish</div></div>
            <div class="ig-stat"><div class="ig-stat__n">1–2 Days</div><div class="ig-stat__l">Incl. Curing</div></div>
          </div>
        </div>
        <div class="ig-hero__media"><img src="{{ 'install-hero-tree.png' | asset_url }}" alt="iMosaicArt team installing a tree mosaic mural" loading="eager"></div>
      </div>
