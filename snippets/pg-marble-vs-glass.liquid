    { "@type": "Question", "name": "Which is more durable, marble or glass mosaic?", "acceptedAnswer": { "@type": "Answer", "text": "Both are extremely durable and fully weatherproof. Glass is non-porous and completely waterproof, making it ideal for pools and wet areas, while marble is solid natural stone that should be sealed periodically in wet settings. Both marble and glass mosaics are slip-tested before shipping and backed by a lifetime warranty." } },
    { "@type": "Question", "name": "Is marble or glass better for a pool or bathroom?", "acceptedAnswer": { "@type": "Answer", "text": "Glass is usually the best choice for pools, fountains, showers, and bathrooms because it is non-porous, fully waterproof, and stays vivid underwater. Marble also works well in wet areas when sealed, and is often chosen for its natural, timeless look." } },
    { "@type": "Question", "name": "Which is better for a portrait or classical mosaic?", "acceptedAnswer": { "@type": "Answer", "text": "Marble is often preferred for portraits and classical art because its natural earth tones, veining, and depth suit realistic, timeless imagery. Glass is ideal for vivid, luminous, and modern or abstract designs where bright color and reflection matter." } },
    { "@type": "Question", "name": "Is glass or marble mosaic more expensive?", "acceptedAnswer": { "@type": "Answer", "text": "Both marble and glass are premium, made-to-order materials. The price of a mosaic depends mainly on its size, level of detail, and complexity rather than simply on marble versus glass. Share your project with us for an exact quote." } },
    { "@type": "Question", "name": "Can marble and glass be combined in one mosaic?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Many iMosaicArt pieces blend marble and glass in a single design — the depth and warmth of natural stone alongside the brilliance and color of hand-cut glass. Our designers can help you mix both materials." } },
    { "@type": "Question", "name": "Does marble mosaic need sealing while glass does not?", "acceptedAnswer": { "@type": "Answer", "text": "Correct. Because marble is porous, it should be sealed periodically with a penetrating stone sealer, especially in wet areas. Glass is non-porous and never needs sealing." } }
  ]
}
