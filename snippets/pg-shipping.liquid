              <div class="sp-req"><svg class="sp-req__ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#2B7BE8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span class="sp-req__t">Your home or street address</span></div>
