{%- comment -%}
  Two jobs, both rendered once from layout/theme.liquid:
    1. A noindex robots meta for utility pages that should never be indexed.
    2. BreadcrumbList structured data for page types that do not already emit one.

  Already covered elsewhere — do NOT duplicate:
    * products     -> templates/product.liquid
    * collections  -> sections/main-collection.liquid

  This snippet covers: content pages (/pages/*), blog articles, and the blog index.
  Render it once from layout/theme.liquid.
{%- endcomment -%}

{%- assign site = 'https://www.imosaicart.com' -%}

{%- comment -%}
  ------------------------------------------------------------------
  1. NOINDEX for utility pages.
  These render per-visitor content (or nothing) and have no search
  value, but they are crawlable and linked, so robots.txt alone will
  not keep them out of the index — a Disallow stops the crawl, not
  the listing. A noindex meta is what actually removes them.
  Add handles to the list below, pipe-separated, to extend it.
  ------------------------------------------------------------------
{%- endcomment -%}
{%- assign noindex_handles = 'wishlist|my-wishlist' -%}
{%- assign noindex_list = noindex_handles | split: '|' -%}
{%- if request.page_type == 'page' and page.handle != blank -%}
  {%- if noindex_list contains page.handle -%}
    <meta name="robots" content="noindex, follow">
  {%- endif -%}
{%- endif -%}
{%- if request.page_type == 'customers/account' or request.page_type == 'customers/login' or request.page_type == 'customers/register' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' or request.page_type == 'customers/reset_password' or request.page_type == 'customers/activate_account' or request.page_type == 'cart' or request.page_type == 'search' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

{%- comment -%}
  ------------------------------------------------------------------
  Near-duplicate product listings.

  A 2025-11-16 import generated 184 products across only 12 artwork
  subjects. They ARE distinct artworks -- each has its own SKU and its
  own image -- so they stay live, browsable and buyable. But their
  titles differ only by a decorative adjective and their descriptions
  are byte-identical, so 23 of them competing for one query means none
  of them ranks. One listing per subject stays in search -- 12 in all,
  each the first-created listing for its subject -- and the other 172
  carry the seo.noindex metafield and are excluded here.

  "follow" is deliberate: these pages still pass link equity on to the
  canonical listing and the rest of the catalogue. They are removed
  from search results, not cut off from the site.

  To put one back in the index, clear its seo.noindex metafield. No
  theme change is needed, and nothing here hardcodes a product.
  ------------------------------------------------------------------
{%- endcomment -%}
{%- if request.page_type == 'product' and product.metafields.seo.noindex.value == true -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

{%- comment -%}
  ------------------------------------------------------------------
  2. BREADCRUMBS
  ------------------------------------------------------------------
{%- endcomment -%}

{%- case request.page_type -%}

  {%- when 'page' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": "{{ site }}{{ page.url }}" }
      ]
    }
    </script>

  {%- when 'article' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": "{{ site }}{{ blog.url }}" },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": "{{ site }}{{ article.url }}" }
      ]
    }
    </script>

  {%- when 'blog' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": "{{ site }}{{ blog.url }}" }
      ]
    }
    </script>

{%- endcase -%}

{%- comment -%}
  CollectionPage wrapper for the blog index, so the article list is machine-readable
  as a list rather than a wall of links. Helps AI engines enumerate your content.
{%- endcomment -%}
{%- if request.page_type == 'blog' and blog.articles.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": "{{ canonical_url }}#collectionpage",
    "name": {{ blog.title | json }},
    "url": "{{ canonical_url }}",
    "isPartOf": { "@id": "{{ site }}/#website" },
    "publisher": { "@id": "{{ site }}/#organization" },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ blog.articles_count }},
      "itemListElement": [
        {%- for a in blog.articles limit: 25 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": "{{ site }}{{ a.url }}",
          "name": {{ a.title | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  }
  </script>
{%- endif -%}
