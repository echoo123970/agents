{%- assign stats = section.blocks | where: 'type', 'stat' -%}
{%- assign reviews = section.blocks | where: 'type', 'review' -%}

<section class="rv-hero">
  <div class="page-width rv-hero__crumb-wrap">
    <div class="rv-hero__crumb">
      <a href="{{ routes.root_url }}" class="rv-hero__crumb-link">Home</a>
      <span class="rv-hero__crumb-sep">/</span>
      <span class="rv-hero__crumb-current">Testimonials</span>
    </div>
  </div>
  <div class="rv-hero__inner">
    <div class="rv-hero__eyebrow"><span class="rv-hero__rule"></span><span class="rv-hero__eyebrow-text">{{ section.settings.eyebrow }}</span><span class="rv-hero__rule"></span></div>
    {%- if section.settings.heading != blank -%}<h1 class="rv-hero__title">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="rv-hero__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if stats.size > 0 -%}
      <div class="rv-hero__stats">
        {%- for block in stats -%}
          <div class="rv-hero__stat" {{ block.shopify_attributes }}>
            <div class="rv-hero__stat-big">{{ block.settings.value }}</div>
            <div class="rv-hero__stat-label">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<section class="rv page-width">
  <div class="rv__grid">
    {%- for block in reviews -%}
      <div class="rv__card" {{ block.shopify_attributes }}>
        <div class="rv__card-top">
          <span class="rv__stars">★★★★★</span>
          <span class="rv__verified">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1F8A5B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Verified
          </span>
        </div>
        <p class="rv__quote">“{{ block.settings.quote }}”</p>
        <div class="rv__author">
          {%- if block.settings.avatar != blank -%}
            <img src="{{ block.settings.avatar | image_url: width: 92 }}" alt="{{ block.settings.name | escape }}" width="46" height="46" class="rv__avatar">
          {%- else -%}
            <span class="rv__avatar rv__avatar--ph"></span>
          {%- endif -%}
          <div>
            <div class="rv__name">{{ block.settings.name }}</div>
            <div class="rv__place">{{ block.settings.place }}</div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{%- if section.settings.cta_heading != blank -%}
<section class="rv-cta">
  <div class="rv-cta__inner">
    <h2 class="rv-cta__heading">{{ section.settings.cta_heading }}</h2>
    {%- if section.settings.cta_text != blank -%}<p class="rv-cta__text">{{ section.settings.cta_text }}</p>{%- endif -%}
    <div class="rv-cta__btns">
      {%- if section.settings.cta_button_label_1 != blank -%}<a href="{{ section.settings.cta_button_link_1 }}" class="btn btn--dark">{{ section.settings.cta_button_label_1 }}</a>{%- endif -%}
      {%- if section.settings.cta_button_label_2 != blank -%}<a href="{{ section.settings.cta_button_link_2 }}" class="btn btn--outline">{{ section.settings.cta_button_label_2 }}</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

<style>
  .rv-hero { background: var(--color-navy); color: var(--color-light-text); }
  .rv-hero__crumb-wrap { padding-top: 30px; }
  .rv-hero__crumb { display: flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-faint); }
  .rv-hero__crumb-link { color: var(--color-text-faint); }
  .rv-hero__crumb-sep { color: #46546E; }
  .rv-hero__crumb-current { color: var(--color-light-text); }
  .rv-hero__inner { max-width: 900px; margin: 0 auto; padding: 54px 40px 60px; text-align: center; }
  .rv-hero__eyebrow { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 22px; }
  .rv-hero__rule { width: 38px; height: 1px; background: var(--color-blue); }
  .rv-hero__eyebrow-text { font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-blue-light); }
  .rv-hero__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(44px,5.4vw,74px); line-height: 1.02; letter-spacing: -.01em; margin-bottom: 22px; color: #fff; }
  .rv-hero__title em, .rv-hero__title i { font-style: italic; color: var(--color-blue-light); }
  .rv-hero__text { font-size: 17px; line-height: 1.7; color: var(--color-text-faint); max-width: 560px; margin: 0 auto 44px; }
  .rv-hero__stats { display: flex; align-items: stretch; justify-content: center; flex-wrap: wrap; }
  .rv-hero__stat { padding: 0 44px; border-left: 1px solid rgba(220,230,245,.18); }
  .rv-hero__stat:first-child { border-left: none; }
  .rv-hero__stat-big { font-family: var(--font-display); font-size: 46px; line-height: 1; color: #fff; margin-bottom: 8px; }
  .rv-hero__stat-label { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-text-faint); }

  .rv { padding-top: 80px; padding-bottom: 100px; }
  .rv__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .rv__card { background: #fff; border: 1px solid rgba(22,51,94,.08); padding: 34px 32px; display: flex; flex-direction: column; height: 100%; }
  .rv__card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .rv__stars { color: var(--color-blue); letter-spacing: 3px; font-size: 15px; }
  .rv__verified { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #1F8A5B; }
  .rv__quote { font-family: var(--font-display); font-size: 21px; line-height: 1.4; color: #2B2620; margin-bottom: 28px; flex: 1; }
  .rv__author { display: flex; align-items: center; gap: 14px; border-top: 1px solid rgba(22,51,94,.1); padding-top: 18px; }
  .rv__avatar { width: 46px; height: 46px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .rv__avatar--ph { background: var(--color-light-text); }
  .rv__name { font-size: 14.5px; font-weight: 600; color: var(--color-navy); }
  .rv__place { font-size: 12.5px; color: #8A93A6; }

  .rv-cta { background: var(--color-panel); border-top: 1px solid rgba(22,51,94,.08); }
  .rv-cta__inner { max-width: 760px; margin: 0 auto; padding: 84px 40px; text-align: center; }
  .rv-cta__heading { font-family: var(--font-display); font-weight: 500; font-size: clamp(30px,3.6vw,46px); line-height: 1.1; margin-bottom: 14px; color: var(--color-navy); }
  .rv-cta__text { font-size: 16px; line-height: 1.65; color: var(--color-text-muted); margin-bottom: 32px; }
  .rv-cta__btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 990px) { .rv__grid { grid-template-columns: 1fr; } .rv-hero__stat { padding: 0 26px; } }
</style>

{% schema %}
{
  "name": "Reviews page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Reviews" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Loved in Homes <em>Worldwide</em></p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thousands of collectors have welcomed a handcrafted iMosaicArt piece into their homes. Here is what they have to say." },
    { "type": "header", "content": "CTA band" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Join Thousands of Happy Collectors" },
    { "type": "textarea", "id": "cta_text", "label": "Text", "default": "Discover a handcrafted mosaic for your space — or commission one entirely your own." },
    { "type": "text", "id": "cta_button_label_1", "label": "Button 1", "default": "Shop All Mosaics" },
    { "type": "url", "id": "cta_button_link_1", "label": "Button 1 link" },
    { "type": "text", "id": "cta_button_label_2", "label": "Button 2", "default": "Start a Custom Mosaic Piece" },
    { "type": "url", "id": "cta_button_link_2", "label": "Button 2 link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "4.9" },
        { "type": "text", "id": "label", "label": "Label", "default": "Average Rating" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Absolutely love my mosaic! The details and craftsmanship are truly outstanding." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Name", "default": "Anita Miller" },
        { "type": "text", "id": "place", "label": "Place", "default": "United States" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews page",
      "blocks": [
        { "type": "stat", "settings": { "value": "4.9", "label": "Average Rating" } },
        { "type": "stat", "settings": { "value": "2,400+", "label": "Happy Collectors" } },
        { "type": "stat", "settings": { "value": "100%", "label": "Handcrafted" } },
        { "type": "review", "settings": { "quote": "Absolutely love my mosaic! The details and craftsmanship are truly outstanding.", "name": "Anita Miller", "place": "United States" } },
        { "type": "review", "settings": { "quote": "Stunning craftsmanship, quick delivery, and always gets compliments!", "name": "Travis Raynor", "place": "United States" } },
        { "type": "review", "settings": { "quote": "Beautiful mosaic design and excellent quality. It looks amazing in my home!", "name": "Luna P.", "place": "United States" } },
        { "type": "review", "settings": { "quote": "The attention to detail is incredible. I could not be happier with my purchase.", "name": "Alexander Ball", "place": "New York" } },
        { "type": "review", "settings": { "quote": "This is my third purchase, and I am always impressed by the quality and service.", "name": "Emily Parker", "place": "United States" } },
        { "type": "review", "settings": { "quote": "I am truly impressed. The craftsmanship and color bring the sacred scene to life!", "name": "James Mitchell", "place": "United States" } }
      ]
    }
  ]
}
{% endschema %}
