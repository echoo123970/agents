{%- assign blog_obj = blogs[section.settings.blog] -%}
<section id="journal" class="journal page-width">
  <div class="journal__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ blog_obj.url | default: section.settings.button_link }}" class="btn btn--ghost">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
  <div class="journal__grid">
    {%- for article in blog_obj.articles limit: 3 -%}
      <a href="{{ article.url }}" class="journal__card">
        <div class="journal__media">
          {%- if article.image != blank -%}
            <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" width="700" height="770" class="cover-img" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'cover-img' }}
          {%- endif -%}
        </div>
        <div class="journal__date">{{ article.published_at | date: '%b %d, %Y' }}</div>
        <h3 class="journal__title">{{ article.title }}</h3>
        <p class="journal__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
        <span class="journal__more">{{ 'blogs.article.read_more' | t }}</span>
      </a>
    {%- else -%}
      {%- for i in (1..3) -%}
        <div class="journal__card">
          <div class="journal__media">{{ 'image' | placeholder_svg_tag: 'cover-img' }}</div>
          <div class="journal__date">Coming soon</div>
          <h3 class="journal__title">Your latest article will appear here</h3>
          <p class="journal__excerpt">Publish posts to your blog and they will show automatically.</p>
          <span class="journal__more">{{ 'blogs.article.read_more' | t }}</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

<style>
  .journal { padding-top: 128px; padding-bottom: 128px; }
  .journal__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 46px; flex-wrap: wrap; }
  .journal__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .journal__card { display: block; transition: opacity .3s ease; }
  .journal__card:hover { opacity: .86; }
  .journal__media { overflow: hidden; aspect-ratio: 4/4.4; background: var(--color-light-text); margin-bottom: 18px; }
  .journal__date { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 10px; }
  .journal__title { font-family: var(--font-display); font-weight: 500; font-size: 24px; line-height: 1.2; margin-bottom: 10px; color: var(--color-navy); }
  .journal__excerpt { font-size: 14px; line-height: 1.6; color: var(--color-text-muted); margin-bottom: 16px; }
  .journal__more { display: inline-block; font-size: 11.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--color-navy); border-bottom: 1px solid var(--color-blue); padding-bottom: 4px; }
  @media (max-width: 990px) { .journal { padding-top: 80px; padding-bottom: 80px; } .journal__grid { grid-template-columns: 1fr; max-width: 480px; } }
</style>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories, Trends & Technique" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See All Articles" },
    { "type": "url", "id": "button_link", "label": "Button link (fallback)" }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
