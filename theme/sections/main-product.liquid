<section class="product page-width">
  <div class="product__grid">
    <div class="product__media">
      {%- if product.featured_media != blank -%}
        <img src="{{ product.featured_media | image_url: width: 1100 }}" alt="{{ product.title | escape }}" width="1100" height="1375" class="product__image">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product__image' }}
      {%- endif -%}
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media limit: 6 -%}
            <img src="{{ media | image_url: width: 200 }}" alt="" width="200" height="200" class="product__thumb" loading="lazy">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if product.type != blank -%}<div class="product__type">{{ product.type }}</div>{%- endif -%}
      <h1 class="product__title">{{ product.title }}</h1>
      <div class="product__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="product__price-sale">{{ product.price | money }}</span>
          <s class="product__price-was">{{ product.compare_at_price | money }}</s>
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </div>

      {%- form 'product', product, class: 'product__form' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product__option">
              <label class="product__option-label">{{ option.name }}</label>
              <select name="options[{{ option.name | escape }}]" class="product__select">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" class="btn btn--dark product__add" {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="product__description rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .product { padding-top: 64px; padding-bottom: 96px; }
  .product__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: start; }
  .product__image { width: 100%; aspect-ratio: 4/5; object-fit: cover; background: var(--color-light-text); }
  .product__thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 12px; }
  .product__thumb { aspect-ratio: 1/1; object-fit: cover; }
  .product__type { font-family: var(--font-accent); font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--color-text-faint); margin-bottom: 10px; }
  .product__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(34px, 4vw, 52px); line-height: 1.05; color: var(--color-navy); margin-bottom: 18px; }
  .product__price { font-size: 22px; color: var(--color-navy); margin-bottom: 32px; }
  .product__price-was { color: var(--color-text-soft); margin-left: 10px; }
  .product__option { margin-bottom: 18px; }
  .product__option-label { display: block; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 8px; }
  .product__select { width: 100%; padding: 14px 16px; border: 1px solid var(--color-line); background: #fff; font-family: var(--font-body); font-size: 15px; }
  .product__add { width: 100%; margin-top: 12px; margin-bottom: 32px; }
  .product__description { font-size: 16px; line-height: 1.75; color: var(--color-text-muted); }
  .product__description :is(h2,h3) { font-family: var(--font-display); color: var(--color-navy); }
  @media (max-width: 990px) { .product__grid { grid-template-columns: 1fr; gap: 32px; } }
</style>

{% schema %}
{ "name": "Product", "settings": [] }
{% endschema %}
