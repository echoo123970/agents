<section class="collection page-width">
  <div class="collection__head">
    <div class="eyebrow">Collection</div>
    <h1 class="section-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection__desc rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
  {%- paginate collection.products by 24 -%}
    <div class="collection__grid">
      {%- for product in collection.products -%}
        {% render 'card-product', product: product %}
      {%- else -%}
        <p>No products found.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="collection__pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--ghost">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--ghost">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

<style>
  .collection { padding-top: 64px; padding-bottom: 96px; }
  .collection__head { text-align: center; margin-bottom: 56px; }
  .collection__head .eyebrow { margin-bottom: 14px; }
  .collection__desc { font-size: 16px; line-height: 1.7; color: var(--color-text-muted); max-width: 600px; margin: 16px auto 0; }
  .collection__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px 22px; }
  .collection__pagination { display: flex; gap: 12px; justify-content: center; margin-top: 56px; }
  @media (max-width: 990px) { .collection__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
