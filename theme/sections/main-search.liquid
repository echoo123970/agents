<section class="search page-width">
  <div class="collection__head" style="text-align:center;margin-bottom:48px;">
    <div class="eyebrow" style="margin-bottom:14px;">{{ 'general.search.search' | t }}</div>
    <h1 class="section-title">{{ 'general.search.search' | t }}</h1>
  </div>
  <form action="{{ routes.search_url }}" method="get" class="search__form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" class="search__input">
    <button type="submit" class="btn btn--dark">{{ 'general.search.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    <p class="search__count">{{ 'general.search.results_with_count' | t: count: search.results_count }}</p>
    <div class="collection__grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px 22px;margin-top:32px;">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'card-product', product: item %}
        {%- else -%}
          <a href="{{ item.url }}" class="journal__card">
            <h3 class="journal__title">{{ item.title }}</h3>
          </a>
        {%- endif -%}
      {%- else -%}
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  .search { padding-top: 64px; padding-bottom: 96px; }
  .search__form { display: flex; gap: 12px; max-width: 600px; margin: 0 auto; }
  .search__input { flex: 1; padding: 16px 20px; border: 1px solid var(--color-line); background: #fff; font-family: var(--font-body); font-size: 15px; }
  .search__count { text-align: center; margin-top: 28px; color: var(--color-text-soft); }
  @media (max-width: 990px) { .collection__grid { grid-template-columns: repeat(2, 1fr) !important; } }
</style>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
