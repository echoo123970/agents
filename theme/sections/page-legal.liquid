<section class="lg-hero">
  <div class="page-width lg-hero__crumb-wrap">
    <div class="lg-hero__crumb">
      <a href="{{ routes.root_url }}" class="nav-link">Home</a>
      <span class="lg-hero__crumb-sep">/</span>
      <span class="lg-hero__crumb-current">{{ page.title }}</span>
    </div>
  </div>
  <div class="lg-hero__inner">
    <div class="lg-hero__eyebrow"><span class="lg-hero__rule"></span><span class="lg-hero__eyebrow-text">{{ section.settings.eyebrow }}</span><span class="lg-hero__rule"></span></div>
    <h1 class="lg-hero__title">{{ page.title }}</h1>
    {%- if section.settings.subtitle != blank -%}<p class="lg-hero__subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}
    {%- if section.settings.updated != blank -%}<div class="lg-hero__updated">Last updated: {{ section.settings.updated }}</div>{%- endif -%}
  </div>
</section>

<section class="lg page-width">
  <div class="lg__body rte">
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      <p>Add this page's content in <strong>Shopify admin → Online Store → Pages</strong>. It will appear here, beautifully styled.</p>
    {%- endif -%}
  </div>
  {%- if section.settings.show_help -%}
    <div class="lg__help">
      <span>Questions about this policy?</span>
      <a href="{{ section.settings.help_link | default: '/pages/contact-us' }}" class="lg__help-link">Contact our studio →</a>
    </div>
  {%- endif -%}
</section>

<style>
  .lg-hero { background: var(--color-panel); border-bottom: 1px solid rgba(22,51,94,.08); }
  .lg-hero__crumb-wrap { padding-top: 30px; }
  .lg-hero__crumb { display: flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-text-soft); }
  .lg-hero__crumb-sep { color: #B7C0D2; }
  .lg-hero__crumb-current { color: var(--color-navy); }
  .lg-hero__inner { max-width: 820px; margin: 0 auto; padding: 46px 40px 54px; text-align: center; }
  .lg-hero__eyebrow { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 20px; }
  .lg-hero__rule { width: 38px; height: 1px; background: var(--color-blue); }
  .lg-hero__eyebrow-text { font-family: var(--font-accent); font-size: 13px; letter-spacing: .36em; text-transform: uppercase; color: var(--color-navy); }
  .lg-hero__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(40px,5vw,64px); line-height: 1.04; letter-spacing: -.01em; color: var(--color-navy); }
  .lg-hero__subtitle { font-size: 16px; line-height: 1.7; color: var(--color-text-muted); max-width: 560px; margin: 16px auto 0; }
  .lg-hero__updated { margin-top: 18px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-text-faint); }

  .lg { padding-top: 64px; padding-bottom: 90px; max-width: 820px; }
  .lg__body { font-size: 16px; line-height: 1.85; color: var(--color-text-muted); }
  .lg__body h2 { font-family: var(--font-display); font-weight: 600; font-size: 28px; color: var(--color-navy); margin: 40px 0 14px; }
  .lg__body h3 { font-family: var(--font-display); font-weight: 600; font-size: 22px; color: var(--color-navy); margin: 30px 0 10px; }
  .lg__body h4 { font-family: var(--font-accent); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-navy); margin: 26px 0 10px; }
  .lg__body p { margin-bottom: 18px; }
  .lg__body ul, .lg__body ol { margin: 0 0 18px; padding-left: 24px; }
  .lg__body li { margin-bottom: 8px; }
  .lg__body a { color: var(--color-blue); text-decoration: underline; text-underline-offset: 3px; }
  .lg__body strong { color: var(--color-navy); }
  .lg__body hr { border: none; border-top: 1px solid var(--color-line); margin: 36px 0; }
  .lg__help { margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--color-line); display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 15px; color: var(--color-text-muted); }
  .lg__help-link { color: var(--color-blue); font-weight: 600; }
</style>

{% schema %}
{
  "name": "Legal page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to Know" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle (optional)" },
    { "type": "text", "id": "updated", "label": "Last updated (optional)" },
    { "type": "checkbox", "id": "show_help", "label": "Show contact footer", "default": true },
    { "type": "url", "id": "help_link", "label": "Contact link" }
  ]
}
{% endschema %}
