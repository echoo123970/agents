{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": { "type": "title", "settings": {} },
        "price": { "type": "price", "settings": {} },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": { "picker_type": "button" }
        },
        "quantity_selector": { "type": "quantity_selector", "settings": {} },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "product_specs": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"product-specs\" style=\"margin-top:1rem;border-top:1px solid rgba(0,0,0,.08);padding-top:1rem;\">{% if product.metafields.custom.material != blank %}<p><strong>Material:</strong> {{ product.metafields.custom.material }}</p>{% endif %}{% if product.metafields.custom.dimensions != blank %}<p><strong>Dimensions:</strong> {{ product.metafields.custom.dimensions }}</p>{% endif %}{% if product.metafields.custom.frame_type != blank %}<p><strong>Frame:</strong> {{ product.metafields.custom.frame_type }}</p>{% endif %}{% if product.metafields.custom.style != blank %}<p><strong>Style:</strong> {{ product.metafields.custom.style }}</p>{% endif %}{% if product.metafields.custom.artist != blank %}<p><strong>Artist:</strong> {{ product.metafields.custom.artist }}</p>{% endif %}</div>"
          }
        },
        "care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care instructions",
            "content": "",
            "page": "",
            "icon": "checkmark"
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "content": "<p>Carefully packaged and shipped with tracking. Easy returns within 30 days.</p>",
            "icon": "truck"
          }
        },
        "description": { "type": "description", "settings": {} },
        "complementary": {
          "type": "complementary",
          "settings": {
            "product_list_limit": 4,
            "products_per_page": 4,
            "pagination_style": "dots",
            "heading": "Pairs well with"
          }
        },
        "share": {
          "type": "share",
          "settings": { "share_label": "Share this piece" }
        }
      },
      "block_order": [
        "title",
        "price",
        "rating",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "product_specs",
        "care",
        "shipping",
        "description",
        "complementary",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail",
        "media_position": "left",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "recommendations": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "show_secondary_image": true,
        "enable_quick_add": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": ["main", "recommendations"]
}
